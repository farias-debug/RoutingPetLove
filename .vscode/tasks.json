{
  "version": "2.0.0",
  "tasks": [
    // ════════════════════════════════════════════════════════
    //  PIPELINE DIÁRIO
    // ════════════════════════════════════════════════════════
    {
      "label": "📊 Pipeline: Atualização Diária Completa",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/daily_pipeline.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Pipeline: Deploy SQL v7",
      "type": "shell",
      "command": "${workspaceFolder}/Dashboard/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/Dashboard/bigquery/deploy_v7_dashboard.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Dashboard"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    // ════════════════════════════════════════════════════════
    //  EXTRAÇÃO TMS
    // ════════════════════════════════════════════════════════
    {
      "label": "🧹 TMS: Extrair Relatório (Cloud Run Job)",
      "type": "shell",
      "command": "gcloud",
      "args": [
        "run",
        "jobs",
        "execute",
        "pipeline-tms-bq",
        "--project=data-aileron-482822-d0",
        "--region=us-central1",
        "--wait"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Dashboard"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    // ════════════════════════════════════════════════════════
    //  GIT / GITHUB
    // ════════════════════════════════════════════════════════
    {
      "label": "🔄 Git: Commit + Push Diário",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/git_daily_sync.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 Git: Status Rápido",
      "type": "shell",
      "command": "git",
      "args": [
        "status",
        "--short"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "📋 GitHub: Ver Issues Abertas",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "list",
        "--state",
        "open",
        "--limit",
        "20"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "📋 GitHub: Criar Issue de Melhoria",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "create",
        "--title",
        "${input:issueTitle}",
        "--body",
        "${input:issueBody}",
        "--label",
        "enhancement"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    // ════════════════════════════════════════════════════════
    //  DIAGNÓSTICO
    // ════════════════════════════════════════════════════════
    {
      "label": "🔍 Diagnóstico: Health Check Completo",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/health_check.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Dashboard: Validar Contrato Canônico",
      "type": "shell",
      "command": "${workspaceFolder}/Dashboard/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/Dashboard/bigquery/validate_data_contract.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Dashboard"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Dashboard: Smoke API Publicada",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/smoke_dashboard_api.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    // ════════════════════════════════════════════════════════
    //  CODEX CLI
    // ════════════════════════════════════════════════════════
    {
      "label": "🤖 Codex: Interativo (Petlove profile)",
      "type": "shell",
      "command": "codex",
      "args": [
        "-p",
        "petlove",
        "-C",
        "${workspaceFolder}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 Codex: Full-Auto com Prompt",
      "type": "shell",
      "command": "codex",
      "args": [
        "--full-auto",
        "-p",
        "petlove",
        "-C",
        "${workspaceFolder}",
        "${input:codexPrompt}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 Codex: Code Review",
      "type": "shell",
      "command": "codex",
      "args": [
        "review",
        "-p",
        "review",
        "-C",
        "${workspaceFolder}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 Codex: Exec Rápido",
      "type": "shell",
      "command": "codex",
      "args": [
        "exec",
        "-p",
        "quick",
        "-C",
        "${workspaceFolder}",
        "${input:codexPrompt}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "issueTitle",
      "type": "promptString",
      "description": "Título da issue"
    },
    {
      "id": "issueBody",
      "type": "promptString",
      "description": "Descrição da issue"
    },
    {
      "id": "codexPrompt",
      "type": "promptString",
      "description": "Prompt para o Codex CLI"
    }
  ]
}
