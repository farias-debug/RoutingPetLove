{
  "name": "dashboard-monitoramento-logistico",
  "version": "2.0.0",
  "private": true,
  "description": "Dashboard Logístico Petlove — TMS → BigQuery → API → React.",
  "scripts": {
    "frontend:dev": "npm --prefix ./frontend run dev -- --host",
    "frontend:build": "npm --prefix ./frontend run build",
    "pipeline:extract": "node ./extraction/extrair_relatorio_tms.mjs",
    "pipeline:consolidar": "python ./extraction/consolidar_monitoramento.py",
    "pipeline:bq-load": "python ./bigquery/load_raw_to_bq.py --table all"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "vite": "^8.0.2"
  }
}
