{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petlove.local/schemas/resumo_executivo_diario.schema.json",
  "title": "ResumoExecutivoDiario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOfDate",
    "title",
    "subtitle",
    "northStarKpis",
    "routeSnapshot",
    "riskChips",
    "sprLeaderboard",
    "focusOfDay",
    "cta",
    "email"
  ],
  "properties": {
    "asOfDate": {
      "type": "string",
      "description": "Data base do fechamento executivo diario no formato YYYY-MM-DD."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "northStarKpis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/kpiCard"
      }
    },
    "routeSnapshot": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/kpiCard"
      }
    },
    "riskChips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/riskChip"
      }
    },
    "sprLeaderboard": {
      "$ref": "#/$defs/sprLeaderboard"
    },
    "focusOfDay": {
      "$ref": "#/$defs/focusBlock"
    },
    "cta": {
      "$ref": "#/$defs/cta"
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "preheader",
        "intro",
        "comparisonLabel"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "preheader": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "comparisonLabel": {
          "type": "string",
          "minLength": 1
        },
        "footerNote": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "kpiCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "deltaText": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "warning",
            "danger",
            "neutral"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "riskChip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "tone",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "enum": [
            "warning",
            "danger",
            "neutral"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sprLeaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "best",
        "worst"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "best": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/leaderboardItem"
          }
        },
        "worst": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/leaderboardItem"
          }
        }
      }
    },
    "leaderboardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "filial",
        "value",
        "detail",
        "supportingText",
        "tone",
        "source"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "filial": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "supportingText": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "enum": [
            "success",
            "danger",
            "neutral"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "focusBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "entity",
        "reason",
        "action"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
