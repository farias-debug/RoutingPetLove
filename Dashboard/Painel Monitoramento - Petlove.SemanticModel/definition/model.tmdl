model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_filial","fato_rotas","fato_planejado","dim_tipo_veiculo"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode","TMDL-Extension"]

ref table dim_filial
ref table fato_rotas
ref table dim_calendario
ref table fato_planejado
ref table _Medidas
ref table _Metas
ref table dim_tipo_veiculo

ref cultureInfo pt-BR

