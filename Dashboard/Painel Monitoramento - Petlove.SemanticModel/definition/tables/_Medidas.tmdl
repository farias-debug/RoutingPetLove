	measure 'SVG Card Capacidade' =
			VAR _valor = FORMAT([Ocupacao Composta (%)], "0.0%")
			VAR _status = UPPER(COALESCE([Status Capacidade Texto], "SEM DADOS"))
			VAR _acao = COALESCE([Acao Capacidade], "Validar cadastro de capacidade e filtros")
			VAR _acaoCurta = IF(LEN(_acao) > 40, LEFT(_acao, 40) & "...", _acao)
			VAR _acaoSafe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_acaoCurta, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _cor = COALESCE([Status Capacidade Cor], "#6A7282")
			VAR _ratio = MIN(MAX([Ocupacao Composta (%)], 0), 1)
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#FFFDF8' stroke='#E7DDD0'/>"
