		formatString: +0.0 pp;-0.0 pp;0.0 pp
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 87d284a4-a42e-4f6a-804e-47dca267a6e3

	/// Valor calculado do taxa de conclusao de rotas para exibicao em card
	measure 'KPI Rotas Valor' = [% Rotas Concluidas]
		formatString: 0.0%
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: 48c779b4-0dbc-4524-a551-1d0540a89197

	/// Meta de referencia para taxa de conclusao de rotas (global)
	measure 'KPI Rotas Meta' = [Meta Global % Rotas Concluidas]
		formatString: 0.0%
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: c823d024-e7b8-4f9b-b23f-1518720d3e35

	/// Diferenca em pontos percentuais do taxa de conclusao de rotas
	measure 'KPI Rotas Delta (pp)' = [KPI Rotas Valor] - [KPI Rotas Meta]
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: de19052d-0f1c-499f-b353-a616da246c72

	/// Diferenca percentual entre valor e meta do taxa de conclusao de rotas
	measure 'KPI Rotas Delta%' = DIVIDE([KPI Rotas Valor] - [KPI Rotas Meta], [KPI Rotas Meta], 0)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: 2f49f3fc-d160-4481-82b6-713fa9042e0e

	/// Status semaforo do taxa de conclusao de rotas (ok/atencao/critico)
	measure 'KPI Rotas Status' =
			VAR _delta = [KPI Rotas Delta (pp)]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_delta), "sem-dados",
					_delta >= 0, "ok",
					_delta >= -0.05, "atencao",
					"critico"
				)
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: f40eb08d-0c65-4e48-8b9d-b825120cc3b1

	/// Cor condicional hex do taxa de conclusao de rotas para formatacao visual
	measure 'KPI Rotas Cor' =
			SWITCH(
				[KPI Rotas Status],
				"ok", "#4CAF50",
				"atencao", "#F5A623",
				"critico", "#E74C3C",
				"#6A7282"
			)
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: 742db58d-e088-48e2-8996-72d1cc6737ad

	/// Icone Unicode indicador de status do taxa de conclusao de rotas
	measure 'KPI Rotas Icone' =
			SWITCH(
				[KPI Rotas Status],
				"ok", "^",
				"atencao", "~",
				"critico", "v",
				"-"
			)
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
		lineageTag: 72898fd4-59f3-450e-b5ad-ef7badc15130

	/// Texto formatado para card visual do taxa de conclusao de rotas
	measure 'KPI Rotas Texto Card' =
			VAR _val = FORMAT([KPI Rotas Valor], "0.0%")
			VAR _icon = [KPI Rotas Icone]
			VAR _delta = FORMAT([KPI Rotas Delta (pp)], "+0.0%;-0.0%;0.0%")
			RETURN _val & " " & _icon & " " & _delta & " vs meta"
		isHidden
		displayFolder: 01. Operacao\07. KPI Rotas Concluidas
