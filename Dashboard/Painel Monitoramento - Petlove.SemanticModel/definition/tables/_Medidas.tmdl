	/// Meta global para aderencia de volumes planejados vs realizados (via LOOKUPVALUE na tabela _Metas)
	measure 'Meta Global Aderencia Volumes' = LOOKUPVALUE(_Metas[Meta], _Metas[KPI], "Aderencia Volumes")
		formatString: 0.0%
		isHidden
		displayFolder: 06. Shared\02. Metas\06. Aderencia
		lineageTag: 2d322fff-09ed-4ac0-a8ce-3cbdce143ca7

	/// Variacao dia a dia em aderencia de volumes planejados vs realizados (pp). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 Aderencia Volumes (%)' =
