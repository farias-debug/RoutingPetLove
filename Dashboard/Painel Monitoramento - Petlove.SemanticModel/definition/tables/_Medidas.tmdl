		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: 956a1dd4-03fc-4cda-a01a-9aa460a77fa2

	/// SPR pedidos planejado (fonte fato_planejado, filiais Unidade)
	measure 'SPR Ped Planejado' = 
			VAR _ped =
			CALCULATE(
				SUM(fato_planejado[Pedidos Planejados]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			VAR _rotas =
			CALCULATE(
				COUNTROWS(fato_planejado),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			RETURN
				DIVIDE(
					_ped,
					_rotas,
					0
				)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: 280ee9ca-7529-4a5e-88ba-4292d983f889

	/// SPR volumes planejado (fonte fato_planejado, filiais Unidade)
	measure 'SPR Vol Planejado' = 
			VAR _vol =
			CALCULATE(
				SUM(fato_planejado[Volumes Planejados]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			VAR _rotas =
			CALCULATE(
				COUNTROWS(fato_planejado),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			RETURN
				DIVIDE(
					_vol,
					_rotas,
					0
				)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: 44d16706-fcbc-4b65-a651-c3f40cb90e02

	/// SPR peso planejado (fonte fato_planejado, filiais Unidade)
	measure 'SPR Peso Planejado (kg/rota)' = 
			VAR _peso =
			CALCULATE(
				SUM(fato_planejado[Peso Planejado (kg)]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			VAR _rotas =
			CALCULATE(
				COUNTROWS(fato_planejado),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
			RETURN
				DIVIDE(
					_peso,
					_rotas,
					0
				)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: f26c4433-8fd1-4558-885d-b8d9178dfe9f

	/// SPR KM planejado (fonte fato_planejado, filiais Unidade)
	measure 'SPR KM Planejado (km/rota)' = 
			VAR _km =
			CALCULATE(
