		lineageTag: 37f682e3-6b27-41f9-8f94-50f5471f751b

	/// Media movel 7 dias do % entregas efetivas. Usa flag IsUltimos7Dias.
	measure 'MA7 % Entregas Efetivas' =
			AVERAGEX(
			    FILTER(dim_calendario, dim_calendario[IsUltimos7Dias] = TRUE),
			    [% Entregas Efetivas]
			)
		formatString: 0.0%
