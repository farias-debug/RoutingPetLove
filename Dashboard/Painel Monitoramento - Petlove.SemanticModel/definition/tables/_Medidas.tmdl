	measure 'Alerta Operacional' =
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _critSPR = [Qtd Filiais Criticas SPR]
			VAR _overtime = [% Rotas Overtime (>8h)]
			VAR _capStatus = [Status Capacidade]
			VAR _acaoSPR = [KPI SPR Ped Acao]
			VAR _acaoORH = [KPI ORH Acao]
			VAR _acaoCap = [Acao Capacidade]
			RETURN
			    SWITCH(
			        TRUE(),
			        _naoPlan > 0,
			            FORMAT(_naoPlan, "#") & " rotas nao planejadas. Corrigir reconciliacao do plano",
			        _semTempo > 0,
			            FORMAT(_semTempo, "#") & " rotas sem tempo realizado. Corrigir apontamento no TMS",
			        _critSPR > 0,
			            FORMAT(_critSPR, "#") & " filiais com SPR critico. " & _acaoSPR,
			        _overtime > 0.20,
			            FORMAT(_overtime, "0%") & " das rotas em overtime (>8h). " & _acaoORH,
			        _capStatus = 4,
			            "Capacidade sobrecarregada no contexto atual. " & _acaoCap,
			        _capStatus = 1,
			            "Capacidade ociosa no contexto atual. Revisar distribuicao e consolidacao",
			        "Operacao dentro dos parametros"
			    )
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 3898a2cc-853d-4e50-b283-2cceae2d6930

	measure 'Alerta Nivel' =
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _critSPR = [Qtd Filiais Criticas SPR]
			VAR _overtime = [% Rotas Overtime (>8h)]
			VAR _capStatus = [Status Capacidade]
			RETURN
			    SWITCH(
			        TRUE(),
			        _naoPlan > 0 || _semTempo > 0 || _critSPR > 2 || _overtime > 0.25 || _capStatus = 4, "critico",
			        _critSPR > 0 || _overtime > 0.20 || _capStatus IN { 1, 4 }, "atencao",
			        "ok"
			    )
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: a7a2685a-6893-45b2-b7dd-8c3bde228bd8

	measure 'Alerta Cor' = SWITCH([Alerta Nivel], "ok", "#4CAF50", "atencao", "#F5A623", "critico", "#E74C3C", "#6A7282")
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 85157943-f2af-4998-8102-3851a0386651

	measure 'Top 3 Piores Filiais SPR' =
			VAR _tab =
			    TOPN(
			        3,
			        ADDCOLUMNS(
			            FILTER(VALUES(dim_filial[Filial]), CALCULATE([Total Rotas Unidade]) > 0),
			            "@SPR", CALCULATE([SPR Ped Realizado])
			        ),
			        [@SPR], ASC
			    )
			RETURN
			    CONCATENATEX(
			        _tab,
			        dim_filial[Filial] & ": " & FORMAT([@SPR], "0.0"),
			        " | ",
			        [@SPR], ASC
			    )
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 637c8baf-7870-430a-876b-9d35c1a972a2

