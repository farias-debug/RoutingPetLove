	/// Nome da filial com pior SPR na semana
	measure 'Pior Filial SPR Semana' = 
			VAR _tab =
			ADDCOLUMNS(
				FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([Total Rotas Unidade]) > 0
				),
				"@SPR", CALCULATE(
					[SPR Ped Realizado],
					dim_calendario[IsSemanaAtual] = TRUE
				)
			)
			VAR _min = MINX(
				_tab,
				[@SPR]
			)
			RETURN
				MAXX(
					FILTER(
						_tab,
						[@SPR] = _min
					),
					dim_filial[Filial]
				)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: d86ae3ba-040f-4cdf-b5f2-cceca771abc4

	/// Valor SPR da pior filial na semana
	measure 'Valor Pior Filial SPR Semana' = 
			VAR _tab =
			ADDCOLUMNS(
				FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([Total Rotas Unidade]) > 0
				),
				"@SPR", CALCULATE(
					[SPR Ped Realizado],
					dim_calendario[IsSemanaAtual] = TRUE
				)
			)
			RETURN
				MINX(
					_tab,
					[@SPR]
				)
		formatString: 0.0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 4e2c0f3c-dbdc-447e-b4a8-724a3a5e405b

	/// Gap percentual da pior filial SPR em relacao a meta
	measure 'Gap% Pior Filial SPR vs Meta' = 
			DIVIDE(
				[Valor Pior Filial SPR Semana] - [Meta Global SPR Ped],
				[Meta Global SPR Ped],
				0
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 9f63e5ac-17c9-44b3-9f7e-0f0328e47642

	/// Nome da filial com pior taxa de entregas na semana
	measure 'Pior Filial Entregas Semana' = 
			VAR _tab =
			ADDCOLUMNS(
				FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([Total Rotas]) > 0
				),
				"@Ent", CALCULATE(
					[% Entregas Efetivas],
					dim_calendario[IsSemanaAtual] = TRUE
				)
			)
			VAR _min = MINX(
				_tab,
				[@Ent]
			)
			RETURN
				MAXX(
					FILTER(
						_tab,
						[@Ent] = _min
					),
					dim_filial[Filial]
				)
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: 36f5314c-d7cf-456c-b064-5b67f09038c5

	/// Valor da taxa de entregas da pior filial na semana
	measure 'Valor Pior Filial Entregas Semana' = 
			VAR _tab =
			ADDCOLUMNS(
				FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([Total Rotas]) > 0
				),
				"@Ent", CALCULATE(
					[% Entregas Efetivas],
					dim_calendario[IsSemanaAtual] = TRUE
				)
			)
			RETURN
				MINX(
					_tab,
					[@Ent]
				)
		formatString: 0.0%
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: e69558ee-79e3-4fb2-ad14-d293f628664e

	/// Gap percentual da pior filial em entregas vs meta
	measure 'Gap% Pior Filial Entregas vs Meta' = 
			DIVIDE(
				[Valor Pior Filial Entregas Semana] - [Meta Global % Entregas],
				[Meta Global % Entregas],
				0
			)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: ac6db92d-0f57-4670-834a-daac77f4e9c5

	/// Nome da filial com pior ORH na semana
	measure 'Pior Filial ORH Semana' = 
			VAR _tab =
			ADDCOLUMNS(
				FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([Total Rotas]) > 0
				),
				"@ORH", CALCULATE(
					[Utilizacao Jornada 8h (%)],
					dim_calendario[IsSemanaAtual] = TRUE
				)
			)
			VAR _min = MINX(
				_tab,
				[@ORH]
			)
			RETURN
				MAXX(
					FILTER(
						_tab,
						[@ORH] = _min
					),
					dim_filial[Filial]
				)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 6613ba3c-c8ea-45e5-8193-6c6fb63458cc

	/// Quantidade de filiais abaixo da meta SPR
	measure 'Qtd Filiais Abaixo Meta SPR' = 
			VAR _meta = [Meta Global SPR Ped]
			RETURN
				COUNTROWS(FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([SPR Ped Realizado]) < _meta
					&& CALCULATE([SPR Ped Realizado]) > 0
				)
				)
		formatString: #,##0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 38df9be0-2686-47ee-9fb4-cca480c8f018

	/// Quantidade de filiais em faixa critica de SPR
	measure 'Qtd Filiais Criticas SPR' = 
			VAR _meta = [Meta Global SPR Ped]
			RETURN
				COUNTROWS(FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([SPR Ped Realizado]) < _meta * 0.70
					&& CALCULATE([SPR Ped Realizado]) > 0
				)
				)
		formatString: #,##0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 1b1c370a-e43a-489f-a31e-ed5e12c21edb

	/// Quantidade de filiais abaixo da meta de entregas
	measure 'Qtd Filiais Abaixo Meta Entrega' = 
			VAR _meta = [Meta Global % Entregas]
			RETURN
				COUNTROWS(FILTER(
					VALUES(dim_filial[Filial]),
					CALCULATE([% Entregas Efetivas]) < _meta
					&& CALCULATE([% Entregas Efetivas]) > 0
				)
				)
		formatString: #,##0
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: 6ece0d55-c7e4-429f-9470-96bb89f81273

	/// Texto do alerta operacional ativo na janela
	measure 'Alerta Operacional' = 
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _critSPR = [Qtd Filiais Criticas SPR]
			VAR _overtime = [% Rotas Overtime (>8h)]
			VAR _capStatus = [Status Capacidade]
			VAR _acaoSPR = [KPI SPR Ped Acao]
			VAR _acaoORH = [KPI ORH Acao]
			VAR _acaoCap = [Acao Capacidade]
			RETURN
				SWITCH(
					TRUE(),
					_naoPlan > 0, FORMAT(
						_naoPlan,
						"#"
					) & " rotas nao planejadas. Corrigir reconciliacao do plano",
					_semTempo > 0, FORMAT(
						_semTempo,
						"#"
					) & " rotas sem tempo realizado. Corrigir apontamento no TMS",
					_critSPR > 0, FORMAT(
						_critSPR,
						"#"
					) & " filiais com SPR critico. " & _acaoSPR,
					_overtime > 0.20, FORMAT(
						_overtime,
						"0%"
					) & " das rotas em overtime (>8h). " & _acaoORH,
					_capStatus = 4, "Capacidade sobrecarregada no contexto atual. " & _acaoCap,
					_capStatus = 1, "Capacidade ociosa no contexto atual. Revisar distribuicao e consolidacao",
					"Operacao dentro dos parametros"
				)
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 3898a2cc-853d-4e50-b283-2cceae2d6930

	/// Nivel do alerta operacional (ok/atencao/critico)
	measure 'Alerta Nivel' = 
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _critSPR = [Qtd Filiais Criticas SPR]
			VAR _overtime = [% Rotas Overtime (>8h)]
			VAR _capStatus = [Status Capacidade]
			RETURN
				SWITCH(
					TRUE(),
					_naoPlan > 0 || _semTempo > 0 || _critSPR > 2 || _overtime > 0.25 || _capStatus = 4, "critico",
					_critSPR > 0 || _overtime > 0.20 || _capStatus IN {
						1,
						4
					}, "atencao",
					"ok"
				)
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: a7a2685a-6893-45b2-b7dd-8c3bde228bd8

	/// Cor hex do nivel de alerta operacional
	measure 'Alerta Cor' = 
			SWITCH(
				[Alerta Nivel],
				"ok", "#4CAF50",
				"atencao", "#F5A623",
				"critico", "#E74C3C",
				"#6A7282"
			)
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 85157943-f2af-4998-8102-3851a0386651

	/// Lista das 3 piores filiais em SPR
	measure 'Top 3 Piores Filiais SPR' = 
			VAR _tab =
			TOPN(
				3,
				ADDCOLUMNS(
					FILTER(
						VALUES(dim_filial[Filial]),
						CALCULATE([Total Rotas Unidade]) > 0
					),
					"@SPR", CALCULATE([SPR Ped Realizado])
				),
				[@SPR],
				ASC
			)
			RETURN
				CONCATENATEX(
					_tab,
					dim_filial[Filial] & ": " & FORMAT(
						[@SPR],
						"0.0"
					),
					" | ",
					[@SPR],
					ASC
				)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 637c8baf-7870-430a-876b-9d35c1a972a2

	/// Lista das 3 piores filiais em taxa de entregas
	measure 'Top 3 Piores Filiais Entregas' = 
			VAR _tab =
			TOPN(
				3,
				ADDCOLUMNS(
					FILTER(
						VALUES(dim_filial[Filial]),
						CALCULATE([Total Rotas]) > 0
					),
					"@Ent", CALCULATE([% Entregas Efetivas])
				),
				[@Ent],
				ASC
			)
			RETURN
				CONCATENATEX(
					_tab,
					dim_filial[Filial] & ": " & FORMAT(
						[@Ent],
						"0.0%"
					),
					" | ",
					[@Ent],
					ASC
				)
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: b015492e-36e7-4d94-8c19-8a40de7bbe11

	/// Score SPR normalizado 0-100 baseado em SPR Real vs Meta
	measure 'Score SPR (0-100)' = 
			VAR _val = [SPR Ped Realizado]
			VAR _meta = [Meta Global SPR Ped]
			VAR _raw = DIVIDE(
				_val,
				_meta,
				0
			) * 100
			RETURN
				IF(
					ISBLANK(_val),
					BLANK(),
					MIN(
						INT(_raw),
						100
					)
				)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 8f4f4518-394d-401c-9704-7d8908f972de

	/// Score Entregas normalizado 0-100 baseado em % Entregas vs Meta
	measure 'Score Entrega (0-100)' = 
			VAR _val = [% Entregas Efetivas]
			VAR _meta = [Meta Global % Entregas]
			VAR _raw = DIVIDE(
				_val,
				_meta,
				0
			) * 100
			RETURN
				IF(
					ISBLANK(_val),
					BLANK(),
					MIN(
						INT(_raw),
						100
					)
				)
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: 112964bc-c703-4c5e-ad41-e777f6d0592f

	/// Score Operacional ponderado: SPR 45% + ORH 30% + Capacidade 25%
	measure 'Score Operacional' = 
			VAR _scoreSPR = [Score SPR (0-100)]
			VAR _orh = [Utilizacao Jornada 8h (%)]
			VAR _scoreORH = IF(
				ISBLANK(_orh),
				BLANK(),
				IF(
					_orh >= 0.8 && _orh <= 1.1,
					100,
					IF(
						_orh >= 0.6 && _orh <= 1.3,
						70,
						30
					)
				)
			)
			VAR _capStatus = [Status Capacidade]
			VAR _scoreCap = SWITCH(
				TRUE(),
				ISBLANK(_capStatus), BLANK(),
				_capStatus = 3, 100,
				_capStatus = 2, 90,
				_capStatus = 1, 60,
				_capStatus = 4, 30,
				BLANK()
			)
			RETURN
				IF(
					ISBLANK(_scoreSPR) || ISBLANK(_scoreCap),
					BLANK(),
					ROUND(
						_scoreSPR * 0.45 + _scoreORH * 0.30 + _scoreCap * 0.25,
						0
					)
				)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 8ac7640c-03ce-45d6-902d-81f3b4a219b7

	/// KM total planejado (soma da coluna KM em fato_planejado)
	measure 'KM Total Planejado' = SUM(fato_planejado[KM Planejado Plan])
		formatString: #,##0.0
		displayFolder: 05. Plano vs Real\04. Contexto de Execucao
		lineageTag: 4a80b51a-e8e0-4f82-a52c-eefd0085a985

	/// Status numerico SPR: 1=acima meta, 0=atencao (ate -10%), -1=critico. Para formatacao condicional em tabelas.
	measure 'Op Status SPR' = [KPI SPR Ped Status Codigo]
		formatString: 0
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: c8b0bb35-6b6b-4e56-853a-8b605086f7ef

	/// Status numerico Entregas: 1=acima meta, 0=atencao (ate -3pp), -1=critico. Para formatacao condicional.
	measure 'Op Status Entregas' = [KPI Entregas Status Codigo]
		formatString: 0
