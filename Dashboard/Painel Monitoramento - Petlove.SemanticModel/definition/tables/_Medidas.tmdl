	/// Variacao dia a dia no SPR Ped Realizado (pontos). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 SPR Pedidos' = 
			VAR _atual = CALCULATE(
				[SPR Ped Realizado],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[SPR Ped Realizado],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 0a9bbb05-98d6-46ae-aa6b-c166c35002b8

	/// Variacao dia a dia no tempo medio realizado (h). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 ORH Tempo' = 
			VAR _atual = CALCULATE(
