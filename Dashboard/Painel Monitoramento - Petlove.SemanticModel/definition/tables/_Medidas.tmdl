		lineageTag: 10c52f8d-0ac8-4ca1-b919-fdfd3f5e4208

	measure 'Ocupacao Filial Volumes (%)' = DIVIDE([Op Media Diaria Volumes], [Capacidade Volumes Dia Total], BLANK())
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 8dbb4fe1-604b-4d1b-b2b3-6f5db97e7309

	measure 'Ocupacao Filial Pedidos (%)' = DIVIDE([Op Media Diaria Pedidos], [Capacidade Pedidos Dia Total], BLANK())
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 0e90f3b2-f2f3-4e57-a8ef-f1531c466d0a

	measure 'Ocupacao Filial Peso (%)' = DIVIDE([Op Media Diaria Peso (kg)], [Capacidade Peso Dia Total (kg)], BLANK())
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 209af81e-cab9-4461-b3dd-63260847fc0b

	measure 'Ocupacao Filial Veiculos (%)' = DIVIDE([Op Media Diaria Rotas], [Capacidade Veiculos Dia Total], BLANK())
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 6a82c3d7-c6d6-4472-88cb-48531c12720c

	measure 'Ocupacao Filial Composta (%)' =
			VAR _veic = [Ocupacao Filial Veiculos (%)]
			VAR _ped = [Ocupacao Filial Pedidos (%)]
			VAR _vol = [Ocupacao Filial Volumes (%)]
			VAR _peso = [Ocupacao Filial Peso (%)]
			VAR _qtd =
			    IF(NOT ISBLANK(_veic), 1, 0)
			        + IF(NOT ISBLANK(_ped), 1, 0)
			        + IF(NOT ISBLANK(_vol), 1, 0)
			        + IF(NOT ISBLANK(_peso), 1, 0)
			RETURN
			    IF(
			        _qtd = 0,
			        BLANK(),
			        DIVIDE(COALESCE(_veic, 0) + COALESCE(_ped, 0) + COALESCE(_vol, 0) + COALESCE(_peso, 0), _qtd, 0)
			    )
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 7f34b013-a0ad-4cd6-bbf5-5b66d3cf970d

	measure 'Status Capacidade Filial' =
			VAR _ocup = [Ocupacao Filial Composta (%)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_ocup), BLANK(),
			        _ocup < 0.75, 1,
			        _ocup <= 0.95, 2,
			        _ocup <= 1.10, 3,
			        4
			    )
		formatString: 0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: f81382bc-60c3-4ed7-9824-e7777c8cc10e

	measure 'Status Capacidade Filial Texto' =
			SWITCH(
			    [Status Capacidade Filial],
			    1, "subocupado",
			    2, "balanceado",
			    3, "saturado",
			    4, "critico",
			    "sem dados"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: e12a7b74-bcde-4e00-82a8-bc3e9af34e0f

	measure 'Status Capacidade Filial Cor' =
			SWITCH(
			    [Status Capacidade Filial],
			    1, "#10B981",
			    2, "#10B981",
			    3, "#F59E0B",
			    4, "#EF4444",
			    "#6A7282"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 9286c3ab-e114-44a6-b97f-777fba7a4610

	measure 'Acao Capacidade Filial' =
			SWITCH(
			    [Status Capacidade Filial],
			    1, "Consolidar volume ou redistribuir rotas na filial",
			    2, "Manter grade atual e acompanhar a semana",
			    3, "Abrir contingencia de frota e revisar mix da filial",
			    4, "Priorizar a filial critica e reduzir a carga por rota",
			    "Validar o cadastro de capacidade da filial"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 25f7c5c9-b380-44b5-b315-cb2a06d3af11

	measure 'Gap Capacidade Volumes Dia' = [Op Media Diaria Volumes] - [Capacidade Volumes Dia Total]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 9ff5224b-9174-414d-b6d7-e480ac287612

	measure 'Gap Capacidade Pedidos Dia' = [Op Media Diaria Pedidos] - [Capacidade Pedidos Dia Total]
