	measure 'SVG Card Capacidade Peso' =
			
			VAR _valorNum = [Ocupacao Filial Peso (%)]
			VAR _temDados = NOT ISBLANK(_valorNum)
			
			VAR _status =
			    SWITCH(
			        TRUE(),
			        NOT _temDados, "SEM DADOS",
			        _valorNum < 0.75, "SUBOCUPADA",
			        _valorNum <= 0.95, "BALANCEADA",
			        _valorNum <= 1.10, "SATURADA",
			        "CRITICA"
			    )
			
			VAR _cor =
			    SWITCH(
			        TRUE(),
			        NOT _temDados, "#6A7282",
			        _valorNum < 0.75, "#F5A623",
			        _valorNum <= 0.95, "#4CAF50",
			        _valorNum <= 1.10, "#F5A623",
			        "#E74C3C"
			    )
			
			VAR _valor =
			    IF(_temDados, FORMAT(_valorNum, "0.0%"), "—")
			
			VAR _media =
			    IF(
			        ISBLANK([Op Media Diaria Peso (kg)]),
			        "—",
			        FORMAT([Op Media Diaria Peso (kg)], "#,##0.0")
			    )
			
			VAR _cap =
			    IF(
			        ISBLANK([Capacidade Peso Dia Total (kg)]),
			        "—",
			        FORMAT([Capacidade Peso Dia Total (kg)], "#,##0.0")
			    )
			
			-- barra: limita 0..1 e garante inteiro >= 0
			VAR _ratio = MIN(MAX(COALESCE(_valorNum, 0), 0), 1)
			VAR _w = MAX(0, ROUND(324 * _ratio, 0))
			
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#FFFDF8' stroke='#E7DDD0'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold, Segoe UI, Arial' font-size='11' fill='#6A7282' letter-spacing='1'>PESO / DIA</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI, Arial' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold, Segoe UI, Arial' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI, Arial' font-size='12' fill='#5C6673'>Media " & _media & " kg vs cap " & _cap & " kg</text>"
			        & "<text x='18' y='117' font-family='Segoe UI, Arial' font-size='11' fill='#324152'>Leitura de peso para saturacao de frota</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#E7DDD0'/>"
			        & "<rect x='18' y='123' width='" & _w & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 4ff17a2b-c5ec-42db-9771-704067ba7bbf
		dataCategory: ImageUrl

	column _
		isHidden
		lineageTag: 7dc38878-6b0a-45e9-9bb2-1c5585c69dcf
		isNameInferred
		sourceColumn: [_]

	partition _Medidas = calculated
		mode: import
		source = ROW("_", 0)

