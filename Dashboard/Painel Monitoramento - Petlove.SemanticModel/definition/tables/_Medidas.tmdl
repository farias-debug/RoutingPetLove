	measure 'Op Volumes Planejados' =
			CALCULATE(
			    SUM(fato_planejado[Volumes Planejados]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: d941acf2-443f-4ac3-9231-5fb96884ca9d

	measure 'Op Rotas Realizadas' =
			CALCULATE(
			    COUNTROWS(fato_rotas),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: b7f0538b-99c9-4ebf-bcd5-610bdfa78c84

	measure 'Op Pedidos Realizados' =
			CALCULATE(
			    SUM(fato_rotas[Pedidos da Rota]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 19cc80a8-37ba-4d60-803a-cdcf82af7604

	measure 'Op Volumes Realizados' =
			CALCULATE(
			    SUM(fato_rotas[Volumes da Rota]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: f74ab674-52d0-4cf1-88d0-4c2580cda6b2

	measure 'Op Rotas Aguardando Aceite' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                NOT ISBLANK(fato_rotas[Status])
			                    && (
			                        CONTAINSSTRING(LOWER(fato_rotas[Status]), "aguard")
			                        || CONTAINSSTRING(LOWER(fato_rotas[Status]), "roteir")
			                        || CONTAINSSTRING(LOWER(fato_rotas[Status]), "aceit")
			                    )
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 0816f699-1f25-4f4c-b78b-7b4d30774076

	measure 'Op Rotas Carregadas' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                NOT ISBLANK(fato_rotas[Data de Carregamento])
			                    && ISBLANK(fato_rotas[Data Inicio Rota])
			                    && (
			                        ISBLANK(fato_rotas[Status])
			                        || (
			                            NOT CONTAINSSTRING(LOWER(fato_rotas[Status]), "final")
			                            && NOT CONTAINSSTRING(LOWER(fato_rotas[Status]), "conclu")
			                        )
			                    )
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 5c3c5a3f-b221-4b21-bd24-598a3b617519

	measure 'Op Rotas Finalizadas' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Rota Concluida], 0) = 1
			                    || (
			                        NOT ISBLANK(fato_rotas[Status])
			                            && (
			                                CONTAINSSTRING(LOWER(fato_rotas[Status]), "final")
			                                || CONTAINSSTRING(LOWER(fato_rotas[Status]), "conclu")
			                            )
			                    )
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: e4fa68d2-c806-4ed3-b100-c9704f7e8e8e

	measure 'Op Rotas Nao Planejadas' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Possui Planejado], 0) = 0
			                    || ISBLANK(fato_rotas[Rota Planejada])
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 12bb0d49-db8c-4966-aebe-cbed3b7b8ad6

	measure 'Op Rotas Sem Tempo' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                ISBLANK(fato_rotas[Tempo Realizado (h)])
			                    || fato_rotas[Tempo Realizado (h)] <= 0
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 854772cb-bfd3-4751-bd0a-f5786d9e2ce3

	/// Progresso das rotas realizadas vs planejadas no dia (%)
	measure 'Op Progresso Rotas (%)' = DIVIDE([Op Rotas Realizadas], [Op Rotas Planejadas], 0)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: a2664c1c-f92d-4191-95d3-c70611eecb49

	/// Progresso dos pedidos realizados vs planejados no dia (%)
	measure 'Op Progresso Pedidos (%)' = DIVIDE([Op Pedidos Realizados], [Op Pedidos Planejados], 0)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 3336e710-a918-42ac-ad86-c4b1208f06d4

	/// Progresso dos volumes realizados vs planejados no dia (%)
	measure 'Op Progresso Volumes (%)' = DIVIDE([Op Volumes Realizados], [Op Volumes Planejados], 0)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: bf6649e3-7a00-4713-831f-d6046bdf1ea5

	measure 'Op Alerta Prioritario' =
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _statusSPR = [KPI SPR Ped Status]
			VAR _statusORH = [KPI ORH Status]
			VAR _capStatus = [Status Capacidade]
			RETURN
			    SWITCH(
			        TRUE(),
			        _naoPlan > 0, FORMAT(_naoPlan, "#,##0") & " rotas nao planejadas. Corrigir reconciliacao do plano",
			        _semTempo > 0, FORMAT(_semTempo, "#,##0") & " rotas sem tempo realizado. Corrigir apontamento no TMS",
			        _statusSPR = "critico", [KPI SPR Ped Acao],
			        _statusORH = "critico", [KPI ORH Acao],
			        _capStatus = 4, [Acao Capacidade],
			        _capStatus = 1, "Capacidade ociosa. Revisar mix e consolidacao de rotas",
			        "Operacao estavel"
			    )
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: acff4528-fe45-467b-971d-c133114f5111

	measure 'HTML Torre Controle Operacional' =
			VAR _rotPlan = [Op Rotas Planejadas]
			VAR _pedPlan = [Op Pedidos Planejados]
			VAR _volPlan = [Op Volumes Planejados]
			VAR _rotReal = [Op Rotas Realizadas]
			VAR _pedReal = [Op Pedidos Realizados]
			VAR _volReal = [Op Volumes Realizados]
			VAR _pRot = [Op Progresso Rotas (%)]
			VAR _pPed = [Op Progresso Pedidos (%)]
			VAR _pVol = [Op Progresso Volumes (%)]
			VAR _aguard = [Op Rotas Aguardando Aceite]
			VAR _carreg = [Op Rotas Carregadas]
			VAR _final = [Op Rotas Finalizadas]
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _alerta = [Op Alerta Prioritario]
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.10)}.title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px;margin-bottom:12px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.box{background:#F9FAFB;border-radius:10px;padding:10px}.k{font-size:11px;color:#6A7282;font-weight:700;text-transform:uppercase}.v{font-size:18px;font-weight:800;color:#441A80}.sub{font-size:12px;color:#6A7282;font-weight:600}.bar{height:10px;background:#E5E7EB;border-radius:999px;overflow:hidden;margin-top:6px}.fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#5B2D8C,#7B44C2)}.status{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:12px}.status-box{background:#F9FAFB;border-radius:10px;padding:10px;text-align:center}.status-k{font-size:11px;color:#6A7282;font-weight:700;text-transform:uppercase}.status-v{font-size:16px;font-weight:800;color:#441A80}.alert{margin-top:12px;padding:10px 12px;border-radius:10px;background:#FFF3E8;border:1px solid #FBD0A2;font-size:12px;color:#8A4B08;font-weight:700}</style>"
			RETURN
			    _css &
			    "<div class='card'><div class='title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 14l3-3 3 2 4-5'/></svg><span>Torre de Controle Operacional</span></div>" &
			    "<div class='grid'><div class='box'><div class='k'>Planejado</div><div class='v'>" & FORMAT(_rotPlan, "#,##0") & " rotas</div><div class='sub'>Pedidos: " & FORMAT(_pedPlan, "#,##0") & " | Volumes: " & FORMAT(_volPlan, "#,##0") & "</div><div class='bar'><div class='fill' style='width:" & FORMAT(MIN(_pRot,1),"0%") & "'></div></div><div class='sub'>Progresso rotas: " & FORMAT(_pRot, "0.0%") & "</div></div><div class='box'><div class='k'>Realizado</div><div class='v'>" & FORMAT(_rotReal, "#,##0") & " rotas</div><div class='sub'>Pedidos: " & FORMAT(_pedReal, "#,##0") & " | Volumes: " & FORMAT(_volReal, "#,##0") & "</div><div class='bar'><div class='fill' style='width:" & FORMAT(MIN(_pPed,1),"0%") & "'></div></div><div class='sub'>Progresso pedidos: " & FORMAT(_pPed, "0.0%") & " | Progresso volumes: " & FORMAT(_pVol, "0.0%") & "</div></div></div>" &
			    "<div class='status'><div class='status-box'><div class='status-k'>Aguardando aceite</div><div class='status-v'>" & FORMAT(_aguard, "#,##0") & "</div></div><div class='status-box'><div class='status-k'>Carregadas</div><div class='status-v'>" & FORMAT(_carreg, "#,##0") & "</div></div><div class='status-box'><div class='status-k'>Finalizadas</div><div class='status-v'>" & FORMAT(_final, "#,##0") & "</div></div></div>" &
			    "<div class='status'><div class='status-box'><div class='status-k'>Rota nao planejada</div><div class='status-v'>" & FORMAT(_naoPlan, "#,##0") & "</div></div><div class='status-box'><div class='status-k'>Rotas sem tempo</div><div class='status-v'>" & FORMAT(_semTempo, "#,##0") & "</div></div><div class='status-box'><div class='status-k'>Alerta</div><div class='status-v' style='font-size:12px'>" & _alerta & "</div></div></div>" &
			    "<div class='alert'>Alertas operacionais: " & _alerta & "</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\05. Torre
		lineageTag: c7cd96b5-55c3-4309-ad43-eefe3400ec49

	measure 'TblExp Se Planejado' =
			VAR _pp = MAX(fato_rotas[Possui Planejado])
			VAR _rp = SELECTEDVALUE(fato_rotas[Rota Planejada])
			RETURN IF(_pp = 1 || NOT ISBLANK(_rp), "Sim", "Nao")
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: a19ea755-6ce8-4362-b259-6b952b261c2f

	measure 'TblExp Tipo Unidade' = COALESCE(SELECTEDVALUE(dim_filial[Tipo]), "Sem Cadastro")
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 99af2507-0494-41be-ba31-31daf1d5e605

	measure 'TblExp Match Temporais' =
			VAR _m =
			    COALESCE(MAX(fato_rotas[Possui Planejado]), 0)
			VAR _gap =
			    SELECTEDVALUE(fato_rotas[Gap Dias Plan vs Real])
			RETURN
			    SWITCH(
			        TRUE(),
			        _m = 0 || ISBLANK(_gap), "Sem Planejado",
			        _gap = 0, "Mesmo Dia",
			        ABS(_gap) = 1, "D+/-1",
			        ABS(_gap) > 1, "Fora D+/-1",
			        "Sem Planejado"
			    )
		displayFolder: 07. Investigacao\01. Linha Operacional
