	/// Peso total transportado em quilogramas no periodo
	measure 'Total Peso (kg)' =
			CALCULATE(
			    SUM(fato_rotas[Peso (kg)]),
			    KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 99843bd6-4eeb-4de5-8e17-b45fa9670b35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Media diaria de volumes no periodo filtrado
	measure 'Op Media Diaria Volumes' = DIVIDE([Total Volumes], [Op Dias com Dados], BLANK())
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 1dce0f25-f83b-4b3b-8c71-7d76aa9cf101

	/// Media diaria de peso em kg no periodo filtrado
	measure 'Op Media Diaria Peso (kg)' = DIVIDE([Total Peso (kg)], [Op Dias com Dados], BLANK())
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 53c2482f-a0cf-4898-9ca8-390b3f1c8a24

	/// Media diaria da performance operacional no periodo filtrado
	measure 'Op Media Diaria Performance (%)' =
			AVERAGEX(
			    FILTER(
			        VALUES(dim_calendario[Data]),
			        CALCULATE(COUNTROWS(fato_rotas)) > 0
			    ),
			    CALCULATE([Performance Media (%)])
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 6b4c7fe4-6db8-4b91-a777-5e6a60762fd2

	measure 'Capacidade Volumes Dia Total' =
			CALCULATE(
			    SUM(dim_filial[Capacidade Volume Dia]),
			    KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 7e663cf0-3e84-4528-b40e-733a9f0dd301

	measure 'Capacidade Pedidos Dia Total' =
			CALCULATE(
			    SUM(dim_filial[Capacidade Pedidos Dia]),
			    KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: d90758ca-3916-485d-8b52-9f8d8dc4c302

	measure 'Capacidade Peso Dia Total (kg)' =
			CALCULATE(
			    SUM(dim_filial[Capacidade Peso Dia (kg)]),
			    KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: b66d01d7-b936-4a7d-bf00-65f619705d03

	measure 'Capacidade Veiculos Dia Total' =
			CALCULATE(
			    SUM(dim_filial[Capacidade Veiculos Dia]),
			    KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: f2c14d8e-579f-4890-ad7c-b966661d2304

	measure 'Capacidade Volumes Semana' = [Capacidade Volumes Dia Total] * [Op Dias com Dados]
		formatString: #,##0
