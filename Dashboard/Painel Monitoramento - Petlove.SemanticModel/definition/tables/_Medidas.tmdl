		lineageTag: d8c1d435-a1ec-4b6e-91ed-0f076ed8c952

	measure 'TblExp Flag Match Fora D+/-1' = IF([TblExp Match Temporais] = "Fora D+/-1", 1, 0)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 0cbe4356-b01e-41a1-81f7-09b8f63911e1

	measure 'TblExp Flag Sem Tempo' = IF(COALESCE(SUM(fato_rotas[Tempo Realizado (h)]), 0) <= 0, 1, 0)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 47260211-c03a-4fb4-bd49-965c248a4136

	measure 'TblExp Flag Overtime 8h' = IF(COALESCE(SUM(fato_rotas[Tempo Realizado (h)]), 0) > 8, 1, 0)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: c8d84b89-8996-46ba-9b12-3dfdd214be84

	measure 'TblExp Flag Acima Capacidade' =
			VAR _maxAd =
			    MAX([TblExp Aderencia Pedidos Linha], [TblExp Aderencia Volumes Linha])
			RETURN IF(_maxAd > 1, 1, 0)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 67e8c7e0-ca67-499d-8051-c0f1368f99bc

	measure 'TblExp Tags Operacionais' =
			VAR _t1 = IF([TblExp Flag Rota Nao Planejada] = 1, "Nao Planejada", BLANK())
			VAR _t2 = IF([TblExp Flag Match Fora D+/-1] = 1, "Match Fora Janela", BLANK())
			VAR _t3 = IF([TblExp Flag Sem Tempo] = 1, "Sem Tempo", BLANK())
			VAR _t4 = IF([TblExp Flag Overtime 8h] = 1, "Overtime", BLANK())
			VAR _t5 = IF([TblExp Flag Acima Capacidade] = 1, "Acima Capacidade", BLANK())
			VAR _join1 = IF(NOT ISBLANK(_t1), _t1, BLANK())
			VAR _join2 = IF(NOT ISBLANK(_t2), IF(ISBLANK(_join1), _t2, _join1 & "; " & _t2), _join1)
			VAR _join3 = IF(NOT ISBLANK(_t3), IF(ISBLANK(_join2), _t3, _join2 & "; " & _t3), _join2)
			VAR _join4 = IF(NOT ISBLANK(_t4), IF(ISBLANK(_join3), _t4, _join3 & "; " & _t4), _join3)
			VAR _join5 = IF(NOT ISBLANK(_t5), IF(ISBLANK(_join4), _t5, _join4 & "; " & _t5), _join4)
			RETURN IF(ISBLANK(_join5), "Sem Alerta", _join5)
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: e0bacc83-e272-46d2-94f4-3362d00bbf65

	measure 'HTML Grafico Tendencia Semanal' =
			VAR _base =
			    TOPN(
			        8,
			        ADDCOLUMNS(
			            SUMMARIZE(
			                ALLSELECTED(dim_calendario),
			                dim_calendario[AnoSemanaLabel],
			                dim_calendario[ISOAnoSemanaSort]
			            ),
			            "@Rotas", CALCULATE([Total Rotas], KEEPFILTERS(dim_filial[Tipo] <> "Provet")),
			            "@Ent", CALCULATE([% Entregas Efetivas], KEEPFILTERS(dim_filial[Tipo] <> "Provet")),
			            "@SPR", CALCULATE([SPR Ped Realizado], KEEPFILTERS(dim_filial[Tipo] = "Unidade")),
			            "@ORH", CALCULATE([Utilizacao Jornada 8h (%)], KEEPFILTERS(dim_filial[Tipo] = "Unidade"))
			        ),
			        dim_calendario[ISOAnoSemanaSort], DESC
			    )
			VAR _maxR = MAXX(_base, [@Rotas])
			VAR _rows =
			    CONCATENATEX(
			        _base,
			        "<div class='row'><div class='wk'>" & dim_calendario[AnoSemanaLabel] & "</div>" &
			        "<div class='bar'><div class='fill' style='width:" & FORMAT(DIVIDE([@Rotas], _maxR, 0) * 100, "0") & "%'></div></div>" &
			        "<div class='v'>" & FORMAT([@Rotas], "#,##0") & "</div>" &
			        "<div class='k'>ENT " & FORMAT([@Ent], "0.0%") & " | SPR " & FORMAT([@SPR], "0.0") & " | ORH " & FORMAT([@ORH], "0.0%") & "</div></div>",
			        "",
			        dim_calendario[ISOAnoSemanaSort], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        ISBLANK(_rows) || LEN(_rows) = 0,
			        "<div style='font-size:12px;color:#6A7282'>Sem dados para o periodo selecionado.</div>",
			        _rows
			    )
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;padding:18px 20px;background:#fff;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.ttl{font-size:13px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.7px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.row{display:grid;grid-template-columns:92px 1fr 58px 200px;gap:10px;align-items:center;margin-bottom:7px}.wk{font-size:11px;color:#6A7282;font-weight:700}.bar{height:10px;background:#EEF1F5;border-radius:999px;overflow:hidden}.fill{height:10px;background:linear-gradient(90deg,#5B2D8C,#7E56C2)}.v{font-size:11px;font-weight:800;color:#24324A;text-align:right}.k{font-size:10px;color:#6A7282;font-weight:700}</style>" &
			"<div class='card'><div class='ttl'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 16l3-4 3 2 4-6'/></svg><span>Tendencia Semanal Operacional</span></div>" &
			_rowsFinal &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\04. Graficos
		lineageTag: c9caddd0-caa8-4853-b67d-4ef540032ebc

	measure 'HTML Grafico Tendencia Mensal' =
			VAR _base =
			    TOPN(
			        6,
			        ADDCOLUMNS(
			            SUMMARIZE(
			                ALLSELECTED(dim_calendario),
			                dim_calendario[AnoMes],
			                dim_calendario[MesNomeAbrev3],
			                dim_calendario[Ano]
			            ),
			            "@Rotas", CALCULATE([Total Rotas], KEEPFILTERS(dim_filial[Tipo] <> "Provet")),
			            "@Ent", CALCULATE([% Entregas Efetivas], KEEPFILTERS(dim_filial[Tipo] <> "Provet")),
			            "@SPR", CALCULATE([SPR Ped Realizado], KEEPFILTERS(dim_filial[Tipo] = "Unidade"))
			        ),
			        dim_calendario[AnoMes], DESC
			    )
			VAR _maxR = MAXX(_base, [@Rotas])
			VAR _rows =
			    CONCATENATEX(
			        _base,
			        "<div class='row'><div class='mo'>" & dim_calendario[MesNomeAbrev3] & "/" & RIGHT(FORMAT(dim_calendario[Ano], "0000"), 2) & "</div>" &
			        "<div class='bar'><div class='fill' style='width:" & FORMAT(DIVIDE([@Rotas], _maxR, 0) * 100, "0") & "%'></div></div>" &
			        "<div class='v'>" & FORMAT([@Rotas], "#,##0") & "</div>" &
			        "<div class='k'>ENT " & FORMAT([@Ent], "0.0%") & " | SPR " & FORMAT([@SPR], "0.0") & "</div></div>",
			        "",
			        dim_calendario[AnoMes], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        ISBLANK(_rows) || LEN(_rows) = 0,
			        "<div style='font-size:12px;color:#6A7282'>Sem dados para o periodo selecionado.</div>",
			        _rows
			    )
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;padding:18px 20px;background:#fff;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.ttl{font-size:13px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.7px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.row{display:grid;grid-template-columns:70px 1fr 58px 130px;gap:10px;align-items:center;margin-bottom:7px}.mo{font-size:11px;color:#6A7282;font-weight:700}.bar{height:10px;background:#EEF1F5;border-radius:999px;overflow:hidden}.fill{height:10px;background:linear-gradient(90deg,#2C8D9E,#58B0BF)}.v{font-size:11px;font-weight:800;color:#24324A;text-align:right}.k{font-size:10px;color:#6A7282;font-weight:700}</style>" &
			"<div class='card'><div class='ttl'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4'/><path d='M16 2v4'/><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M3 10h18'/></svg><span>Tendencia Mensal Operacional</span></div>" &
			_rowsFinal &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\04. Graficos
		lineageTag: af0fe834-e21e-4a1c-a85c-41d33bd4b8ff

	measure 'HTML Grafico Barras Filial Semana' =
			VAR _tab =
			    TOPN(
			        12,
			        ADDCOLUMNS(
			            FILTER(
			                VALUES(dim_filial[Filial]),
			                NOT ISBLANK(dim_filial[Filial])
			                    && CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE(), dim_filial[Tipo] = "Unidade") > 0
			            ),
			            "@Nome", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@Rotas", CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE(), dim_filial[Tipo] = "Unidade"),
			            "@Ent", CALCULATE([% Entregas Efetivas], dim_calendario[IsSemanaAtual] = TRUE(), dim_filial[Tipo] = "Unidade"),
			            "@SPR", CALCULATE([SPR Ped Realizado], dim_calendario[IsSemanaAtual] = TRUE(), dim_filial[Tipo] = "Unidade")
			        ),
			        [@Rotas], DESC
			    )
			VAR _maxV = MAXX(_tab, [@Rotas])
			VAR _rows =
			    CONCATENATEX(
			        _tab,
			        "<div class='row'><div class='name'>" & [@Nome] & "</div><div class='bar'><div class='fill' style='width:" & FORMAT(DIVIDE([@Rotas], _maxV, 0) * 100, "0") & "%'></div></div><div class='val'>" & FORMAT([@Rotas], "#,##0") & "</div><div class='meta'>ENT " & FORMAT([@Ent], "0.0%") & " | SPR " & FORMAT([@SPR], "0.0") & "</div></div>",
			        "",
			        [@Rotas], DESC
			    )
			VAR _rowsFinal =
			    IF(
			        ISBLANK(_rows) || LEN(_rows) = 0,
			        "<div style='font-size:12px;color:#6A7282'>Sem dados de filial na semana atual.</div>",
			        _rows
			    )
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;padding:18px 20px;background:#fff;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.ttl{font-size:13px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.7px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.row{display:grid;grid-template-columns:140px 1fr 60px 120px;gap:10px;align-items:center;margin-bottom:7px}.name{font-size:11px;color:#24324A;font-weight:700}.bar{height:10px;background:#EEF1F5;border-radius:999px;overflow:hidden}.fill{height:10px;background:linear-gradient(90deg,#185A9D,#43CEA2)}.val{font-size:11px;color:#24324A;font-weight:800;text-align:right}.meta{font-size:10px;color:#6A7282;font-weight:700}</style>" &
			"<div class='card'><div class='ttl'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><rect x='7' y='10' width='3' height='7'/><rect x='12' y='7' width='3' height='10'/><rect x='17' y='5' width='3' height='12'/></svg><span>Barras por Filial - Semana Atual</span></div>" &
			_rowsFinal &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\04. Graficos
		lineageTag: f74fa6f9-0bea-4519-b9af-afb317dfcb6b

	/// Media de volumes por rota
	measure 'Media Volumes por Rota' = DIVIDE([Total Volumes], [Total Rotas], 0)
