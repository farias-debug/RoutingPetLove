		lineageTag: 247f60c7-461d-4f71-a684-d6954e4fd203

	/// Meta global de tempo por rota (lookup da tabela _Metas)
	measure 'Meta ORH Tempo (h)' = LOOKUPVALUE(_Metas[Meta], _Metas[KPI], "ORH Tempo Rota")
		formatString: 0.0
		displayFolder: 06. Shared\02. Metas\02. ORH
		lineageTag: a62a3c87-370f-49f4-a45c-4e93d07d5285

	/// Gap entre tempo medio realizado e meta (horas). Positivo = overtime.
	measure 'Gap ORH vs Meta (h)' = [Tempo Medio Realizado (h)] - [Meta ORH Tempo (h)]
		formatString: +0.0;-0.0;0.0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 00669d31-2924-48c0-a22e-2b27ecd3aeab

	/// Soma de horas ociosas (8h - tempo real) para rotas com tempo < 8h
	measure 'Horas Ociosas Totais' =
			CALCULATE(
			    SUMX(
			        FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] > 0 && fato_rotas[Tempo Realizado (h)] < 8),
			        8 - fato_rotas[Tempo Realizado (h)]
			    ),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 9d710e99-e7a3-4964-9605-eb86b763e4e3

	/// Percentual de rotas com tempo realizado abaixo de 4h
	measure '% Rotas Curtas (<4h)' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fato_rotas),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
			        KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 0),
			        KEEPFILTERS(fato_rotas[Tempo Realizado (h)] < 4)
			    ),
			    [Total Rotas ORH Base],
			    0
			)
		formatString: 0.0%
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 69465e2a-c17f-4756-975a-a0ce030e5545

	/// Percentual de rotas com tempo realizado acima de 8h
	measure '% Rotas Overtime (>8h)' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fato_rotas),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
			        KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 8)
			    ),
			    [Total Rotas ORH Base],
			    0
			)
		formatString: 0.0%
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: d69fa0a1-55c6-4903-bb16-5ed6b64135b8

	/// Numero de rotas curtas (<4h) que poderiam ser consolidadas 2-a-2
	measure 'Potencial Consolidacao (rotas)' =
			VAR _curtas =
			    CALCULATE(
			        COUNTROWS(fato_rotas),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
			        KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 0),
			        KEEPFILTERS(fato_rotas[Tempo Realizado (h)] < 4)
			    )
			RETURN INT(DIVIDE(_curtas, 2, 0))
		formatString: #,##0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 41dc4a6f-d60f-4f61-ac9d-5fd381964a7a

	/// Horas economizadas se rotas curtas fossem consolidadas 2-a-2 (50% do tempo ocioso)
	measure 'Economia Potencial (h)' = [Horas Ociosas Totais] * 0.5
		formatString: 0.0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: ff78b77a-50b0-48a9-ad80-5eba0480033d

	/// Semaforo de status ORH baseado na utilizacao vs meta
	measure 'Status ORH' =
			VAR _util = [Utilizacao Jornada 8h (%)]
			VAR _meta = DIVIDE([Meta ORH Tempo (h)], 8, 0)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_util) || _util = 0, "Sem Dados",
			        _util >= _meta * 0.95 && _util <= 1.05, "Ideal",
			        _util < _meta * 0.70, "Subutilizado Critico",
			        _util < _meta * 0.95, "Abaixo do Ideal",
			        _util > 1.25, "Overtime Critico",
			        "Overtime"
			    )
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: dd05186a-4708-4326-a935-f20e28372288

	/// Meta global SPR Pedidos Realizado (da tabela _Metas)
