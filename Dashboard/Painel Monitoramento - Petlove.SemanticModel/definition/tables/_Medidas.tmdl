	/// Percentual de rotas com match temporal no mesmo dia planejado
	measure '% Match Mesmo Dia' =
			VAR _den =
			    CALCULATE(
			        COUNTROWS(FILTER(fato_rotas, COALESCE(fato_rotas[Possui Planejado], 0) = 1)),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			VAR _num =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Possui Planejado], 0) = 1
			                    && fato_rotas[Gap Dias Plan vs Real] = 0
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			RETURN
			    DIVIDE(_num, _den, 0)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\03. Cobertura e Match
		lineageTag: ab626d2f-49aa-423e-af10-582eae1b3fb7

	/// Percentual de rotas com match temporal D+/-1 dia
	measure '% Match D+/-1' =
			VAR _den =
			    CALCULATE(
			        COUNTROWS(FILTER(fato_rotas, COALESCE(fato_rotas[Possui Planejado], 0) = 1)),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			VAR _num =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Possui Planejado], 0) = 1
			                    && ABS(fato_rotas[Gap Dias Plan vs Real]) = 1
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			RETURN
			    DIVIDE(_num, _den, 0)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\03. Cobertura e Match
		lineageTag: bf0071f9-441f-471f-9c05-65abadc94fce

	/// Percentual de rotas sem planejado correspondente
	measure '% Sem Planejado' =
			VAR _num =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Possui Planejado], 0) = 0
			                    || ISBLANK(fato_rotas[Rota Planejada])
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			VAR _den =
			    CALCULATE(
			        [Total Rotas],
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			RETURN
			    DIVIDE(_num, _den, 0)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\03. Cobertura e Match
		lineageTag: effd4ef3-053d-4355-949a-f06671c8923b

	/// Percentual de rotas fora da janela D+/-1
	measure '% Fora Janela D+/-1' =
			VAR _den =
			    CALCULATE(
			        COUNTROWS(FILTER(fato_rotas, COALESCE(fato_rotas[Possui Planejado], 0) = 1)),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			VAR _num =
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                fato_rotas,
			                COALESCE(fato_rotas[Possui Planejado], 0) = 1
			                    && ABS(fato_rotas[Gap Dias Plan vs Real]) > 1
			            )
			        ),
			        KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
			        KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			    )
			RETURN
			    DIVIDE(_num, _den, 0)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\03. Cobertura e Match
		lineageTag: 2c4fc1f8-0f99-4c37-878a-4dee6738685b

	/// Media do gap em dias entre data planejada e data real
	measure 'Gap Medio Plan vs Real (dias)' = AVERAGE(fato_rotas[Gap Dias Plan vs Real])
		formatString: 0.0
		displayFolder: 05. Plano vs Real\04. Contexto de Execucao
		lineageTag: f05f28b8-c86c-4efb-868c-18189b27b276

	/// Media da performance (entregas efetivas vs pedidos) por rota
	measure 'Performance Media (%)' = AVERAGE(fato_rotas[Performance (%)])
