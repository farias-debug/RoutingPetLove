	/// Status semaforo do ocupacao composta da frota (ok/atencao/critico)
	measure 'KPI Capacidade Status' =
			VAR _delta = [KPI Capacidade Delta (pp)]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_delta), "sem-dados",
					_delta >= 0, "ok",
					_delta >= -0.10, "atencao",
					"critico"
				)
		isHidden
		displayFolder: 04. Frota e Capacidade\05. KPI Capacidade
		lineageTag: 1588cc64-e6d3-4bc9-a80c-6c4b23d2ad02

