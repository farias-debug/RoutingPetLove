		lineageTag: 692fadee-6ed2-4f28-9b37-560e2e304c66

	/// Percentual de rotas que tiveram ajudante (flag Ajudante = 1)
	measure '% Rotas com Ajudante' =
			DIVIDE(
			    COUNTROWS(FILTER(fato_rotas, fato_rotas[Ajudante] = 1)),
			    [Total Rotas],
			    0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\04. Contexto de Execucao
		lineageTag: 0f06e18c-e630-4ded-87de-5de3253b3006

	/// Total de rotas filtrado para filiais tipo Unidade (base para SPR)
	measure 'Total Rotas Unidade' =
			CALCULATE(
			    COUNTROWS(fato_rotas),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
		formatString: #,##0
		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: c15eacad-63f2-4c55-b435-cdbb681c30dd

	/// Total de pedidos filtrado para filiais tipo Unidade
	measure 'Total Pedidos Unidade' =
			CALCULATE(
			    SUM(fato_rotas[Pedidos da Rota]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
		formatString: #,##0
