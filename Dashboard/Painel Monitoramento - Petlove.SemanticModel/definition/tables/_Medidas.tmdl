	/// Variacao rotas semana atual vs anterior (absoluto). Protegido contra BLANK.
	measure 'Delta Semana Rotas' = 
			VAR _atu = [Rotas Semana Atual]
			VAR _ant = [Rotas Semana Anterior]
			RETURN
				IF(
					NOT ISBLANK(_atu) && NOT ISBLANK(_ant),
					_atu - _ant,
					BLANK()
				)
		formatString: +#,##0;-#,##0;0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 1e7d9872-9e88-470f-a680-a26edc903385

	/// Variacao SPR Ped semana atual vs anterior (pontos). Protegido contra BLANK.
	measure 'Delta Semana SPR Ped' = 
			VAR _atu = [SPR Ped Semana Atual]
			VAR _ant = [SPR Ped Semana Anterior]
			RETURN
				IF(
					NOT ISBLANK(_atu) && NOT ISBLANK(_ant),
					_atu - _ant,
					BLANK()
				)
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 0d3d61aa-48db-472c-8213-71b561056913

	/// Media movel 7 dias do SPR Ped Realizado. Usa flag IsUltimos7Dias.
	measure 'MA7 SPR Pedidos' = 
			AVERAGEX(
				FILTER(
					dim_calendario,
					dim_calendario[IsUltimos7Dias] = TRUE
				),
				[SPR Ped Realizado]
			)
		formatString: 0.0
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: e5a75bea-0e0e-4c43-8dfd-767947407b38

	/// Media movel 7 dias do tempo medio realizado (h). Usa flag IsUltimos7Dias.
	measure 'MA7 ORH Tempo' = 
			AVERAGEX(
				FILTER(
					dim_calendario,
					dim_calendario[IsUltimos7Dias] = TRUE
				),
				[Tempo Medio Realizado (h)]
			)
		formatString: 0.0
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 95b0657c-d353-4249-8d2c-6aea21060cb2

	/// Media movel 7 dias do total de pedidos. Usa flag IsUltimos7Dias.
	measure 'MA7 Pedidos' = 
			AVERAGEX(
				FILTER(
					dim_calendario,
					dim_calendario[IsUltimos7Dias] = TRUE
				),
				[Total Pedidos]
			)
		formatString: 0.0
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 74969fe2-8349-44ff-8533-9bb3977fb763

	/// Variacao mensal no total de pedidos (%). Usa flags IsMesAtual/IsMesAnterior.
	measure 'Var MoM Pedidos (%)' = 
			VAR _atual = CALCULATE(
				[Total Pedidos],
				dim_calendario[IsMesAtual] = TRUE
			)
			VAR _anterior = CALCULATE(
				[Total Pedidos],
				dim_calendario[IsMesAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior) && _anterior <> 0,
					DIVIDE(
						_atual - _anterior,
						_anterior,
						0
					),
					BLANK()
				)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 99fd562a-48e6-43b8-a19e-413c23426daf

