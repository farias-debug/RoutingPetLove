	/// Card HTML padronizado SPR Pedidos Real
	measure 'HTML Card SPR Ped' =
			
			VAR _valor = [KPI SPR Ped Valor]
			VAR _meta = [KPI SPR Ped Meta]
			VAR _delta = [KPI SPR Ped Delta]
			VAR _deltaPct = [KPI SPR Ped Delta%]
			VAR _status = [KPI SPR Ped Status]
			VAR _statusClass = SWITCH(_status, "ok", "ok", "atencao", "atencao", "critico", "critico", "")
			VAR _deltaClass = IF(_delta > 0, "delta-positive", IF(_delta < 0, "delta-negative", "delta-neutral"))
			VAR _progress = IF(_meta > 0, MIN((_valor / _meta) * 100, 100), 0)
			VAR _iconAlvo = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg>"
