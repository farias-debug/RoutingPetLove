		lineageTag: 657bae91-06ca-44c5-b6f3-53f1b2eef329

	/// Total de volumes filtrado para filiais tipo Unidade
	measure 'Total Volumes Unidade' =
			CALCULATE(
			    SUM(fato_rotas[Volumes da Rota]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			)
		formatString: #,##0
