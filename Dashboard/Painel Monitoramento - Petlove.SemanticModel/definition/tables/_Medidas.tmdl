	/// Variacao semanal em ocupacao composta da frota (pp). Usa flags IsSemanaAtual/Anterior.
	measure 'Var WoW Ocupacao Composta (%)' =
			VAR _atual = CALCULATE(
				[Ocupacao Composta (%)],
				dim_calendario[IsSemanaAtual] = TRUE
			)
			VAR _anterior = CALCULATE(
