	/// Meta SPR por filial (media ponderada das filiais Unidade com meta definida)
	measure 'Meta SPR Pedidos' =
			CALCULATE(
			    AVERAGE(dim_filial[MetaSPR]),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade")
