		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: 7eee1c96-4d50-4083-a9e1-499aefce3f80

	/// Status numerico ORH: 1=dentro faixa ideal (85-115% meta), 0=moderado, -1=fora. Para formatacao condicional.
	measure 'Op Status ORH' = [KPI ORH Status Codigo]
		formatString: 0
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 3170a67d-ca8a-4596-8205-a0ea87acd5bb

	/// Rank SPR por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank SPR Filial' = 
			IF(
				ISBLANK([SPR Ped Realizado]),
				BLANK(),
				RANKX(
					ALLSELECTED(dim_filial[Filial]),
					CALCULATE([SPR Ped Realizado]),
					,
					DESC,
					DENSE
				)
			)
		formatString: 0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: ce39be59-5996-4c8c-a528-9e3119045ceb

	/// Rank Entregas por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank Entregas Filial' = 
			IF(
				ISBLANK([% Entregas Efetivas]),
				BLANK(),
				RANKX(
					ALLSELECTED(dim_filial[Filial]),
					CALCULATE([% Entregas Efetivas]),
					,
					DESC,
					DENSE
				)
			)
		formatString: 0
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: a9ad5ad7-5448-4f06-932c-961b2b05c1db

	/// Rank Score Operacional por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank Score Filial' = 
			IF(
				ISBLANK([Score Operacional]),
				BLANK(),
				RANKX(
					ALLSELECTED(dim_filial[Filial]),
					CALCULATE([Score Operacional]),
					,
					DESC,
					DENSE
				)
			)
		formatString: 0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 1f9e589f-80e2-411b-8509-33964a948d83

	/// Dias distintos com dados (rotas) no periodo filtrado
	measure 'Op Dias com Dados' = 
			COUNTROWS(FILTER(
				VALUES(dim_calendario[Data]),
				CALCULATE(COUNTROWS(fato_rotas)) > 0
			)
			)
		formatString: 0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 7dbef49c-4ef2-4218-be53-5d45ad138a03

	/// Media diaria de rotas no periodo filtrado
	measure 'Op Media Diaria Rotas' = 
			DIVIDE(
				[Total Rotas],
				[Op Dias com Dados],
				BLANK()
			)
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 2f9f4d15-8d7e-406d-af9f-ca3f83ffe46e

	/// Media diaria de pedidos no periodo filtrado
	measure 'Op Media Diaria Pedidos' = 
			DIVIDE(
				[Total Pedidos],
				[Op Dias com Dados],
				BLANK()
			)
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 96bc1c99-4630-4d16-a5ab-58b3ca654779

	/// Participacao % da filial no total de rotas (no contexto selecionado)
	measure 'Op Rotas Filial %' = 
			DIVIDE(
				[Total Rotas],
				CALCULATE(
					[Total Rotas],
					ALLSELECTED(dim_filial[Filial])
				),
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 04c53f35-41fb-4ce7-8c4f-2cfd585c5b41

	/// Participacao % da filial no total de pedidos (no contexto selecionado)
	measure 'Op Pedidos Filial %' = 
			DIVIDE(
				[Total Pedidos],
				CALCULATE(
					[Total Pedidos],
					ALLSELECTED(dim_filial[Filial])
				),
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: b9d32ccf-8cc4-4959-bb5d-d045f3876c2b

	/// Tendencia SPR: 1=subindo vs semana anterior, 0=estavel, -1=caindo
	measure 'Op Tendencia SPR' = 
			VAR _atu = [SPR Ped Semana Atual]
			VAR _ant = [SPR Ped Semana Anterior]
			VAR _delta = _atu - _ant
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_atu) || ISBLANK(_ant), BLANK(),
					_delta > 0.5, 1,
					_delta < -0.5, -1,
					0
				)
		formatString: 0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: fd0054fd-8022-404b-b56f-b8127961b4e7

	/// Tendencia Entregas: 1=subindo vs semana anterior, 0=estavel, -1=caindo
	measure 'Op Tendencia Entregas' = 
			VAR _atu = CALCULATE(
				[% Entregas Efetivas],
				dim_calendario[IsSemanaAtual] = TRUE
			)
			VAR _ant = CALCULATE(
				[% Entregas Efetivas],
				dim_calendario[IsSemanaAnterior] = TRUE
			)
			VAR _delta = _atu - _ant
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_atu) || ISBLANK(_ant), BLANK(),
					_delta > 0.01, 1,
					_delta < -0.01, -1,
					0
				)
		formatString: 0
		isHidden
		displayFolder: 08. Entregas\03. Entrega Operacional
		lineageTag: 52ff68bf-12a3-4d6d-846d-84f8f373f17a

	/// Percentual de ocupacao por pedidos por tipo de veiculo
	measure 'Ocupacao Pedidos Tipo (%)' = 
			VAR _rotas =
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
				KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
			)
			VAR _pedidos =
			CALCULATE(
				SUM(fato_rotas[Pedidos da Rota]),
				KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
				KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
			)
			VAR _mediaAtual = DIVIDE(
				_pedidos,
				_rotas,
				BLANK()
			)
			RETURN
				DIVIDE(
					_mediaAtual,
					[Cap P75 Pedidos],
					0
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: bb63a443-c266-49c0-bd79-9a5a9a42ccb0

	/// Percentual de ocupacao por volumes por tipo de veiculo
	measure 'Ocupacao Volumes Tipo (%)' = 
			VAR _rotas =
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
				KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
			)
			VAR _volumes =
			CALCULATE(
				SUM(fato_rotas[Volumes da Rota]),
				KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
				KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
			)
			VAR _mediaAtual = DIVIDE(
				_volumes,
				_rotas,
				BLANK()
			)
			RETURN
				DIVIDE(
					_mediaAtual,
					[Cap P75 Volumes],
					0
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 5411c1c5-1627-4fab-bcb9-69195c07b136

	/// Ocupacao media composta (pedidos + volumes) vs capacidade P75
	measure 'Ocupacao Composta (%)' = 
			VAR _ped = [Ocupacao Pedidos (%)]
			VAR _vol = [Ocupacao Volumes (%)]
			VAR _qtd = IF(
				NOT ISBLANK(_ped),
				1,
				0
			) + IF(
				NOT ISBLANK(_vol),
				1,
				0
			)
			RETURN
				IF(
					_qtd = 0,
					BLANK(),
					DIVIDE(
						COALESCE(
							_ped,
							0
						) + COALESCE(
							_vol,
							0
						),
						_qtd,
						0
					)
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 85651700-2dea-42f3-a0f9-87b9e632d4fc

	/// Quantidade de rotas acima da capacidade de volumes
	measure 'Rotas Acima Cap Volumes' = 
			SUMX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _capTipo = CALCULATE([Cap P75 Volumes])
				RETURN
					CALCULATE(COUNTROWS(FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Volumes da Rota])
						&& fato_rotas[Volumes da Rota] > _capTipo
					)
					)
					)
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: aee60a54-6191-4b13-bf5d-71189f50ef37

	/// Percentual de rotas acima da capacidade de volumes
	measure '% Rotas Acima Cap Volumes' = 
			DIVIDE(
				[Rotas Acima Cap Volumes],
				COUNTROWS(FILTER(
					fato_rotas,
					NOT ISBLANK(fato_rotas[Volumes da Rota])
					&& fato_rotas[Volumes da Rota] > 0
				)
				),
				0
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 0335cc63-c7ef-43ea-bd03-9818ba593277

	/// Excesso medio de pedidos acima do P75
	measure 'Excesso Medio Pedidos (acima P75)' = 
			VAR _cap = [Cap P75 Pedidos]
			RETURN
				AVERAGEX(
					FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Pedidos da Rota])
						&& fato_rotas[Pedidos da Rota] > _cap
					),
					fato_rotas[Pedidos da Rota] - _cap
				)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 27a405f5-a2dd-4976-926a-c0ede7513649

	/// Excesso medio de volumes acima do P75
	measure 'Excesso Medio Volumes (acima P75)' = 
			VAR _cap = [Cap P75 Volumes]
			RETURN
				AVERAGEX(
					FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Volumes da Rota])
						&& fato_rotas[Volumes da Rota] > _cap
					),
					fato_rotas[Volumes da Rota] - _cap
				)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: f7b5aef8-a421-4139-94ce-36b3cf62eb9d

	/// Tipo de veiculo com ocupacao mais critica
	measure 'Tipo Veiculo Critico Ocupacao' = 
			VAR _tab =
			TOPN(
				1,
				ADDCOLUMNS(
					FILTER(
						VALUES(dim_tipo_veiculo[TipoVeiculo]),
						NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
					),
					"@Occ", [Ocupacao Pedidos Tipo (%)]
				),
				[@Occ],
				DESC,
				dim_tipo_veiculo[TipoVeiculo],
				ASC
			)
			RETURN
				MAXX(
					_tab,
					dim_tipo_veiculo[TipoVeiculo]
				)
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 7f4d0ce8-1526-4e49-ac05-8cc8e0658584

	/// Percentual de ocupacao por pedidos na semana atual
	measure 'Ocupacao Pedidos Semana Atual (%)' = 
			CALCULATE(
				[Ocupacao Pedidos (%)],
				dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 058a184f-5c3e-4ba6-a762-26eda3e806bb

	/// Percentual de ocupacao por volumes na semana atual
	measure 'Ocupacao Volumes Semana Atual (%)' = 
			CALCULATE(
				[Ocupacao Volumes (%)],
				dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 25f2e6d5-acec-434f-bbe8-c73129dba2b1

	/// Total de rotas base para calculo de ORH
	measure 'Total Rotas ORH Base' = 
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
				KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 0)
			)
		formatString: #,##0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: c5960b18-2990-401f-b3a1-1674a5e5ac4c

	/// Total de rotas planejadas base para calculo de ORH
	measure 'Total Rotas ORH Planejado Base' = 
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
				KEEPFILTERS(fato_rotas[Tempo Planejado (h)] > 0)
			)
		formatString: #,##0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 0a8cec47-22a6-4352-9d76-4141b2cd75d5

	/// Total de rotas planejadas no periodo
	measure 'Op Rotas Planejadas' = 
			CALCULATE(
				COUNTROWS(fato_planejado),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 9508efdb-cda4-45be-a330-3a90a1748b80

	/// Total de pedidos planejados no periodo
	measure 'Op Pedidos Planejados' = 
			CALCULATE(
				SUM(fato_planejado[Pedidos Planejados]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 3db77805-238f-4c9f-8abb-84058396468c

	/// Total de volumes planejados no periodo
	measure 'Op Volumes Planejados' = 
			CALCULATE(
				SUM(fato_planejado[Volumes Planejados]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: d941acf2-443f-4ac3-9231-5fb96884ca9d

	/// Total de rotas realizadas no periodo
	measure 'Op Rotas Realizadas' = 
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: b7f0538b-99c9-4ebf-bcd5-610bdfa78c84

	/// Total de pedidos realizados no periodo
	measure 'Op Pedidos Realizados' = 
			CALCULATE(
				SUM(fato_rotas[Pedidos da Rota]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 19cc80a8-37ba-4d60-803a-cdcf82af7604

	/// Total de volumes realizados no periodo
	measure 'Op Volumes Realizados' = 
			CALCULATE(
				SUM(fato_rotas[Volumes da Rota]),
				KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: f74ab674-52d0-4cf1-88d0-4c2580cda6b2

	/// Quantidade de rotas aguardando aceite do motorista
	measure 'Op Rotas Aguardando Aceite' = 
			COALESCE(
				CALCULATE(
					COUNTROWS(FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Status])
						&& (
						CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"aguard"
						)
						|| CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"roteir"
						)
						|| CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"aceit"
						)
						)
					)
					),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
				),
				0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 0816f699-1f25-4f4c-b78b-7b4d30774076

	/// Quantidade de rotas em status carregado
	measure 'Op Rotas Carregadas' = 
			COALESCE(
				CALCULATE(
					COUNTROWS(FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Data de Carregamento])
						&& ISBLANK(fato_rotas[Data Inicio Rota])
						&& (
						ISBLANK(fato_rotas[Status])
						|| (
						NOT CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"final"
						)
						&& NOT CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"conclu"
						)
						)
						)
					)
					),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
				),
				0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 5c3c5a3f-b221-4b21-bd24-598a3b617519

	/// Quantidade de rotas finalizadas no periodo
	measure 'Op Rotas Finalizadas' = 
			COALESCE(
				CALCULATE(
					COUNTROWS(FILTER(
						fato_rotas,
						COALESCE(
							fato_rotas[Rota Concluida],
							0
						) = 1
						|| (
						NOT ISBLANK(fato_rotas[Status])
						&& (
						CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"final"
						)
						|| CONTAINSSTRING(
							LOWER(fato_rotas[Status]),
							"conclu"
						)
						)
						)
					)
					),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
				),
				0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: e4fa68d2-c806-4ed3-b100-c9704f7e8e8e

	/// Quantidade de rotas nao planejadas (extras)
	measure 'Op Rotas Nao Planejadas' = 
			COALESCE(
				CALCULATE(
					COUNTROWS(FILTER(
						fato_rotas,
						COALESCE(
							fato_rotas[Possui Planejado],
							0
						) = 0
						|| ISBLANK(fato_rotas[Rota Planejada])
					)
					),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
				),
				0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 12bb0d49-db8c-4966-aebe-cbed3b7b8ad6

	/// Quantidade de rotas sem tempo habil na janela
	measure 'Op Rotas Sem Tempo' = 
			COALESCE(
				CALCULATE(
					COUNTROWS(FILTER(
						fato_rotas,
						ISBLANK(fato_rotas[Tempo Realizado (h)])
						|| fato_rotas[Tempo Realizado (h)] <= 0
					)
					),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
				),
				0
			)
		formatString: #,##0
		displayFolder: 01. Operacao\06. Status de Rota
		lineageTag: 854772cb-bfd3-4751-bd0a-f5786d9e2ce3

	/// Progresso das rotas realizadas vs planejadas no dia (%)
	measure 'Op Progresso Rotas (%)' = 
			DIVIDE(
				[Op Rotas Realizadas],
				[Op Rotas Planejadas],
				0
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: a2664c1c-f92d-4191-95d3-c70611eecb49

	/// Progresso dos pedidos realizados vs planejados no dia (%)
	measure 'Op Progresso Pedidos (%)' = 
			DIVIDE(
				[Op Pedidos Realizados],
				[Op Pedidos Planejados],
				0
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: 3336e710-a918-42ac-ad86-c4b1208f06d4

	/// Progresso dos volumes realizados vs planejados no dia (%)
	measure 'Op Progresso Volumes (%)' = 
			DIVIDE(
				[Op Volumes Realizados],
				[Op Volumes Planejados],
				0
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\05. Planejado vs Realizado
		lineageTag: bf6649e3-7a00-4713-831f-d6046bdf1ea5

	/// Texto do alerta prioritario para a torre de controle
	measure 'Op Alerta Prioritario' = 
			VAR _naoPlan = [Op Rotas Nao Planejadas]
			VAR _semTempo = [Op Rotas Sem Tempo]
			VAR _statusSPR = [KPI SPR Ped Status]
			VAR _statusORH = [KPI ORH Status]
			VAR _capStatus = [Status Capacidade]
			RETURN
				SWITCH(
					TRUE(),
					_naoPlan > 0, FORMAT(
						_naoPlan,
						"#,##0"
					) & " rotas nao planejadas. Corrigir reconciliacao do plano",
					_semTempo > 0, FORMAT(
						_semTempo,
						"#,##0"
					) & " rotas sem tempo realizado. Corrigir apontamento no TMS",
					_statusSPR = "critico", [KPI SPR Ped Acao],
					_statusORH = "critico", [KPI ORH Acao],
					_capStatus = 4, [Acao Capacidade],
					_capStatus = 1, "Capacidade ociosa. Revisar mix e consolidacao de rotas",
					"Operacao estavel"
				)
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: acff4528-fe45-467b-971d-c133114f5111

	/// Flag indicando se a rota possui planejamento
	measure 'TblExp Se Planejado' = 
			VAR _pp = MAX(fato_rotas[Possui Planejado])
			VAR _rp = SELECTEDVALUE(fato_rotas[Rota Planejada])
			RETURN
				IF(
					_pp = 1 || NOT ISBLANK(_rp),
					"Sim",
					"Nao"
				)
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: a19ea755-6ce8-4362-b259-6b952b261c2f

	/// Tipo de unidade operacional da rota
	measure 'TblExp Tipo Unidade' = 
			COALESCE(
				SELECTEDVALUE(dim_filial[Tipo]),
				"Sem Cadastro"
			)
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 99af2507-0494-41be-ba31-31daf1d5e605

	/// Status de match temporal entre planejado e realizado
	measure 'TblExp Match Temporais' = 
			VAR _m =
			COALESCE(
				MAX(fato_rotas[Possui Planejado]),
				0
			)
			VAR _gap =
			SELECTEDVALUE(fato_rotas[Gap Dias Plan vs Real])
			RETURN
				SWITCH(
					TRUE(),
					_m = 0 || ISBLANK(_gap), "Sem Planejado",
					_gap = 0, "Mesmo Dia",
					ABS(_gap) = 1, "D+/-1",
					ABS(_gap) > 1, "Fora D+/-1",
					"Sem Planejado"
				)
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: c23c1e01-bedc-46a1-921f-bb443ba9705c

	/// Diferenca de pedidos planejado vs realizado por rota
	measure 'TblExp Delta Pedidos Plan x Real' = SUM(fato_rotas[Pedidos da Rota]) - SUM(fato_rotas[Pedidos Planejados])
		formatString: +#,##0;-#,##0;0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 69414ff4-13cc-48d5-bf25-c0d58f427ce7

	/// Diferenca de volumes planejado vs realizado por rota
	measure 'TblExp Delta Volumes Plan x Real' = SUM(fato_rotas[Volumes da Rota]) - SUM(fato_rotas[Volumes Planejados])
		formatString: +#,##0;-#,##0;0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 56148fbb-358a-48f7-847e-97238d44e615

	/// Diferenca de KM planejado vs realizado por rota
	measure 'TblExp Delta KM Plan x Real' = SUM(fato_rotas[KM Realizado]) - SUM(fato_rotas[KM Planejado Plan])
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: b8232994-284b-4f18-b707-2545492cdfd8

	/// Diferenca de tempo planejado vs realizado em horas por rota
	measure 'TblExp Delta Tempo Plan x Real (h)' = SUM(fato_rotas[Tempo Realizado (h)]) - SUM(fato_rotas[Tempo Planejado Plan (h)])
		formatString: +0.0;-0.0;0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 9b9f1c70-5aa4-4b2a-a0d3-73749f7ad7c9

	/// Percentual de entregas efetivas por rota (linha)
	measure 'TblExp % Entregas Efetivas Linha' = 
			DIVIDE(
				SUM(fato_rotas[Entregues]),
				SUM(fato_rotas[Entregues]) + SUM(fato_rotas[Insucessos]),
				0
			)
		formatString: 0.0%
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: e7260831-45ce-49b1-b0af-74e9314336dc

	/// Percentual de insucessos por rota (linha)
	measure 'TblExp % Insucessos Linha' = 
			DIVIDE(
				SUM(fato_rotas[Insucessos]),
				SUM(fato_rotas[Entregues]) + SUM(fato_rotas[Insucessos]),
				0
			)
		formatString: 0.0%
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: db13788b-716a-4cfd-846d-f585c16a2339

	/// SPR pedidos realizado por rota
	measure 'TblExp SPR Ped Real Linha' = 
			DIVIDE(
				SUM(fato_rotas[Pedidos da Rota]),
				COUNTROWS(fato_rotas),
				0
			)
		formatString: 0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: a54b8ccd-a442-453b-ac46-b7115e500534

	/// SPR pedidos planejado por rota
	measure 'TblExp SPR Ped Plan Linha' = 
			DIVIDE(
				SUM(fato_rotas[Pedidos Planejados]),
				COUNTROWS(fato_rotas),
				0
			)
		formatString: 0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 907f6b68-d9b3-4fea-848d-0a7789d37d82

	/// Delta SPR pedidos por rota (real - planejado)
	measure 'TblExp SPR Delta Ped Linha' = [TblExp SPR Ped Real Linha] - [TblExp SPR Ped Plan Linha]
		formatString: +0.0;-0.0;0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: df468704-4034-45b5-a13c-5feead192030

	/// SPR volumes realizado por rota
	measure 'TblExp SPR Vol Real Linha' = 
			DIVIDE(
				SUM(fato_rotas[Volumes da Rota]),
				COUNTROWS(fato_rotas),
				0
			)
		formatString: 0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: b42a084b-a9f5-4f72-8c0f-a8b1686c47ae

	/// SPR volumes planejado por rota
	measure 'TblExp SPR Vol Plan Linha' = 
			DIVIDE(
				SUM(fato_rotas[Volumes Planejados]),
				COUNTROWS(fato_rotas),
				0
			)
		formatString: 0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: e14b23b1-2639-4f55-9962-d829b16726c1

	/// Delta SPR volumes por rota (real - planejado)
	measure 'TblExp SPR Delta Vol Linha' = [TblExp SPR Vol Real Linha] - [TblExp SPR Vol Plan Linha]
		formatString: +0.0;-0.0;0.0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: e0169956-56e1-4fb2-842d-010da17d0ce3

	/// Aderencia de pedidos real vs planejado por rota
	measure 'TblExp Aderencia Pedidos Linha' = 
			VAR _tbl =
			ADDCOLUMNS(
				VALUES(fato_rotas[IdCarga]),
				"@Ped", CALCULATE(SUM(fato_rotas[Pedidos da Rota])),
				"@Cap", CALCULATE(
					[Cap P75 Pedidos],
					ALLEXCEPT(
						fato_rotas,
						fato_rotas[Filial],
						fato_rotas[Tipo de Veiculo Padrao]
					)
				)
			)
			RETURN
				AVERAGEX(
					_tbl,
					DIVIDE(
						[@Ped],
						[@Cap],
						BLANK()
					)
				)
		formatString: 0.00
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 353cb953-9275-4397-8505-f129296775a1

	/// Aderencia de volumes real vs planejado por rota
	measure 'TblExp Aderencia Volumes Linha' = 
			VAR _tbl =
			ADDCOLUMNS(
				VALUES(fato_rotas[IdCarga]),
				"@Vol", CALCULATE(SUM(fato_rotas[Volumes da Rota])),
				"@Cap", CALCULATE(
					[Cap P75 Volumes],
					ALLEXCEPT(
						fato_rotas,
						fato_rotas[Filial],
						fato_rotas[Tipo de Veiculo Padrao]
					)
				)
			)
			RETURN
				AVERAGEX(
					_tbl,
					DIVIDE(
						[@Vol],
						[@Cap],
						BLANK()
					)
				)
		formatString: 0.00
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 10dadc46-27f9-4078-bfc0-a66ecb953774

	/// Flag indicando rota nao planejada (extra)
	measure 'TblExp Flag Rota Nao Planejada' = 
			IF(
				[TblExp Se Planejado] = "Nao",
				1,
				0
			)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: d8c1d435-a1ec-4b6e-91ed-0f076ed8c952

	/// Flag indicando match temporal fora da janela D+/-1
	measure 'TblExp Flag Match Fora D+/-1' = 
			IF(
				[TblExp Match Temporais] = "Fora D+/-1",
				1,
				0
			)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 0cbe4356-b01e-41a1-81f7-09b8f63911e1

	/// Flag indicando rota sem tempo habil na janela
	measure 'TblExp Flag Sem Tempo' = 
			IF(
				COALESCE(
					SUM(fato_rotas[Tempo Realizado (h)]),
					0
				) <= 0,
				1,
				0
			)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 47260211-c03a-4fb4-bd49-965c248a4136

	/// Flag indicando rota com jornada acima de 8 horas
	measure 'TblExp Flag Overtime 8h' = 
			IF(
				COALESCE(
					SUM(fato_rotas[Tempo Realizado (h)]),
					0
				) > 8,
				1,
				0
			)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: c8d84b89-8996-46ba-9b12-3dfdd214be84

	/// Flag indicando rota acima da capacidade do veiculo
	measure 'TblExp Flag Acima Capacidade' = 
			VAR _maxAd =
			MAX(
				[TblExp Aderencia Pedidos Linha],
				[TblExp Aderencia Volumes Linha]
			)
			RETURN
				IF(
					_maxAd > 1,
					1,
					0
				)
		formatString: 0
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 67e8c7e0-ca67-499d-8051-c0f1368f99bc

	/// Tags operacionais concatenadas da rota para drill-through
	measure 'TblExp Tags Operacionais' = 
			VAR _t1 = IF(
				[TblExp Flag Rota Nao Planejada] = 1,
				"Nao Planejada",
				BLANK()
			)
			VAR _t2 = IF(
				[TblExp Flag Match Fora D+/-1] = 1,
				"Match Fora Janela",
				BLANK()
			)
			VAR _t3 = IF(
				[TblExp Flag Sem Tempo] = 1,
				"Sem Tempo",
				BLANK()
			)
			VAR _t4 = IF(
				[TblExp Flag Overtime 8h] = 1,
				"Overtime",
				BLANK()
			)
			VAR _t5 = IF(
				[TblExp Flag Acima Capacidade] = 1,
				"Acima Capacidade",
				BLANK()
			)
			VAR _join1 = IF(
				NOT ISBLANK(_t1),
				_t1,
				BLANK()
			)
			VAR _join2 = IF(
				NOT ISBLANK(_t2),
				IF(
					ISBLANK(_join1),
					_t2,
					_join1 & "; " & _t2
				),
				_join1
			)
			VAR _join3 = IF(
				NOT ISBLANK(_t3),
				IF(
					ISBLANK(_join2),
					_t3,
					_join2 & "; " & _t3
				),
				_join2
			)
			VAR _join4 = IF(
				NOT ISBLANK(_t4),
				IF(
					ISBLANK(_join3),
					_t4,
					_join3 & "; " & _t4
				),
				_join3
			)
			VAR _join5 = IF(
				NOT ISBLANK(_t5),
				IF(
					ISBLANK(_join4),
					_t5,
					_join4 & "; " & _t5
				),
				_join4
			)
			RETURN
				IF(
					ISBLANK(_join5),
					"Sem Alerta",
					_join5
				)
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: e0bacc83-e272-46d2-94f4-3362d00bbf65

	/// Media de volumes por rota
	measure 'Media Volumes por Rota' = 
			DIVIDE(
				[Total Volumes],
				[Total Rotas],
				0
			)
		formatString: 0.0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 4dd9dc5b-dd16-4ba9-a0dd-09c8d80fea7a

	/// Capacidade media de peso por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap Media Peso (kg)' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapMediaPesoKgRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 147837e6-8e89-4191-9574-6ac316ac3ae1

