			VAR _cor =
			    SWITCH(
			        _status,
			        "ESTAVEL", "#4CAF50",
			        "MONITORAR", "#F5A623",
			        "AGIR", "#E74C3C",
			        "#6A7282"
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#FFFDF8' stroke='#E7DDD0'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>ROTAS NA JANELA</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>D-1 " & _deltaDia & " | WoW " & _deltaWow & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>Progresso do plano " & FORMAT(_progresso, "0.0%") & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#E7DDD0'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
