	measure 'Performance Semana Atual (%)' =
			CALCULATE(
			    [Performance Media (%)],
			    dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: a3927f73-7f6f-4bcc-8da1-af307f526920

	measure 'Performance Semana Anterior (%)' =
			CALCULATE(
			    [Performance Media (%)],
			    dim_calendario[IsSemanaAnterior] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 5c5847bf-b9a4-4a18-8ad4-d4d8b23dd321

	measure 'Var WoW Performance (pp)' =
			VAR _atual = [Performance Semana Atual (%)]
			VAR _anterior = [Performance Semana Anterior (%)]
			RETURN
			    IF(
			        NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
			        _atual - _anterior,
			        BLANK()
			    )
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 43d32589-e910-4d7e-9bf9-dcf8fb3e5622

	measure 'SVG Card SPR Ped' =
			VAR _valor = FORMAT([KPI SPR Ped Valor], "0.0")
			VAR _meta = FORMAT([KPI SPR Ped Meta], "0.0")
			VAR _delta = FORMAT([KPI SPR Ped Delta%], "+0.0%;-0.0%;0.0%")
			VAR _wow = FORMAT([KPI SPR Ped Trend WoW], "+0.0%;-0.0%;0.0%")
			VAR _status = SWITCH([KPI SPR Ped Status], "ok", "DENTRO", "atencao", "MONITORAR", "critico", "AGIR", "SEM DADOS")
			VAR _texto = COALESCE([KPI SPR Ped Status Texto], "Sem dados")
			VAR _textoCurto = IF(LEN(_texto) > 34, LEFT(_texto, 34) & "...", _texto)
			VAR _textoSafe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_textoCurto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _cor = COALESCE([KPI SPR Ped Cor], "#6A7282")
			VAR _ratio = MIN(MAX(DIVIDE([KPI SPR Ped Valor], [KPI SPR Ped Meta], 0), 0), 1)
			VAR _svg =
