	/// Card HTML padronizado ORH
	measure 'HTML Card ORH' =
			
			VAR _valor = [KPI ORH Valor]
			VAR _meta = [KPI ORH Meta]
			VAR _delta = [KPI ORH Delta]
			VAR _status = [KPI ORH Status]
			VAR _utilizacao = [Utilizacao Jornada 8h (%)]
			VAR _statusClass = SWITCH(_status, "ok", "ok", "atencao", "atencao", "critico", "critico", "")
			VAR _deltaClass = IF(_delta < 0, "delta-positive", IF(_delta > 0, "delta-negative", "delta-neutral"))
			VAR _progress = IF(_meta > 0, MIN((_meta / _valor) * 100, 100), 0)
			VAR _iconRelogio = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>"
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes growBar{from{width:0}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--status-color,#A3A8B2)}.card.status-ok::before{background:#4CAF50}.card.status-atencao::before{background:#F5A623}.card.status-critico::before{background:#E74C3C}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:38px;font-weight:800;color:#441A80;line-height:1;margin-bottom:8px}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:8px;font-size:13px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.progress-container{width:100%;height:20px;background:#E5E7EB;border-radius:6px;overflow:hidden;margin-top:10px}.progress-bar{height:100%;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;animation:growBar .8s ease-out}.progress-bar.ok{background:linear-gradient(90deg,#4CAF50,#4CAF50cc)}.progress-bar.atencao{background:linear-gradient(90deg,#F5A623,#F5A623cc)}.progress-bar.critico{background:linear-gradient(90deg,#E74C3C,#E74C3Ccc)}.progress-text{font-size:12px;color:#FFF;font-weight:700}</style>"
			RETURN
			_css &
			"<div class='card status-" & _statusClass & "'>" &
			"<div class='card-title'>" & _iconRelogio & "<span>ORH (HORAS/ROTA)</span></div>" &
			"<div class='card-value'>" & FORMAT(_valor, "0.0") & "h</div>" &
			"<div class='meta-row'>" &
			"<span class='meta-text'>Meta: " & FORMAT(_meta, "0.0") & "h | Utiliz: " & FORMAT(_utilizacao, "0.0%") & "</span>" &
			"<span class='delta-badge " & _deltaClass & "'>" & FORMAT(_delta, "+0.0h;-0.0h") & "</span>" &
			"</div>" &
			"<div class='progress-container'>" &
			"<div class='progress-bar " & _statusClass & "' style='width:" & INT(_progress) & "%'>" &
			"<span class='progress-text'>" & INT(_progress) & "%</span>" &
			"</div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 24c50c81-7251-4a3f-9896-f6e580c925d5

	/// Card HTML padronizado Alerta
	measure 'HTML Card Alerta' =
			
			VAR _texto = [Alerta Operacional]
			VAR _nivel = [Alerta Nivel]
			VAR _critSPR = [Qtd Filiais Criticas SPR]
			VAR _abaixoSPR = [Qtd Filiais Abaixo Meta SPR]
			VAR _abaixoEnt = [Qtd Filiais Abaixo Meta Entrega]
			VAR _cor = SWITCH(_nivel, "ok", "#4CAF50", "atencao", "#F5A623", "critico", "#E74C3C", "#A3A8B2")
			VAR _bgCor = SWITCH(_nivel, "critico", "#FEF2F2", "atencao", "#FFFBEB", "#F0FFF4")
			VAR _iconSvg = SWITCH(_nivel,
			    "critico", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#E74C3C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>",
			    "atencao", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#F5A623' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>",
			    "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#4CAF50' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 11-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg>"
			)
			VAR _anim = IF(_nivel = "critico", "animation:pulse 2s infinite,fadeIn .5s ease-out;", "animation:fadeIn .5s ease-out;")
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.1);position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;display:flex;align-items:center;gap:8px}.card-text{font-size:13px;color:#333;line-height:1.6;margin-bottom:10px}.badge-row{display:flex;gap:10px;flex-wrap:wrap}.badge{font-size:13px;padding:4px 10px;border-radius:10px;font-weight:600;display:inline-flex;align-items:center;gap:4px}</style>"
			RETURN
			_css &
			"<div class='card' style='" & _anim & "background:" & _bgCor & ";border-left:4px solid " & _cor & "'>" &
			"<div class='card-title' style='color:" & _cor & "'>" &
			_iconSvg &
			"<span>ALERTA OPERACIONAL</span></div>" &
			"<div class='card-text'>" & _texto & "</div>" &
			"<div class='badge-row'>" &
			"<span class='badge' style='background:#441A8015;color:#441A80'><svg width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='#441A80' stroke-width='2.5'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg> SPR Críticas: " & FORMAT(_critSPR, "#") & "</span>" &
			"<span class='badge' style='background:#E74C3C15;color:#E74C3C'><svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='#E74C3C'/></svg> SPR Abaixo: " & FORMAT(_abaixoSPR, "#") & "</span>" &
			"<span class='badge' style='background:#F5A62315;color:#F5A623'><svg width='10' height='10' viewBox='0 0 10 10'><rect x='1' y='4' width='8' height='2.5' rx='1' fill='#F5A623'/></svg> Ent. Abaixo: " & FORMAT(_abaixoEnt, "#") & "</span>" &
			"</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: f71b2379-18d9-4858-b93a-e67ec342c3e9

	/// Ranking SPR Semana — Baloo 2, SVG flag, hover, fadeIn
	measure 'HTML Ranking SPR Semana' =
			VAR _meta = [Meta Global SPR Ped]
			VAR _base =
			    FILTER(
			        VALUES(dim_filial[Filial]),
			        NOT ISBLANK(dim_filial[Filial])
			            && CALCULATE([Total Rotas Unidade], dim_calendario[IsSemanaAtual] = TRUE()) > 0
			    )
			VAR _tab =
			    TOPN(
			        5,
			        ADDCOLUMNS(
			            _base,
			            "@Nome", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@SPR", CALCULATE([SPR Ped Realizado], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Rotas", CALCULATE([Total Rotas Unidade], dim_calendario[IsSemanaAtual] = TRUE())
			        ),
			        [@SPR], ASC
			    )
			VAR _rows =
			    CONCATENATEX(
			        FILTER(_tab, NOT ISBLANK([@Nome])),
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & [@Nome] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-weight:800;font-size:12px;color:" & IF([@SPR] < _meta * 0.70, "#E74C3C", IF([@SPR] < _meta, "#F5A623", "#4CAF50")) & "'>" & FORMAT([@SPR], "0.0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#6A7282'>" & FORMAT([@Rotas], "#,##0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;font-weight:700;color:" & IF([@SPR] < _meta, "#E74C3C", "#4CAF50") & "'>" & FORMAT(DIVIDE([@SPR] - _meta, _meta, 0), "+0.0%;-0.0%;0.0%") & "</td></tr>",
			        "",
			        [@SPR], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='4' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados de SPR na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px}.badge{font-size:12px;padding:4px 9px;border-radius:999px;font-weight:700;background:#FDEAEA;color:#C53C2F}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}.meta{font-size:12px;color:#8B93A4;margin-top:8px;text-align:right;font-weight:600}</style>"
			RETURN
			    _css &
			    "<div class='card'>" &
			    "<div class='card-head'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='7'/><polyline points='8.21 13.89 7 23 12 20 17 23 15.79 13.88'/></svg><span>Ranking SPR Semana</span></div><span class='badge'>Top 5 piores</span></div>" &
			    "<table><tr><th>FILIAL</th><th class='num'>SPR</th><th class='num'>ROTAS</th><th class='num'>VS META</th></tr>" &
			    _rowsFinal &
			    "</table><div class='meta'>Meta global: " & FORMAT(_meta, "0.0") & " ped/rota</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\02. Rankings
		lineageTag: 05bba779-e778-4acc-a61f-f2f52e6b4f3b

	/// Ranking Entregas Semana — Baloo 2, SVG award, hover
	measure 'HTML Ranking Entregas Semana' =
			VAR _meta = [Meta Global % Entregas]
			VAR _base =
			    FILTER(
			        VALUES(dim_filial[Filial]),
			        NOT ISBLANK(dim_filial[Filial])
			            && CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE()) > 0
			    )
			VAR _tab =
			    TOPN(
			        5,
			        ADDCOLUMNS(
			            _base,
			            "@Nome", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@Ent", CALCULATE([% Entregas Efetivas], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Rotas", CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE())
			        ),
			        [@Ent], ASC
			    )
			VAR _rows =
			    CONCATENATEX(
			        FILTER(_tab, NOT ISBLANK([@Nome])),
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & [@Nome] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-weight:800;font-size:12px;color:" & IF([@Ent] < _meta - 0.05, "#E74C3C", IF([@Ent] < _meta, "#F5A623", "#4CAF50")) & "'>" & FORMAT([@Ent], "0.0%") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#6A7282'>" & FORMAT([@Rotas], "#,##0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;font-weight:700;color:" & IF([@Ent] < _meta, "#E74C3C", "#4CAF50") & "'>" & FORMAT([@Ent] - _meta, "+0.0%;-0.0%;0.0%") & "</td></tr>",
			        "",
			        [@Ent], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='4' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px}.badge{font-size:12px;padding:4px 9px;border-radius:999px;font-weight:700;background:#FDEAEA;color:#C53C2F}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}.meta{font-size:12px;color:#8B93A4;margin-top:8px;text-align:right;font-weight:600}</style>"
			RETURN
			    _css &
			    "<div class='card'>" &
			    "<div class='card-head'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 11-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg><span>Ranking Entregas Semana</span></div><span class='badge'>Top 5 piores</span></div>" &
			    "<table><tr><th>FILIAL</th><th class='num'>% ENT.</th><th class='num'>ROTAS</th><th class='num'>VS META</th></tr>" &
			    _rowsFinal &
			    "</table><div class='meta'>Meta global: " & FORMAT(_meta, "0.0%") & "</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\02. Rankings
		lineageTag: d01c2572-2645-43a9-816f-88cb9cd3a064

	/// ORH Cenários Stacked Bar — Baloo 2, SVG bar-chart, hover, animações
	measure 'HTML Card ORH Cenarios' =
			
			VAR _total = COUNTROWS(FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] > 0))
			VAR _curtas = COUNTROWS(FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] > 0 && fato_rotas[Tempo Realizado (h)] < 4))
			VAR _normais = COUNTROWS(FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] >= 4 && fato_rotas[Tempo Realizado (h)] <= 8))
			VAR _longas = COUNTROWS(FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] > 8 && fato_rotas[Tempo Realizado (h)] <= 10))
			VAR _over = COUNTROWS(FILTER(fato_rotas, fato_rotas[Tempo Realizado (h)] > 10))
			VAR _pCurtas = DIVIDE(_curtas, _total, 0) * 100
			VAR _pNormais = DIVIDE(_normais, _total, 0) * 100
			VAR _pLongas = DIVIDE(_longas, _total, 0) * 100
			VAR _pOver = DIVIDE(_over, _total, 0) * 100
			VAR _potencial = [Potencial Consolidacao (rotas)]
			VAR _economia = [Economia Potencial (h)]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>" &
			"<span>ORH — Cenários de Rota</span></div>" &
			"<div style='display:flex;height:26px;border-radius:8px;overflow:hidden;margin-bottom:14px'>" &
			"<div style='background:#E74C3C;width:" & FORMAT(_pCurtas, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & IF(_pCurtas >= 8, FORMAT(_pCurtas, "0") & "%", "") & "</div>" &
			"<div style='background:#4CAF50;width:" & FORMAT(_pNormais, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & IF(_pNormais >= 8, FORMAT(_pNormais, "0") & "%", "") & "</div>" &
			"<div style='background:#F5A623;width:" & FORMAT(_pLongas, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & IF(_pLongas >= 8, FORMAT(_pLongas, "0") & "%", "") & "</div>" &
			"<div style='background:#5B2D8C;width:" & FORMAT(_pOver, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & IF(_pOver >= 8, FORMAT(_pOver, "0") & "%", "") & "</div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px'>" &
			"<div style='display:flex;align-items:center;gap:6px'><div style='width:10px;height:10px;border-radius:3px;background:#E74C3C'></div><span style='font-size:13px;color:#6A7282'>Curta (<4h): <b>" & FORMAT(_curtas, "#,##0") & "</b> (" & FORMAT(_pCurtas, "0") & "%)</span></div>" &
			"<div style='display:flex;align-items:center;gap:6px'><div style='width:10px;height:10px;border-radius:3px;background:#4CAF50'></div><span style='font-size:13px;color:#6A7282'>Normal (4-8h): <b>" & FORMAT(_normais, "#,##0") & "</b> (" & FORMAT(_pNormais, "0") & "%)</span></div>" &
			"<div style='display:flex;align-items:center;gap:6px'><div style='width:10px;height:10px;border-radius:3px;background:#F5A623'></div><span style='font-size:13px;color:#6A7282'>Longa (8-10h): <b>" & FORMAT(_longas, "#,##0") & "</b> (" & FORMAT(_pLongas, "0") & "%)</span></div>" &
			"<div style='display:flex;align-items:center;gap:6px'><div style='width:10px;height:10px;border-radius:3px;background:#5B2D8C'></div><span style='font-size:13px;color:#6A7282'>Over (>10h): <b>" & FORMAT(_over, "#,##0") & "</b> (" & FORMAT(_pOver, "0") & "%)</span></div></div>" &
			"<div style='border-top:1px solid #E5E7EB;padding-top:10px;display:flex;justify-content:space-between'>" &
			"<span style='font-size:12px;color:#441A80;font-weight:700;display:inline-flex;align-items:center;gap:4px'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='#441A80' stroke-width='2'><polyline points='23 4 23 10 17 10'/><polyline points='1 20 1 14 7 14'/><path d='M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15'/></svg> Potencial: " & FORMAT(_potencial, "#,##0") & " rotas</span>" &
			"<span style='font-size:12px;color:#4CAF50;font-weight:700;display:inline-flex;align-items:center;gap:4px'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='#4CAF50' stroke-width='2'><line x1='12' y1='1' x2='12' y2='23'/><path d='M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6'/></svg> Economia: " & FORMAT(_economia, "0.0") & "h</span>" &
			"</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: c4648faf-0377-4b20-aa82-f377840086f9

	/// Mini KPI Total Rotas — Baloo 2, SVG map-pin, hover
	measure 'HTML Card Total Rotas' =
			
