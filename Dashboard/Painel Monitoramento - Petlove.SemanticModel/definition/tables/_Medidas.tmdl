		lineageTag: 5d20880b-e503-49ac-b1a9-87a4e7c3a705

	measure 'Capacidade Pedidos Semana' = [Capacidade Pedidos Dia Total] * [Op Dias com Dados]
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 728401c1-6501-4897-9a3d-3754ea60ec06

	measure 'Capacidade Peso Semana (kg)' = [Capacidade Peso Dia Total (kg)] * [Op Dias com Dados]
		formatString: #,##0.0
