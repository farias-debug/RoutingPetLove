		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 53c2482f-a0cf-4898-9ca8-390b3f1c8a24

	/// Media diaria da performance operacional no periodo filtrado
	measure 'Op Media Diaria Performance (%)' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_calendario[Data]),
					CALCULATE(COUNTROWS(fato_rotas)) > 0
				),
				CALCULATE([Performance Media (%)])
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 6b4c7fe4-6db8-4b91-a777-5e6a60762fd2

	/// Capacidade total diaria de volumes da filial
	measure 'Capacidade Volumes Dia Total' = 
			CALCULATE(
				SUM(dim_filial[Capacidade Volume Dia]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 7e663cf0-3e84-4528-b40e-733a9f0dd301

	/// Capacidade total diaria de pedidos da filial
	measure 'Capacidade Pedidos Dia Total' = 
			CALCULATE(
				SUM(dim_filial[Capacidade Pedidos Dia]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: d90758ca-3916-485d-8b52-9f8d8dc4c302

	/// Capacidade total diaria de peso da filial em kg
	measure 'Capacidade Peso Dia Total (kg)' = 
			CALCULATE(
				SUM(dim_filial[Capacidade Peso Dia (kg)]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: b66d01d7-b936-4a7d-bf00-65f619705d03

	/// Capacidade total diaria de veiculos da filial
	measure 'Capacidade Veiculos Dia Total' = 
			CALCULATE(
				SUM(dim_filial[Capacidade Veiculos Dia]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: f2c14d8e-579f-4890-ad7c-b966661d2304

	/// Capacidade semanal de volumes da filial
	measure 'Capacidade Volumes Semana' = [Capacidade Volumes Dia Total] * [Op Dias com Dados]
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 5d20880b-e503-49ac-b1a9-87a4e7c3a705

	/// Capacidade semanal de pedidos da filial
	measure 'Capacidade Pedidos Semana' = [Capacidade Pedidos Dia Total] * [Op Dias com Dados]
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 728401c1-6501-4897-9a3d-3754ea60ec06

	/// Capacidade semanal de peso da filial em kg
	measure 'Capacidade Peso Semana (kg)' = [Capacidade Peso Dia Total (kg)] * [Op Dias com Dados]
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: a8fdc512-74b7-492e-8d3b-d8ad2db3d507

	/// Capacidade semanal de veiculos da filial
	measure 'Capacidade Veiculos Semana' = [Capacidade Veiculos Dia Total] * [Op Dias com Dados]
		formatString: #,##0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 10c52f8d-0ac8-4ca1-b919-fdfd3f5e4208

	/// Percentual de ocupacao por volumes da filial
	measure 'Ocupacao Filial Volumes (%)' = 
			DIVIDE(
				[Op Media Diaria Volumes],
				[Capacidade Volumes Dia Total],
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 8dbb4fe1-604b-4d1b-b2b3-6f5db97e7309

	/// Percentual de ocupacao por pedidos da filial
	measure 'Ocupacao Filial Pedidos (%)' = 
			DIVIDE(
				[Op Media Diaria Pedidos],
				[Capacidade Pedidos Dia Total],
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 0e90f3b2-f2f3-4e57-a8ef-f1531c466d0a

	/// Percentual de ocupacao por peso da filial
	measure 'Ocupacao Filial Peso (%)' = 
			DIVIDE(
				[Op Media Diaria Peso (kg)],
				[Capacidade Peso Dia Total (kg)],
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 209af81e-cab9-4461-b3dd-63260847fc0b

	/// Percentual de ocupacao por veiculos da filial
	measure 'Ocupacao Filial Veiculos (%)' = 
			DIVIDE(
				[Op Media Diaria Rotas],
				[Capacidade Veiculos Dia Total],
				BLANK()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 6a82c3d7-c6d6-4472-88cb-48531c12720c

	/// Ocupacao composta da filial (media ponderada pedidos+volumes+peso)
	measure 'Ocupacao Filial Composta (%)' = 
			VAR _veic = [Ocupacao Filial Veiculos (%)]
			VAR _ped = [Ocupacao Filial Pedidos (%)]
			VAR _vol = [Ocupacao Filial Volumes (%)]
			VAR _peso = [Ocupacao Filial Peso (%)]
			VAR _qtd =
			IF(
				NOT ISBLANK(_veic),
				1,
				0
			)
			+ IF(
				NOT ISBLANK(_ped),
				1,
				0
			)
			+ IF(
				NOT ISBLANK(_vol),
				1,
				0
			)
			+ IF(
				NOT ISBLANK(_peso),
				1,
				0
			)
			RETURN
				IF(
					_qtd = 0,
					BLANK(),
					DIVIDE(
						COALESCE(
							_veic,
							0
						) + COALESCE(
							_ped,
							0
						) + COALESCE(
							_vol,
							0
						) + COALESCE(
							_peso,
							0
						),
						_qtd,
						0
					)
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 7f34b013-a0ad-4cd6-bbf5-5b66d3cf970d

	/// Status consolidado de capacidade da filial
	measure 'Status Capacidade Filial' = 
			VAR _ocup = [Ocupacao Filial Composta (%)]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_ocup), BLANK(),
					_ocup < 0.75, 1,
					_ocup <= 0.95, 2,
					_ocup <= 1.10, 3,
					4
				)
		formatString: 0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: f81382bc-60c3-4ed7-9824-e7777c8cc10e

	/// Texto descritivo do status de capacidade da filial
	measure 'Status Capacidade Filial Texto' = 
			SWITCH(
				[Status Capacidade Filial],
				1, "subocupado",
				2, "balanceado",
				3, "saturado",
				4, "critico",
				"sem dados"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: e12a7b74-bcde-4e00-82a8-bc3e9af34e0f

	/// Cor condicional do status de capacidade da filial
	measure 'Status Capacidade Filial Cor' = 
			SWITCH(
				[Status Capacidade Filial],
				1, "#10B981",
				2, "#10B981",
				3, "#F59E0B",
				4, "#EF4444",
				"#6A7282"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 9286c3ab-e114-44a6-b97f-777fba7a4610

	/// Texto de acao recomendada para capacidade da filial
	measure 'Acao Capacidade Filial' = 
			SWITCH(
				[Status Capacidade Filial],
				1, "Consolidar volume ou redistribuir rotas na filial",
				2, "Manter grade atual e acompanhar a semana",
				3, "Abrir contingencia de frota e revisar mix da filial",
				4, "Priorizar a filial critica e reduzir a carga por rota",
				"Validar o cadastro de capacidade da filial"
			)
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 25f7c5c9-b380-44b5-b315-cb2a06d3af11

	/// Gap entre demanda e capacidade diaria de volumes
	measure 'Gap Capacidade Volumes Dia' = [Op Media Diaria Volumes] - [Capacidade Volumes Dia Total]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 9ff5224b-9174-414d-b6d7-e480ac287612

	/// Gap entre demanda e capacidade diaria de pedidos
	measure 'Gap Capacidade Pedidos Dia' = [Op Media Diaria Pedidos] - [Capacidade Pedidos Dia Total]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 1220a0ef-596f-40f5-b7e0-bfb07cbf7c13

	/// Gap entre demanda e capacidade diaria de peso em kg
	measure 'Gap Capacidade Peso Dia (kg)' = [Op Media Diaria Peso (kg)] - [Capacidade Peso Dia Total (kg)]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 0f6bfc30-9670-41e5-b278-e98250374114

	/// Gap entre demanda e capacidade diaria de veiculos
	measure 'Gap Capacidade Veiculos Dia' = [Op Media Diaria Rotas] - [Capacidade Veiculos Dia Total]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: 343fa60b-98bf-4ba0-a9d8-3a2455e58f15

	/// Gap entre demanda e capacidade semanal de volumes
	measure 'Gap Capacidade Volumes Semana' = [Total Volumes] - [Capacidade Volumes Semana]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: c56cbba5-cf80-4860-bfe9-65f222655f16

	/// Gap entre demanda e capacidade semanal de pedidos
	measure 'Gap Capacidade Pedidos Semana' = [Total Pedidos] - [Capacidade Pedidos Semana]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: ab3f6996-d007-473a-bb2f-f5877840a217

	/// Gap entre demanda e capacidade semanal de peso em kg
	measure 'Gap Capacidade Peso Semana (kg)' = [Total Peso (kg)] - [Capacidade Peso Semana (kg)]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: ec85a90c-590b-4ae5-a5a2-c995dc10c318

	/// Gap entre demanda e capacidade semanal de veiculos
	measure 'Gap Capacidade Veiculos Semana' = [Total Rotas] - [Capacidade Veiculos Semana]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04. Frota e Capacidade\04. Filial e Semana
		lineageTag: f0475d3b-5f95-4de8-ab1c-b4be3972cb19

	/// Indicador de performance consolidada da semana atual
	measure 'Performance Semana Atual (%)' = 
			CALCULATE(
				[Performance Media (%)],
				dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: a3927f73-7f6f-4bcc-8da1-af307f526920

	/// Indicador de performance consolidada da semana anterior
	measure 'Performance Semana Anterior (%)' = 
			CALCULATE(
				[Performance Media (%)],
				dim_calendario[IsSemanaAnterior] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 5c5847bf-b9a4-4a18-8ad4-d4d8b23dd321

	/// Variacao semana sobre semana da performance consolidada em pp
	measure 'Var WoW Performance (pp)' = 
			VAR _atual = [Performance Semana Atual (%)]
			VAR _anterior = [Performance Semana Anterior (%)]
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 43d32589-e910-4d7e-9bf9-dcf8fb3e5622

	column _
		isHidden
		lineageTag: 7dc38878-6b0a-45e9-9bb2-1c5585c69dcf
		isNameInferred
		sourceColumn: [_]

	partition _Medidas = calculated
		mode: import
		source = 
				ROW(
					"_", 0
				)

	/// Meta global para taxa de conclusao de rotas (via LOOKUPVALUE na tabela _Metas)
	measure 'Meta Global % Rotas Concluidas' = LOOKUPVALUE(_Metas[Meta], _Metas[KPI], "% Rotas Concluidas")
		formatString: 0.0%
		isHidden
		displayFolder: 06. Shared\02. Metas\04. Rotas
		lineageTag: 8be44c88-2446-46d8-b729-3609205ec003

	/// Variacao dia a dia em taxa de conclusao de rotas (pp). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 % Rotas Concluidas' =
			VAR _atual = CALCULATE(
				[% Rotas Concluidas],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[% Rotas Concluidas],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 2797510d-de0b-4359-ae4a-2ae5f2dd7e52

	/// Variacao semanal em taxa de conclusao de rotas (pp). Usa flags IsSemanaAtual/Anterior.
	measure 'Var WoW % Rotas Concluidas' =
			VAR _atual = CALCULATE(
				[% Rotas Concluidas],
				dim_calendario[IsSemanaAtual] = TRUE
			)
			VAR _anterior = CALCULATE(
				[% Rotas Concluidas],
				dim_calendario[IsSemanaAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0 pp;-0.0 pp;0.0 pp
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: a1bf479e-90a7-42bc-80e3-8518685ceaed

	/// Meta global para ocupacao composta da frota (via LOOKUPVALUE na tabela _Metas)
	measure 'Meta Global Ocupacao Composta' = LOOKUPVALUE(_Metas[Meta], _Metas[KPI], "Ocupacao Composta")
		formatString: 0.0%
		isHidden
		displayFolder: 06. Shared\02. Metas\05. Capacidade
		lineageTag: 2a63f195-bb33-418e-8880-e90cd3bcfe12

