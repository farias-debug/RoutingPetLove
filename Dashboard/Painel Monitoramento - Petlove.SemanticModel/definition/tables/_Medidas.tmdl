	/// Delta SPR Ped: valor - meta
	measure 'KPI SPR Ped Delta' = [KPI SPR Ped Valor] - [KPI SPR Ped Meta]
		formatString: +0.0;-0.0;0.0
		displayFolder: 02. SPR e Performance\04. KPI SPR Pedidos
		lineageTag: 6ab5f263-e4c9-40ee-a00d-270caff84dfc

	/// Delta % SPR Ped
	measure 'KPI SPR Ped Delta%' = DIVIDE([KPI SPR Ped Valor] - [KPI SPR Ped Meta], [KPI SPR Ped Meta], 0)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02. SPR e Performance\04. KPI SPR Pedidos
		lineageTag: fdeb8778-6fc5-40e8-9fc8-438724e0d6a8

	/// Status semaforo SPR Ped
	measure 'KPI SPR Ped Status' =
			VAR _delta = [KPI SPR Ped Delta%]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_delta), "sem-dados",
			        _delta >= 0, "ok",
			        _delta >= -0.10, "atencao",
			        "critico"
			    )
		displayFolder: 02. SPR e Performance\04. KPI SPR Pedidos
		lineageTag: 030157f9-3f8d-40b9-a2a1-f05e604c32e0

	/// Cor hex para formatacao condicional
	measure 'KPI SPR Ped Cor' =
			SWITCH(
			    [KPI SPR Ped Status],
			    "ok",       "#4CAF50",
			    "atencao",  "#F5A623",
			    "critico",  "#E74C3C",
			    "#6A7282"
			)
		displayFolder: 02. SPR e Performance\04. KPI SPR Pedidos
		lineageTag: 095883f2-c7bc-46e3-9299-e39c6048840c

	/// Icone direcional
	measure 'KPI SPR Ped Icone' =
			SWITCH(
			    [KPI SPR Ped Status],
			    "ok",       "^",
			    "atencao",  "~",
			    "critico",  "v",
			    "-"
			)
		isHidden
		displayFolder: 02. SPR e Performance\04. KPI SPR Pedidos
		lineageTag: 77f7b8bb-8e9f-432a-92a7-026a19c8bfaf

	/// Texto concatenado para card
	measure 'KPI SPR Ped Texto Card' =
