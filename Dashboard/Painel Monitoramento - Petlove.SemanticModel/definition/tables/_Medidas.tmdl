	/// Stops Per Route de pedidos realizado - media de pedidos por rota
	measure 'SPR Ped Realizado' = DIVIDE([Total Pedidos Unidade], [Total Rotas Unidade], 0)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\01. SPR Base
		lineageTag: 36276021-7cc3-4010-8ee5-8cbb8f60c426

	/// Stops Per Route de volumes realizado - media de volumes por rota
	measure 'SPR Vol Realizado' = DIVIDE([Total Volumes Unidade], [Total Rotas Unidade], 0)
