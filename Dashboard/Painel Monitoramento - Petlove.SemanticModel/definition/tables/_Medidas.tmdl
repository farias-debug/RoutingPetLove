	/// KM medio por rota (apenas filiais Unidade)
	measure 'SPR KM Realizado (km/rota)' =
			DIVIDE(
			    CALCULATE(
			        SUM(fato_rotas[KM Realizado]),
			        KEEPFILTERS(dim_filial[Tipo] = "Unidade")
			    ),
			    [Total Rotas Unidade],
