	/// Mini KPI Ve\u00edculos Ativos — Baloo 2, SVG truck, hover
	measure 'HTML Card Veiculos' =
			
			VAR _ativos = [Veiculos Ativos]
			VAR _rotasPorVeiculo = [Rotas por Veiculo Dia]
			VAR _iconCaminhao = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/></svg>"
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}</style>"
			RETURN
			_css &
			"<div class='card'>" &
			"<div class='card-title'>" & _iconCaminhao & "<span>VEÍCULOS ATIVOS</span></div>" &
			"<div class='card-value'>" & FORMAT(_ativos, "#,##0") & "</div>" &
			"<div class='card-subtitle'>Frota operacional</div>" &
			"<div class='card-label'>Média: " & FORMAT(_rotasPorVeiculo, "0.0") & " rotas/veículo/dia</div>" &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 97543c50-dbad-4fa3-9e6a-2c01f65d7381

	/// Mini KPI Peso Total — Baloo 2, SVG box, hover
	measure 'HTML Card Peso Total' =
			
			VAR _pesoKg = [Total Peso (kg)]
			VAR _sprPeso = [SPR Peso Realizado (kg/rota)]
			VAR _iconPeso = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2L2 7v10l10 5 10-5V7z'/><polyline points='12 17 12 22'/><polyline points='7 14.5 7 17'/><polyline points='17 14.5 17 17'/></svg>"
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}</style>"
			RETURN
			_css &
			"<div class='card'>" &
			"<div class='card-title'>" & _iconPeso & "<span>PESO TOTAL</span></div>" &
			"<div class='card-value'>" & FORMAT(_pesoKg / 1000, "#,##0.0") & " t</div>" &
			"<div class='card-subtitle'>Carga transportada</div>" &
			"<div class='card-label'>SPR Peso: " & FORMAT(_sprPeso, "#,##0") & " kg/rota</div>" &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 68b4d638-b887-41e5-a700-56dcdc2b1aeb

	/// Ticker Variação Diária — Baloo 2, SVG arrows por métrica, hover
	measure 'HTML Card Variacao Diaria' =
			
			VAR _varSPR = [Var D-1 SPR Pedidos]
			VAR _varEnt = [Var D-1 % Entregas]
			VAR _varORH = [Var D-1 ORH Tempo]
			VAR _varRotas = [Var D-1 Rotas]
			VAR _varPedidos = [Var D-1 Pedidos]
			VAR _classSPR = IF(_varSPR > 0, "delta-positive", IF(_varSPR < 0, "delta-negative", "delta-neutral"))
			VAR _classEnt = IF(_varEnt > 0, "delta-positive", IF(_varEnt < 0, "delta-negative", "delta-neutral"))
			VAR _classORH = IF(_varORH < 0, "delta-positive", IF(_varORH > 0, "delta-negative", "delta-neutral"))
			VAR _iconGrafico = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg>"
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:6px}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.card-label{font-size:12px;color:#6A7282;font-weight:600}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}</style>"
			RETURN
			_css &
			"<div class='card'>" &
			"<div class='card-title'>" & _iconGrafico & "<span>VARIAÇÃO D-1 (DIA ANTERIOR)</span></div>" &
			"<div class='grid-row'>" &
			"<span class='card-label'>SPR Pedidos:</span>" &
			"<span class='delta-badge " & _classSPR & "'>" & FORMAT(_varSPR, "+0.0%;-0.0%") & "</span>" &
			"</div>" &
			"<div class='grid-row'>" &
			"<span class='card-label'>% Entregas:</span>" &
			"<span class='delta-badge " & _classEnt & "'>" & FORMAT(_varEnt, "+0.0pp;-0.0pp") & "</span>" &
			"</div>" &
			"<div class='grid-row'>" &
			"<span class='card-label'>ORH Tempo:</span>" &
			"<span class='delta-badge " & _classORH & "'>" & FORMAT(_varORH, "+0.0%;-0.0%") & "</span>" &
			"</div>" &
			"<div class='grid-row'>" &
			"<span class='card-label'>Rotas:</span>" &
			"<span class='delta-badge'>" & FORMAT(_varRotas, "+#,##0;-#,##0") & "</span>" &
			"</div>" &
			"<div class='grid-row'>" &
			"<span class='card-label'>Pedidos:</span>" &
			"<span class='delta-badge'>" & FORMAT(_varPedidos, "+#,##0;-#,##0") & "</span>" &
			"</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 383665e4-f0d8-4fd3-aec6-2b34d9baff0c

	/// Produtividade por Hora — Baloo 2, SVG zap, hover
	measure 'HTML Card Produtividade' =
			
			VAR _phr = [Pedidos/h Realizado]
			VAR _php = [Pedidos/h Planejado]
			VAR _vhr = [Volumes/h Realizado]
			VAR _vhp = [Volumes/h Planejado]
			VAR _ehr = [Entregas Efetivas/h]
			VAR _dPed = [Desvio Pedidos/h]
			VAR _dVol = [Desvio Volumes/h]
			VAR _corPed = IF(_dPed >= 0, "#4CAF50", "#E74C3C")
			VAR _corVol = IF(_dVol >= 0, "#4CAF50", "#E74C3C")
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/></svg>" &
			"<span>Produtividade por Hora</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px'>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Pedidos/h</div>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_phr, "0.0") & "</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:3px;font-size:13px;color:" & _corPed & ";font-weight:700'>" & IF(_dPed >= 0, "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='" & _corPed & "'/></svg>", "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='" & _corPed & "'/></svg>") & " " & FORMAT(_dPed, "+0.0;-0.0;0") & " vs plan</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Plan: " & FORMAT(_php, "0.0") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Volumes/h</div>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_vhr, "0.0") & "</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:3px;font-size:13px;color:" & _corVol & ";font-weight:700'>" & IF(_dVol >= 0, "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='" & _corVol & "'/></svg>", "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='" & _corVol & "'/></svg>") & " " & FORMAT(_dVol, "+0.0;-0.0;0") & " vs plan</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Plan: " & FORMAT(_vhp, "0.0") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Entregas/h</div>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_ehr, "0.0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;margin-top:4px;font-weight:500'>Efetivas por hora</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 65211393-8e5d-400e-b0ac-0cf5c82fd4b2

	/// Eficiência KM Gauge — Baloo 2, SVG compass, gradient bar, hover
	measure 'HTML Card Eficiencia KM' =
			
			VAR _efic = [Eficiencia KM (%)]
			VAR _pkm = [Pedidos/KM Realizado]
			VAR _vkm = [Volumes/KM Realizado]
			VAR _wkm = [Peso/KM Realizado (kg/km)]
			VAR _cor = IF(_efic >= 0.95, "#4CAF50", IF(_efic >= 0.80, "#F5A623", "#E74C3C"))
			VAR _pct = INT(MIN(_efic, 1.2) * 100)
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes growBar{from{width:0}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polygon points='16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76'/></svg>" &
			"<span>Eficiência KM</span></div>" &
			"<div style='text-align:center;margin-bottom:14px'>" &
			"<div style='font-size:38px;font-weight:800;color:" & _cor & ";letter-spacing:-1px'>" & FORMAT(_efic, "0%") & "</div>" &
			"<div style='font-size:13px;color:#A3A8B2;font-weight:500'>Plan / Realizado</div></div>" &
			"<div style='background:#E5E7EB;border-radius:8px;height:8px;margin-bottom:14px;overflow:hidden'>" &
			"<div style='background:linear-gradient(90deg," & _cor & "," & _cor & "cc);width:" & _pct & "%;height:8px;border-radius:8px;animation:growBar .8s ease-out'></div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center'>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_pkm, "0.00") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>Ped/KM</div></div>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_vkm, "0.00") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>Vol/KM</div></div>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_wkm, "0.0") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>kg/KM</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: ad3e861a-7211-44c9-9fd2-fb67e2d0f03d

	/// Capacidade e Ocupação — Baloo 2, SVG server, gradient bars, hover
	measure 'HTML Card Capacidade' =
			
			VAR _opcPed = [Ocupacao Pedidos (%)]
			VAR _opcVol = [Ocupacao Volumes (%)]
			VAR _capPed = [Cap P75 Pedidos]
			VAR _capVol = [Cap P75 Volumes]
			VAR _capPeso = [Cap P75 Peso (kg)]
			VAR _medPed = [Cap Media Pedidos]
			VAR _status = [Status Capacidade]
			VAR _corPed = IF(_opcPed < 0.70, "#4CAF50", IF(_opcPed <= 0.90, "#F5A623", "#E74C3C"))
			VAR _corVol = IF(_opcVol < 0.70, "#4CAF50", IF(_opcVol <= 0.90, "#F5A623", "#E74C3C"))
			VAR _wPed = INT(MIN(_opcPed, 1) * 100)
			VAR _wVol = INT(MIN(_opcVol, 1) * 100)
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes growBar{from{width:0}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:14px'>" &
			"<div style='display:flex;align-items:center;gap:6px'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='2' width='20' height='8' rx='2' ry='2'/><rect x='2' y='14' width='20' height='8' rx='2' ry='2'/><line x1='6' y1='6' x2='6.01' y2='6'/><line x1='6' y1='18' x2='6.01' y2='18'/></svg>" &
			"<span>Capacidade e Ocupação</span></div>" &
			"<span style='font-size:13px;padding:3px 10px;background:#441A8015;color:#441A80;border-radius:10px;font-weight:600'>" & _status & "</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:14px'>" &
			"<div><div style='display:flex;justify-content:space-between;font-size:13px;color:#6A7282;margin-bottom:5px;font-weight:500'><span>Ocupação Pedidos</span><span style='font-weight:700;color:" & _corPed & "'>" & FORMAT(_opcPed, "0%") & "</span></div><div style='background:#E5E7EB;border-radius:6px;height:7px;overflow:hidden'><div style='background:linear-gradient(90deg," & _corPed & "," & _corPed & "cc);width:" & _wPed & "%;height:7px;border-radius:6px;animation:growBar .8s ease-out'></div></div></div>" &
			"<div><div style='display:flex;justify-content:space-between;font-size:13px;color:#6A7282;margin-bottom:5px;font-weight:500'><span>Ocupação Volumes</span><span style='font-weight:700;color:" & _corVol & "'>" & FORMAT(_opcVol, "0%") & "</span></div><div style='background:#E5E7EB;border-radius:6px;height:7px;overflow:hidden'><div style='background:linear-gradient(90deg," & _corVol & "," & _corVol & "cc);width:" & _wVol & "%;height:7px;border-radius:6px;animation:growBar .8s ease-out'></div></div></div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center;border-top:1px solid #E5E7EB;padding-top:12px'>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_capPed, "0") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>P75 Ped</div></div>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_capVol, "0") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>P75 Vol</div></div>" &
			"<div><div style='font-size:15px;font-weight:700;color:#441A80'>" & FORMAT(_capPeso, "0") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>P75 Peso</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: c8f2f666-1fd4-43c5-8de8-5f886b347865

	/// Reconciliação Plan x Real — Baloo 2, SVG git-merge, hover
	measure 'HTML Card Reconciliacao' =
			
			VAR _mesmoDia = [% Match Mesmo Dia]
			VAR _dpm1 = [% Match D+/-1]
			VAR _semPlan = [% Sem Planejado]
			VAR _foraD1 = [% Fora Janela D+/-1]
			VAR _gap = [Gap Medio Plan vs Real (dias)]
			VAR _cob = [Cobertura Rotas (%)]
			VAR _perf = [Performance Media (%)]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='18' r='3'/><circle cx='6' cy='6' r='3'/><path d='M6 21V9a9 9 0 009 9'/></svg>" &
			"<span>Reconciliação Plan × Real</span></div>" &
			"<div style='display:flex;height:26px;border-radius:8px;overflow:hidden;margin-bottom:14px'>" &
			"<div style='background:#4CAF50;width:" & FORMAT(_mesmoDia * 100, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & FORMAT(_mesmoDia, "0%") & "</div>" &
			"<div style='background:#F5A623;width:" & FORMAT(_dpm1 * 100, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & FORMAT(_dpm1, "0%") & "</div>" &
			"<div style='background:#E74C3C;width:" & FORMAT(_foraD1 * 100, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & IF(_foraD1 >= 0.05, FORMAT(_foraD1, "0%"), "") & "</div>" &
			"<div style='background:#A3A8B2;width:" & FORMAT(_semPlan * 100, "0") & "%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:700'>" & FORMAT(_semPlan, "0%") & "</div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-bottom:12px'>" &
			"<div style='display:flex;align-items:center;gap:5px'><div style='width:8px;height:8px;border-radius:3px;background:#4CAF50'></div><span style='font-size:12px;color:#6A7282;font-weight:500'>Mesmo Dia</span></div>" &
			"<div style='display:flex;align-items:center;gap:5px'><div style='width:8px;height:8px;border-radius:3px;background:#F5A623'></div><span style='font-size:12px;color:#6A7282;font-weight:500'>D+/-1</span></div>" &
			"<div style='display:flex;align-items:center;gap:5px'><div style='width:8px;height:8px;border-radius:3px;background:#E74C3C'></div><span style='font-size:12px;color:#6A7282;font-weight:500'>Fora D+/-1</span></div>" &
			"<div style='display:flex;align-items:center;gap:5px'><div style='width:8px;height:8px;border-radius:3px;background:#A3A8B2'></div><span style='font-size:12px;color:#6A7282;font-weight:500'>Sem Planejado</span></div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center;border-top:1px solid #E5E7EB;padding-top:10px'>" &
			"<div><div style='font-size:14px;font-weight:700;color:#441A80'>" & FORMAT(_gap, "0.0") & "d</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>Gap Médio</div></div>" &
			"<div><div style='font-size:14px;font-weight:700;color:#441A80'>" & FORMAT(_cob, "0%") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>Cobertura</div></div>" &
			"<div><div style='font-size:14px;font-weight:700;color:#441A80'>" & FORMAT(_perf, "0%") & "</div><div style='font-size:12px;color:#A3A8B2;font-weight:500'>Performance</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 758d4f57-5f96-45db-b099-c83ba11c50c3

	/// Ranking ORH Semana — Baloo 2, SVG clock, hover
	measure 'HTML Ranking ORH Semana' =
			VAR _base =
			    FILTER(
			        VALUES(dim_filial[Filial]),
			        NOT ISBLANK(dim_filial[Filial])
			            && CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE()) > 0
			    )
			VAR _tab =
			    TOPN(
			        5,
			        ADDCOLUMNS(
			            _base,
			            "@Nome", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@Util", CALCULATE([Utilizacao Jornada 8h (%)], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Tempo", CALCULATE([Tempo Medio Realizado (h)], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Rotas", CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE())
			        ),
			        [@Util], ASC
			    )
			VAR _rows =
			    CONCATENATEX(
			        FILTER(_tab, NOT ISBLANK([@Nome])),
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & [@Nome] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-weight:800;font-size:12px;color:" & IF([@Util] < 0.60, "#E74C3C", IF([@Util] < 0.80, "#F5A623", "#4CAF50")) & "'>" & FORMAT([@Util], "0.0%") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#6A7282'>" & FORMAT([@Tempo], "0.0") & "h</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#6A7282'>" & FORMAT([@Rotas], "#,##0") & "</td></tr>",
			        "",
			        [@Util], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='4' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px}.badge{font-size:12px;padding:4px 9px;border-radius:999px;font-weight:700;background:#FFF2DC;color:#B9770E}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}</style>"
			RETURN
			    _css &
			    "<div class='card'>" &
			    "<div class='card-head'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg><span>Ranking ORH Semana</span></div><span class='badge'>Top 5 menores</span></div>" &
			    "<table><tr><th>FILIAL</th><th class='num'>UTIL.</th><th class='num'>TEMPO</th><th class='num'>ROTAS</th></tr>" &
			    _rowsFinal &
			    "</table></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\02. Rankings
		lineageTag: 4ad53c83-aca5-4b43-a927-7259f3a95714

	/// Resumo Semanal — Baloo 2, SVG calendar, hover, fadeIn
	measure 'HTML Card Semana Resumo' =
			
			VAR _rotasAtu = [Rotas Semana Atual]
			VAR _rotasAnt = [Rotas Semana Anterior]
			VAR _sprAtu = [SPR Ped Semana Atual]
			VAR _sprAnt = [SPR Ped Semana Anterior]
			VAR _dRotas = [Delta Semana Rotas]
			VAR _dSPR = [Delta Semana SPR Ped]
			VAR _corR = IF(_dRotas >= 0, "#4CAF50", "#E74C3C")
			VAR _corS = IF(_dSPR >= 0, "#4CAF50", "#E74C3C")
			VAR _svgUp = "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='"
			VAR _svgDn = "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='"
			VAR _svgEnd = "'/></svg>"
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>" &
			"<span>Resumo Semanal</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600;margin-bottom:6px'>ROTAS</div>" &
			"<div style='display:flex;justify-content:center;gap:14px;align-items:baseline'>" &
			"<div><div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_rotasAtu, "#,##0") & "</div><div style='font-size:12px;color:#A3A8B2'>Atual</div></div>" &
			"<div style='display:flex;align-items:center;gap:3px'>" & IF(_dRotas >= 0, _svgUp & _corR & _svgEnd, _svgDn & _corR & _svgEnd) & "<span style='font-size:14px;font-weight:700;color:" & _corR & "'>" & FORMAT(_dRotas, "+#,##0;-#,##0;0") & "</span></div>" &
			"<div><div style='font-size:14px;font-weight:600;color:#6A7282'>" & FORMAT(_rotasAnt, "#,##0") & "</div><div style='font-size:12px;color:#A3A8B2'>Anterior</div></div></div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600;margin-bottom:6px'>SPR PEDIDOS</div>" &
			"<div style='display:flex;justify-content:center;gap:14px;align-items:baseline'>" &
			"<div><div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_sprAtu, "0.0") & "</div><div style='font-size:12px;color:#A3A8B2'>Atual</div></div>" &
			"<div style='display:flex;align-items:center;gap:3px'>" & IF(_dSPR >= 0, _svgUp & _corS & _svgEnd, _svgDn & _corS & _svgEnd) & "<span style='font-size:14px;font-weight:700;color:" & _corS & "'>" & FORMAT(_dSPR, "+0.0;-0.0;0") & "</span></div>" &
			"<div><div style='font-size:14px;font-weight:600;color:#6A7282'>" & FORMAT(_sprAnt, "0.0") & "</div><div style='font-size:12px;color:#A3A8B2'>Anterior</div></div></div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 45f5051c-c222-4c65-abee-b6de2e4945bb

	/// Comparativo WoW — Baloo 2, SVG activity, SVG arrows, hover
	measure 'HTML Card Comparativo Semanal' =
			
			VAR _wRotas = [Var WoW Rotas]
			VAR _wPed = [Var WoW Pedidos]
			VAR _wSPR = [Var WoW SPR Pedidos (%)]
			VAR _wEnt = [Var WoW % Entregas]
			VAR _wORH = [Var WoW ORH Tempo (%)]
			VAR _svgUp = "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='"
			VAR _svgDn = "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='"
			VAR _svgEnd = "'/></svg> "
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg>" &
			"<span>Comparativo WoW</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:8px'>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Rotas</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_wRotas >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_wRotas >= 0, _svgUp & IF(_wRotas >= 0, "#4CAF50", "#E74C3C") & _svgEnd, _svgDn & IF(_wRotas >= 0, "#4CAF50", "#E74C3C") & _svgEnd) & FORMAT(_wRotas, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Pedidos</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_wPed >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_wPed >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_wPed, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>SPR</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_wSPR >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_wSPR >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_wSPR, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Entregas</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_wEnt >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_wEnt >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_wEnt, "+0.0%;-0.0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>ORH</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(ABS(_wORH) <= 0.05, "#4CAF50", IF(_wORH > 0, "#E74C3C", "#F5A623")) & "'>" & IF(_wORH >= 0, _svgUp & IF(ABS(_wORH) <= 0.05, "#4CAF50", "#E74C3C") & _svgEnd, _svgDn & "#F5A623" & _svgEnd) & FORMAT(_wORH, "+0.0%;-0.0%;0%") & "</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 99508d42-60c1-4908-82e0-98878f15f7aa

	/// Aderência 5 Eixos — Baloo 2, SVG crosshair, gradient bars, hover
	measure 'HTML Card Aderencia Radar' =
			
			VAR _aPed = [Aderencia Pedidos (%)]
			VAR _aVol = [Aderencia Volumes (%)]
			VAR _aPeso = [Aderencia Peso (%)]
			VAR _aKM = [Aderencia KM (%)]
			VAR _aTempo = [Aderencia Tempo (%)]
			VAR _corPed = IF(ABS(_aPed - 1) < 0.10, "#4CAF50", IF(ABS(_aPed - 1) < 0.20, "#F5A623", "#E74C3C"))
			VAR _corVol = IF(ABS(_aVol - 1) < 0.10, "#4CAF50", IF(ABS(_aVol - 1) < 0.20, "#F5A623", "#E74C3C"))
			VAR _corPeso = IF(ABS(_aPeso - 1) < 0.10, "#4CAF50", IF(ABS(_aPeso - 1) < 0.20, "#F5A623", "#E74C3C"))
			VAR _corKM = IF(ABS(_aKM - 1) < 0.10, "#4CAF50", IF(ABS(_aKM - 1) < 0.20, "#F5A623", "#E74C3C"))
			VAR _corTempo = IF(ABS(_aTempo - 1) < 0.10, "#4CAF50", IF(ABS(_aTempo - 1) < 0.20, "#F5A623", "#E74C3C"))
			VAR _wPed = INT(MIN(_aPed, 1.3) / 1.3 * 100)
			VAR _wVol = INT(MIN(_aVol, 1.3) / 1.3 * 100)
			VAR _wPeso = INT(MIN(_aPeso, 1.3) / 1.3 * 100)
			VAR _wKM = INT(MIN(_aKM, 1.3) / 1.3 * 100)
			VAR _wTempo = INT(MIN(_aTempo, 1.3) / 1.3 * 100)
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes growBar{from{width:0}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><line x1='22' y1='12' x2='18' y2='12'/><line x1='6' y1='12' x2='2' y2='12'/><line x1='12' y1='6' x2='12' y2='2'/><line x1='12' y1='22' x2='12' y2='18'/></svg>" &
			"<span>Aderência 5 Eixos (Real / Planejado)</span></div>" &
			"<div style='display:grid;gap:8px'>" &
			"<div style='display:flex;align-items:center;gap:8px'><span style='font-size:13px;color:#6A7282;width:50px;text-align:right;font-weight:500'>Pedidos</span><div style='flex:1;background:#E5E7EB;border-radius:6px;height:18px;position:relative'><div style='background:linear-gradient(90deg," & _corPed & "," & _corPed & "cc);width:" & _wPed & "%;height:18px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;animation:growBar .8s ease-out'><span style='font-size:13px;color:#fff;font-weight:700'>" & FORMAT(_aPed, "0%") & "</span></div><div style='position:absolute;left:76.9%;top:0;width:1px;height:18px;background:#441A80;opacity:.5'></div></div></div>" &
			"<div style='display:flex;align-items:center;gap:8px'><span style='font-size:13px;color:#6A7282;width:50px;text-align:right;font-weight:500'>Volumes</span><div style='flex:1;background:#E5E7EB;border-radius:6px;height:18px'><div style='background:linear-gradient(90deg," & _corVol & "," & _corVol & "cc);width:" & _wVol & "%;height:18px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;animation:growBar .8s ease-out'><span style='font-size:13px;color:#fff;font-weight:700'>" & FORMAT(_aVol, "0%") & "</span></div></div></div>" &
			"<div style='display:flex;align-items:center;gap:8px'><span style='font-size:13px;color:#6A7282;width:50px;text-align:right;font-weight:500'>Peso</span><div style='flex:1;background:#E5E7EB;border-radius:6px;height:18px'><div style='background:linear-gradient(90deg," & _corPeso & "," & _corPeso & "cc);width:" & _wPeso & "%;height:18px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;animation:growBar .8s ease-out'><span style='font-size:13px;color:#fff;font-weight:700'>" & FORMAT(_aPeso, "0%") & "</span></div></div></div>" &
			"<div style='display:flex;align-items:center;gap:8px'><span style='font-size:13px;color:#6A7282;width:50px;text-align:right;font-weight:500'>KM</span><div style='flex:1;background:#E5E7EB;border-radius:6px;height:18px'><div style='background:linear-gradient(90deg," & _corKM & "," & _corKM & "cc);width:" & _wKM & "%;height:18px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;animation:growBar .8s ease-out'><span style='font-size:13px;color:#fff;font-weight:700'>" & FORMAT(_aKM, "0%") & "</span></div></div></div>" &
			"<div style='display:flex;align-items:center;gap:8px'><span style='font-size:13px;color:#6A7282;width:50px;text-align:right;font-weight:500'>Tempo</span><div style='flex:1;background:#E5E7EB;border-radius:6px;height:18px'><div style='background:linear-gradient(90deg," & _corTempo & "," & _corTempo & "cc);width:" & _wTempo & "%;height:18px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;animation:growBar .8s ease-out'><span style='font-size:13px;color:#fff;font-weight:700'>" & FORMAT(_aTempo, "0%") & "</span></div></div></div></div>" &
			"<div style='font-size:12px;color:#A3A8B2;margin-top:8px;text-align:center'>Linha vertical = 100% (aderência perfeita)</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: ac362889-d380-466e-8ce5-8843cf5a470b

	/// Filial Spotlight — Baloo 2, SVG map-pin, hover, gradient header
	measure 'HTML Card Filial Spotlight' =
			
			VAR _filial = SELECTEDVALUE(dim_filial[Filial], "Todas")
			VAR _nome = SELECTEDVALUE(dim_filial[NomeResumido], _filial)
			VAR _tipo = SELECTEDVALUE(dim_filial[Tipo], "–")
			VAR _regiao = SELECTEDVALUE(dim_filial[Regiao], "–")
			VAR _metaSPR = [Meta SPR Pedidos]
			VAR _metaEnt = [Meta Filial Entrega]
			VAR _rotas = [Total Rotas]
			VAR _spr = [SPR Ped Realizado]
			VAR _ent = [% Entregas Efetivas]
			VAR _orh = [Tempo Medio Realizado (h)]
			VAR _corSPR = IF(_spr >= _metaSPR, "#4CAF50", IF(_spr >= _metaSPR * 0.9, "#F5A623", "#E74C3C"))
			VAR _corEnt = IF(_ent >= _metaEnt, "#4CAF50", IF(_ent >= _metaEnt - 0.03, "#F5A623", "#E74C3C"))
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.25)}</style>" &
			"<div class='card' style='color:#fff;background:linear-gradient(135deg,#5B2D8C 0%,#7B44C2 55%,#A06CD5 100%);'>" &
			"<div style='display:flex;justify-content:space-between;align-items:flex-start'>" &
			"<div>" &
			"<div style='display:flex;align-items:center;gap:6px'>" &
			"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z'/><circle cx='12' cy='10' r='3'/></svg>" &
			"<span style='font-size:20px;font-weight:800'>" & _nome & "</span></div>" &
			"<div style='font-size:12px;opacity:0.8;margin-top:2px'>" & _filial & " • " & _tipo & " • " & _regiao & "</div></div>" &
			"<div style='background:rgba(255,255,255,0.2);border-radius:10px;padding:5px 12px;font-size:13px;font-weight:700'>" & FORMAT(_rotas, "#,##0") & " rotas</div></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:16px'>" &
			"<div style='background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;text-align:center'>" &
			"<div style='font-size:12px;text-transform:uppercase;opacity:0.7;letter-spacing:.5px;font-weight:600'>SPR Ped</div>" &
			"<div style='font-size:24px;font-weight:800;margin:2px 0'>" & FORMAT(_spr, "0.0") & "</div>" &
			"<div style='font-size:13px;padding:3px 8px;background:" & _corSPR & ";border-radius:8px;display:inline-block;font-weight:600'>Meta: " & FORMAT(_metaSPR, "0.0") & "</div></div>" &
			"<div style='background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;text-align:center'>" &
			"<div style='font-size:12px;text-transform:uppercase;opacity:0.7;letter-spacing:.5px;font-weight:600'>Entregas</div>" &
			"<div style='font-size:24px;font-weight:800;margin:2px 0'>" & FORMAT(_ent, "0.0%") & "</div>" &
			"<div style='font-size:13px;padding:3px 8px;background:" & _corEnt & ";border-radius:8px;display:inline-block;font-weight:600'>Meta: " & FORMAT(_metaEnt, "0.0%") & "</div></div>" &
			"<div style='background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;text-align:center'>" &
			"<div style='font-size:12px;text-transform:uppercase;opacity:0.7;letter-spacing:.5px;font-weight:600'>ORH Tempo</div>" &
			"<div style='font-size:24px;font-weight:800;margin:2px 0'>" & FORMAT(_orh, "0.0") & "h</div>" &
			"<div style='font-size:13px;opacity:0.7;font-weight:500'>Jornada: 8h</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: d3071950-4260-4e91-9ef0-dd6e7832c858

	/// Status Frota — Baloo 2, SVG truck, hover, fadeIn
	measure 'HTML Card Status Frota' =
			
			VAR _veiculos = [Veiculos Ativos]
			VAR _rpvd = [Rotas por Veiculo Dia]
			VAR _acima = [Rotas Acima Cap Pedidos]
			VAR _pctAcima = [% Rotas Acima Cap]
			VAR _status = [Status Capacidade]
			VAR _statusTxt = [Status Capacidade Texto]
			VAR _cor = [Status Capacidade Cor]
			VAR _acao = [Acao Capacidade]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/></svg>" &
			"<span>Status da Frota</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;text-align:center;margin-bottom:12px'>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_veiculos, "#,##0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Veículos Ativos</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_rpvd, "0.0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Rotas/Veíc/Dia</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:24px;font-weight:800;color:" & _cor & "'>" & FORMAT(_pctAcima, "0%") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Acima Cap (" & FORMAT(_acima, "#,##0") & ")</div></div></div>" &
			"<div style='text-align:center'>" &
			"<span style='font-size:12px;padding:5px 14px;background:" & _cor & "22;color:" & _cor & ";border-radius:10px;font-weight:600'>" & _statusTxt & "</span>" &
			"<div style='font-size:12px;color:#6A7282;font-weight:600;margin-top:10px'>" & _acao & "</div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 6e41a20b-19ab-4c52-be00-becf2df857c3

	/// SPR Plan vs Real — Baloo 2, SVG git-compare, SVG arrows, hover
	measure 'HTML Card SPR Plan vs Real' =
			
			VAR _sprR = [SPR Ped Realizado]
			VAR _sprP = [SPR Ped Planejado]
			VAR _sprVR = [SPR Vol Realizado]
			VAR _sprVP = [SPR Vol Planejado]
			VAR _dPed = [Desvio SPR Ped Plan vs Real (pts)]
			VAR _dVol = [Desvio SPR Vol Plan vs Real (pts)]
			VAR _corPed = IF(_dPed >= 0, "#4CAF50", "#E74C3C")
			VAR _corVol = IF(_dVol >= 0, "#4CAF50", "#E74C3C")
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>" &
			"<span>SPR — Planejado vs Realizado</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:14px'>" &
			"<div style='font-size:13px;color:#A3A8B2;text-transform:uppercase;margin-bottom:8px;font-weight:600'>PEDIDOS / ROTA</div>" &
			"<div style='display:flex;justify-content:space-between;align-items:baseline'>" &
			"<div><div style='font-size:13px;color:#6A7282;font-weight:500'>Plan</div><div style='font-size:18px;font-weight:600;color:#6A7282'>" & FORMAT(_sprP, "0.0") & "</div></div>" &
			"<div style='display:flex;align-items:center;gap:3px'>" & IF(_dPed >= 0, "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='" & _corPed & "'/></svg>", "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='" & _corPed & "'/></svg>") & "<span style='font-size:16px;font-weight:800;color:" & _corPed & "'>" & FORMAT(_dPed, "+0.0;-0.0;0") & "</span></div>" &
			"<div><div style='font-size:13px;color:#441A80;font-weight:600'>Real</div><div style='font-size:18px;font-weight:800;color:#441A80'>" & FORMAT(_sprR, "0.0") & "</div></div></div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:14px'>" &
			"<div style='font-size:13px;color:#A3A8B2;text-transform:uppercase;margin-bottom:8px;font-weight:600'>VOLUMES / ROTA</div>" &
			"<div style='display:flex;justify-content:space-between;align-items:baseline'>" &
			"<div><div style='font-size:13px;color:#6A7282;font-weight:500'>Plan</div><div style='font-size:18px;font-weight:600;color:#6A7282'>" & FORMAT(_sprVP, "0.0") & "</div></div>" &
			"<div style='display:flex;align-items:center;gap:3px'>" & IF(_dVol >= 0, "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='" & _corVol & "'/></svg>", "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='" & _corVol & "'/></svg>") & "<span style='font-size:16px;font-weight:800;color:" & _corVol & "'>" & FORMAT(_dVol, "+0.0;-0.0;0") & "</span></div>" &
			"<div><div style='font-size:13px;color:#441A80;font-weight:600'>Real</div><div style='font-size:18px;font-weight:800;color:#441A80'>" & FORMAT(_sprVR, "0.0") & "</div></div></div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 75863168-39c1-49bd-8121-f33fd0952492

	/// YTD Resumo — Baloo 2, SVG trending-up, hover, fadeIn
	measure 'HTML Card YTD Resumo' =
			
			VAR _rYTD = [Rotas YTD]
			VAR _pYTD = [Pedidos YTD]
			VAR _vYTD = [Volumes YTD]
			VAR _sprYTD = [SPR Ped YTD]
			VAR _entYTD = [% Entregas YTD]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg>" &
			"<span>Acumulado no Ano (YTD)</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:8px;text-align:center'>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:17px;font-weight:800;color:#441A80'>" & FORMAT(_rYTD, "#,##0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Rotas</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:17px;font-weight:800;color:#441A80'>" & FORMAT(_pYTD, "#,##0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Pedidos</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:17px;font-weight:800;color:#441A80'>" & FORMAT(_vYTD, "#,##0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>Volumes</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:17px;font-weight:800;color:#441A80'>" & FORMAT(_sprYTD, "0.0") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>SPR YTD</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:12px'>" &
			"<div style='font-size:17px;font-weight:800;color:#441A80'>" & FORMAT(_entYTD, "0.0%") & "</div>" &
			"<div style='font-size:12px;color:#A3A8B2;font-weight:500'>% Ent YTD</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: ba2a2e2d-a562-40ec-b5dc-b83a55173ac0

	/// MoM Resumo — Baloo 2, SVG bar-chart-2, SVG arrows, hover
	measure 'HTML Card MoM Resumo' =
			
			VAR _mRotas = [Var MoM Rotas (%)]
			VAR _mPed = [Var MoM Pedidos (%)]
			VAR _mSPR = [Var MoM SPR Pedidos (%)]
			VAR _mEnt = [Var MoM % Entregas (pp)]
			VAR _mORH = [Var MoM ORH Tempo (%)]
			VAR _svgUp = "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 1L9 7H1Z' fill='"
			VAR _svgDn = "<svg width='8' height='8' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='"
			VAR _svgEnd = "'/></svg> "
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>" &
			"<span>Variação Mensal (MoM)</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:8px'>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Rotas</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_mRotas >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_mRotas >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_mRotas, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Pedidos</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_mPed >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_mPed >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_mPed, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>SPR</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_mSPR >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_mSPR >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_mSPR, "+0.0%;-0.0%;0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>Entregas</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(_mEnt >= 0, "#4CAF50", "#E74C3C") & "'>" & IF(_mEnt >= 0, _svgUp & "#4CAF50" & _svgEnd, _svgDn & "#E74C3C" & _svgEnd) & FORMAT(_mEnt, "+0.0%;-0.0%") & "</div></div>" &
			"<div style='text-align:center;padding:10px;background:#F9FAFB;border-radius:10px'>" &
			"<div style='font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:600'>ORH</div>" &
			"<div style='display:flex;align-items:center;justify-content:center;gap:2px;font-size:17px;font-weight:800;color:" & IF(ABS(_mORH) <= 0.05, "#4CAF50", "#E74C3C") & "'>" & IF(_mORH >= 0, _svgUp & IF(ABS(_mORH) <= 0.05, "#4CAF50", "#E74C3C") & _svgEnd, _svgDn & IF(ABS(_mORH) <= 0.05, "#4CAF50", "#E74C3C") & _svgEnd) & FORMAT(_mORH, "+0.0%;-0.0%;0%") & "</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 028de82b-8058-4b2e-9a08-18c05e1a09b4

	/// Performance Geral Score — Baloo 2, SVG trophy, SVG check/x, hover
	measure 'HTML Card Performance Geral' =
			
			VAR _spr = [SPR Ped Realizado]
			VAR _metaSPR = [Meta Global SPR Ped]
			VAR _ent = [% Entregas Efetivas]
			VAR _metaEnt = [Meta Global % Entregas]
			VAR _util = [Utilizacao Jornada 8h (%)]
			VAR _cob = [Cobertura Rotas (%)]
			VAR _statusSPR = IF(_spr >= _metaSPR, "ok", IF(_spr >= _metaSPR * 0.95, "atencao", "critico"))
			VAR _statusEnt = IF(_ent >= _metaEnt, "ok", IF(_ent >= _metaEnt * 0.95, "atencao", "critico"))
			VAR _iconGrafico = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg>"
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}.mini-metric{text-align:center}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700;margin-bottom:4px}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>"
			RETURN
			_css &
			"<div class='card'>" &
			"<div class='card-title'>" & _iconGrafico & "<span>PERFORMANCE GERAL</span></div>" &
			"<div class='grid-3'>" &
			"<div class='mini-metric'>" &
			"<div class='mini-metric-label'>SPR Ped</div>" &
			"<div class='mini-metric-value' style='color:" & SWITCH(_statusSPR, "ok", "#4CAF50", "atencao", "#F5A623", "#E74C3C") & "'>" & FORMAT(_spr, "0.0") & "</div>" &
			"</div>" &
			"<div class='mini-metric'>" &
			"<div class='mini-metric-label'>Entregas</div>" &
			"<div class='mini-metric-value' style='color:" & SWITCH(_statusEnt, "ok", "#4CAF50", "atencao", "#F5A623", "#E74C3C") & "'>" & FORMAT(_ent, "0.0%") & "</div>" &
			"</div>" &
			"<div class='mini-metric'>" &
			"<div class='mini-metric-label'>Utilização</div>" &
			"<div class='mini-metric-value'>" & FORMAT(_util, "0.0%") & "</div>" &
			"</div>" &
			"</div>" &
			"<div style='font-size:13px;color:#6A7282;text-align:center'>Cobertura: " & FORMAT(_cob, "0.0%") & " | Meta SPR: " & FORMAT(_metaSPR, "0.0") & " | Meta Ent: " & FORMAT(_metaEnt, "0.0%") & "</div>" &
			"</div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 879bb2ff-17dc-4a69-a2ff-e7f26a2083f4

	/// Alerta Filiais — Baloo 2, SVG alert-triangle, hover
	measure 'HTML Card Alerta Filiais' =
			
			VAR _top3SPR = [Top 3 Piores Filiais SPR]
			VAR _top3Ent = [Top 3 Piores Filiais Entregas]
			VAR _qtdSPR = [Qtd Filiais Abaixo Meta SPR]
			VAR _qtdEnt = [Qtd Filiais Abaixo Meta Entrega]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#F5A623' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>" &
			"<span>Filiais em Atenção</span></div>" &
			"<div style='margin-bottom:14px'>" &
			"<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:6px'>" &
			"<span style='font-size:13px;font-weight:700;color:#E74C3C'>SPR Abaixo da Meta</span>" &
			"<span style='font-size:13px;padding:3px 8px;background:#E74C3C15;color:#E74C3C;border-radius:10px;font-weight:700'>" & FORMAT(_qtdSPR, "#") & " filiais</span></div>" &
			"<div style='font-size:12px;color:#333;background:#FEF2F2;padding:10px 12px;border-radius:8px;line-height:1.6;font-weight:500'>" & _top3SPR & "</div></div>" &
			"<div>" &
			"<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:6px'>" &
			"<span style='font-size:13px;font-weight:700;color:#F5A623'>Entregas Abaixo da Meta</span>" &
			"<span style='font-size:13px;padding:3px 8px;background:#F5A62315;color:#F5A623;border-radius:10px;font-weight:700'>" & FORMAT(_qtdEnt, "#") & " filiais</span></div>" &
			"<div style='font-size:12px;color:#333;background:#FFFBEB;padding:10px 12px;border-radius:8px;line-height:1.6;font-weight:500'>" & _top3Ent & "</div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 3d9d73d3-89d4-41f6-b88b-99149e12d8f4

	/// Progresso vs Metas — Baloo 2, SVG target, gradient bars, hover
	measure 'HTML Card Progresso Metas' =
			
			VAR _sprVal = [SPR Ped Realizado]
			VAR _sprMeta = [Meta Global SPR Ped]
			VAR _sprPct = MIN(DIVIDE(_sprVal, _sprMeta, 0), 1.3)
			VAR _entVal = [% Entregas Efetivas]
			VAR _entMeta = [Meta Global % Entregas]
			VAR _entPct = MIN(DIVIDE(_entVal, _entMeta, 0), 1.3)
			VAR _orhVal = [Tempo Medio Realizado (h)]
			VAR _orhMeta = [Meta ORH Tempo (h)]
			VAR _orhPct = MIN(DIVIDE(_orhVal, _orhMeta, 0), 1.3)
			VAR _corSPR = IF(_sprPct >= 1, "#4CAF50", IF(_sprPct >= 0.9, "#F5A623", "#E74C3C"))
			VAR _corEnt = IF(_entPct >= 1, "#4CAF50", IF(_entPct >= 0.97, "#F5A623", "#E74C3C"))
			VAR _corORH = IF(_orhPct >= 0.85 && _orhPct <= 1.15, "#4CAF50", "#F5A623")
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes growBar{from{width:0}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg>" &
			"<span>Progresso vs Metas</span></div>" &
			"<div style='display:grid;gap:12px'>" &
			"<div><div style='display:flex;justify-content:space-between;font-size:13px;color:#6A7282;margin-bottom:4px;font-weight:500'><span>SPR Pedidos</span><span style='font-weight:700'>" & FORMAT(_sprVal, "0.0") & " / " & FORMAT(_sprMeta, "0.0") & "</span></div><div style='background:#E5E7EB;border-radius:6px;height:12px;overflow:hidden'><div style='background:linear-gradient(90deg," & _corSPR & "," & _corSPR & "cc);width:" & FORMAT(MIN(_sprPct, 1) * 100, "0") & "%;height:12px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:5px;animation:growBar .8s ease-out'><span style='font-size:7px;color:#fff;font-weight:700'>" & FORMAT(_sprPct, "0%") & "</span></div></div></div>" &
			"<div><div style='display:flex;justify-content:space-between;font-size:13px;color:#6A7282;margin-bottom:4px;font-weight:500'><span>% Entregas</span><span style='font-weight:700'>" & FORMAT(_entVal, "0.0%") & " / " & FORMAT(_entMeta, "0.0%") & "</span></div><div style='background:#E5E7EB;border-radius:6px;height:12px;overflow:hidden'><div style='background:linear-gradient(90deg," & _corEnt & "," & _corEnt & "cc);width:" & FORMAT(MIN(_entPct, 1) * 100, "0") & "%;height:12px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:5px;animation:growBar .8s ease-out'><span style='font-size:7px;color:#fff;font-weight:700'>" & FORMAT(_entPct, "0%") & "</span></div></div></div>" &
			"<div><div style='display:flex;justify-content:space-between;font-size:13px;color:#6A7282;margin-bottom:4px;font-weight:500'><span>ORH Tempo</span><span style='font-weight:700'>" & FORMAT(_orhVal, "0.0") & "h / " & FORMAT(_orhMeta, "0.0") & "h</span></div><div style='background:#E5E7EB;border-radius:6px;height:12px;overflow:hidden'><div style='background:linear-gradient(90deg," & _corORH & "," & _corORH & "cc);width:" & FORMAT(MIN(_orhPct, 1) * 100, "0") & "%;height:12px;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:5px;animation:growBar .8s ease-out'><span style='font-size:7px;color:#fff;font-weight:700'>" & FORMAT(_orhPct, "0%") & "</span></div></div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: da3d2168-e5a6-470a-aa69-cd102c5a9bc0

	/// Card SPR Peso kg/rota com comparativo plan vs real
	measure 'HTML Card SPR Peso' =
			
			VAR _val = [SPR Peso Realizado (kg/rota)]
			VAR _plan = [SPR Peso Planejado (kg/rota)]
			VAR _delta = _val - _plan
			VAR _cor = IF(ABS(_delta) / _plan <= 0.10, "#4CAF50", IF(ABS(_delta) / _plan <= 0.20, "#F5A623", "#E74C3C"))
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style><div class='card' style='position:relative;overflow:hidden;'>  <div style='position:absolute;top:0;left:0;width:4px;height:100%;background:" & _cor & "'></div>  <div style='margin-left:8px'>    <div style='font-size:12px;font-weight:600;color:#5B2D8C;text-transform:uppercase;letter-spacing:1.2px;display:flex;align-items:center;gap:6px'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='16.5' y1='9.4' x2='7.5' y2='4.21'/><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'/><polyline points='3.27 6.96 12 12.01 20.73 6.96'/><line x1='12' y1='22.08' x2='12' y2='12'/></svg> SPR Peso (kg/rota)</div>    <div style='margin:8px 0 4px'>      <span style='font-size:28px;font-weight:700;color:#441A80'>" & FORMAT(_val, "0.0") & "</span>      <span style='font-size:12px;color:" & _cor & ";margin-left:6px;display:inline-flex;align-items:center;gap:3px'><svg width='10' height='10' viewBox='0 0 10 10'>" & IF(_delta > 0, "<polygon points='5,1 9,7 1,7' fill='" & _cor & "'/>", IF(_delta < 0, "<polygon points='5,9 1,3 9,3' fill='" & _cor & "'/>", "<circle cx='5' cy='5' r='3' fill='" & _cor & "'/>")) & "</svg>" & FORMAT(_delta, "+0.0;-0.0;0") & " vs plan</span>    </div>    <div style='font-size:13px;color:#A3A8B2'>Planejado: " & FORMAT(_plan, "0.0") & " kg/rota</div>  </div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 9ef190a3-8efb-4fe8-9902-94cf5851e3d2

	/// Card SPR KM km/rota com comparativo plan vs real
	measure 'HTML Card SPR KM' =
			
			VAR _val = [SPR KM Realizado (km/rota)]
			VAR _plan = [SPR KM Planejado (km/rota)]
			VAR _delta = _val - _plan
			VAR _cor = IF(ABS(_delta) / _plan <= 0.10, "#4CAF50", IF(ABS(_delta) / _plan <= 0.20, "#F5A623", "#E74C3C"))
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style><div class='card' style='position:relative;overflow:hidden;'>  <div style='position:absolute;top:0;left:0;width:4px;height:100%;background:" & _cor & "'></div>  <div style='margin-left:8px'>    <div style='font-size:12px;font-weight:600;color:#5B2D8C;text-transform:uppercase;letter-spacing:1.2px;display:flex;align-items:center;gap:6px'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='3 11 22 2 13 21 11 13 3 11'/></svg> SPR KM (km/rota)</div>    <div style='margin:8px 0 4px'>      <span style='font-size:28px;font-weight:700;color:#441A80'>" & FORMAT(_val, "0.0") & "</span>      <span style='font-size:12px;color:" & _cor & ";margin-left:6px;display:inline-flex;align-items:center;gap:3px'><svg width='10' height='10' viewBox='0 0 10 10'>" & IF(_delta > 0, "<polygon points='5,1 9,7 1,7' fill='" & _cor & "'/>", IF(_delta < 0, "<polygon points='5,9 1,3 9,3' fill='" & _cor & "'/>", "<circle cx='5' cy='5' r='3' fill='" & _cor & "'/>")) & "</svg>" & FORMAT(_delta, "+0.0;-0.0;0") & " vs plan</span>    </div>    <div style='font-size:13px;color:#A3A8B2'>Planejado: " & FORMAT(_plan, "0.0") & " km/rota</div>  </div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 2a75963c-11d3-4532-a80d-282c151ee55d

	/// Card Ocupacao Frota com SVG circle gauges pedidos e volumes
	measure 'HTML Card Ocupacao Frota' =
			VAR _occComp = [Ocupacao Composta (%)]
			VAR _occPed = [Ocupacao Pedidos (%)]
			VAR _occVol = [Ocupacao Volumes (%)]
			VAR _rotasCapPed = [Rotas Acima Cap Pedidos]
			VAR _rotasCapVol = [Rotas Acima Cap Volumes]
			VAR _pctPed = [% Rotas Acima Cap]
			VAR _pctVol = [% Rotas Acima Cap Volumes]
			VAR _tipoCritico = [Tipo Veiculo Critico Ocupacao]
			VAR _status = [Status Capacidade]
			VAR _statusTxt = SWITCH(TRUE(), _status = 1, "Subocupado", _status = 2, "Balanceado", _status = 3, "Saturado", _status = 4, "Critico", "Sem dados")
			VAR _cor = SWITCH(TRUE(), _status = 1, "#4CAF50", _status = 2, "#4CAF50", _status = 3, "#F5A623", _status = 4, "#E74C3C", "#A3A8B2")
			VAR _css = "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.10)}.title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px;margin-bottom:12px}.value{font-size:38px;font-weight:800;color:#441A80;line-height:1}.subtitle{font-size:12px;color:#6A7282;font-weight:600}.status{display:inline-flex;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.box{background:#F9FAFB;border-radius:10px;padding:10px}.box-label{font-size:11px;color:#6A7282;font-weight:700;text-transform:uppercase}.box-val{font-size:18px;font-weight:800;color:#441A80}.bar{height:10px;background:#E5E7EB;border-radius:999px;overflow:hidden;margin-top:6px}.bar-fill{height:100%;border-radius:999px}.meta{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:12px}.meta-item{background:#F9FAFB;border-radius:10px;padding:10px;text-align:center}.meta-k{font-size:11px;color:#6A7282;font-weight:700;text-transform:uppercase}.meta-v{font-size:14px;font-weight:800;color:#441A80}</style>"
			RETURN
			    _css &
			    "<div class='card'><div class='title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/></svg><span>Ocupacao da Frota</span></div>" &
			    "<div style='display:flex;justify-content:space-between;align-items:flex-end'><div><div class='value'>" & FORMAT(_occComp, "0.0%") & "</div><div class='subtitle'>Ocupacao composta (pedidos + volumes)</div></div><span class='status' style='background:" & _cor & "22;color:" & _cor & "'>" & _statusTxt & "</span></div>" &
			    "<div class='row'><div class='box'><div class='box-label'>Pedidos</div><div class='box-val'>" & FORMAT(_occPed, "0.0%") & "</div><div class='bar'><div class='bar-fill' style='width:" & FORMAT(MIN(_occPed,1),"0%") & ";background:#5B2D8C'></div></div></div><div class='box'><div class='box-label'>Volumes</div><div class='box-val'>" & FORMAT(_occVol, "0.0%") & "</div><div class='bar'><div class='bar-fill' style='width:" & FORMAT(MIN(_occVol,1),"0%") & ";background:#7B44C2'></div></div></div></div>" &
			    "<div class='meta'><div class='meta-item'><div class='meta-k'>Acima Cap Ped</div><div class='meta-v'>" & FORMAT(_rotasCapPed, "#,##0") & " (" & FORMAT(_pctPed, "0.0%") & ")</div></div><div class='meta-item'><div class='meta-k'>Acima Cap Vol</div><div class='meta-v'>" & FORMAT(_rotasCapVol, "#,##0") & " (" & FORMAT(_pctVol, "0.0%") & ")</div></div><div class='meta-item'><div class='meta-k'>Tipo Critico</div><div class='meta-v'>" & COALESCE(_tipoCritico, "-") & "</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 99d44215-e51f-4b2b-9adc-cc1b0c5e956d

	/// Hero KPI Desvio SPR — Baloo 2, SVG activity zigzag, animações
	measure 'HTML Card Desvio SPR' =
			
			VAR _val = [KPI Desvio SPR Valor]
			VAR _meta = [KPI Desvio SPR Meta]
			VAR _status = [KPI Desvio SPR Status]
			VAR _cor = SWITCH(_status, "ok", "#4CAF50", "atencao", "#F5A623", "critico", "#E74C3C", "#A3A8B2")
			VAR _statusSvg = SWITCH(_status, "ok", "<svg width='10' height='10' viewBox='0 0 10 10'><circle cx='5' cy='5' r='3.5' fill='" & _cor & "'/></svg>", "atencao", "<svg width='10' height='10' viewBox='0 0 10 10'><rect x='1' y='4' width='8' height='2.5' rx='1' fill='" & _cor & "'/></svg>", "critico", "<svg width='10' height='10' viewBox='0 0 10 10'><path d='M5 9L1 3H9Z' fill='" & _cor & "'/></svg>", "")
			VAR _bgCard = SWITCH(_status, "critico", "#FEF2F2", "atencao", "#FFFBEB", "#F0FFF4")
			VAR _anim = IF(_status = "critico", "animation:pulse 2s infinite,fadeIn .5s ease-out;", "animation:fadeIn .5s ease-out;")
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card' style='" & _anim & "position:relative;overflow:hidden;'>" &
			"<div style='position:absolute;top:0;left:0;width:4px;height:100%;background:" & _cor & "'></div>" &
			"<div style='margin-left:10px'>" &
			"<div style='display:flex;justify-content:space-between;align-items:center'>" &
			"<div style='display:flex;align-items:center;gap:6px'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg>" &
			"<span style='font-size:13px;font-weight:700;color:#6A7282;text-transform:uppercase;letter-spacing:1px'>Desvio SPR Plan×Real</span>" &
			"</div>" &
			"<span style='font-size:13px;padding:3px 10px;background:" & _cor & "18;color:" & _cor & ";border-radius:12px;font-weight:700;display:inline-flex;align-items:center;gap:4px'>" & _statusSvg & " " & UPPER(_status) & "</span>" &
			"</div>" &
			"<div style='margin:10px 0 4px'>" &
			"<span style='font-size:38px;font-weight:800;color:" & _cor & ";letter-spacing:-1px'>" & FORMAT(_val, "+0.0;-0.0;0") & "</span>" &
			"<span style='font-size:14px;color:#6A7282;margin-left:6px'>pts</span>" &
			"</div>" &
			"<div style='font-size:12px;color:#A3A8B2;margin-top:4px;font-weight:500'>Limite aceitável: " & FORMAT(_meta, "+0.0;-0.0;0") & " pts</div>" &
			"</div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: 5bd0cf71-be05-4d53-af3b-a219c984d564

	/// Consolidação — Baloo 2, SVG refresh, hover, fadeIn
	measure 'HTML Card Consolidacao' =
			
			VAR _potencial = [Potencial Consolidacao (rotas)]
			VAR _economia = [Economia Potencial (h)]
			VAR _curtas = [% Rotas Curtas (<4h)]
			VAR _hOciosas = [Horas Ociosas Totais]
			RETURN
			"<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.card{font-family:'Baloo 2',sans-serif;line-height:1.35;animation:fadeIn .5s ease-out;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 16px rgba(68,26,128,.08);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(68,26,128,.15)}.card-title{font-size:13px;font-weight:700;color:#5B2D8C;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:6px}.card-value{font-size:28px;font-weight:800;color:#441A80;line-height:1;margin-bottom:6px}.card-subtitle{font-size:12px;font-weight:600;color:#6A7282;margin-bottom:8px}.card-label{font-size:13px;color:#A3A8B2}.meta-row{display:flex;align-items:center;gap:8px;margin-top:8px}.meta-text{font-size:13px;color:#6A7282}.delta-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.delta-positive{background:rgba(76,175,80,.15);color:#4CAF50}.delta-negative{background:rgba(231,76,60,.15);color:#E74C3C}.delta-neutral{background:rgba(106,114,130,.15);color:#6A7282}.grid-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#F9FAFB;border-radius:8px;margin-bottom:6px}.grid-row:last-child{margin-bottom:0}.mini-metric{display:flex;flex-direction:column;gap:4px}.mini-metric-label{font-size:12px;color:#A3A8B2;text-transform:uppercase;font-weight:700}.mini-metric-value{font-size:17px;font-weight:800;color:#441A80}</style>" &
			"<div class='card'>" &
			"<div class='card-title'>" &
			"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 4 23 10 17 10'/><polyline points='1 20 1 14 7 14'/><path d='M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15'/></svg>" &
			"<span>Oportunidade de Consolidação</span></div>" &
			"<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px'>" &
			"<div style='background:#FEF2F2;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:24px;font-weight:800;color:#E74C3C'>" & FORMAT(_curtas, "0%") & "</div>" &
			"<div style='font-size:13px;color:#6A7282;font-weight:500'>Rotas Curtas (<4h)</div></div>" &
			"<div style='background:#F0FFF4;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:24px;font-weight:800;color:#4CAF50'>" & FORMAT(_potencial, "#,##0") & "</div>" &
			"<div style='font-size:13px;color:#6A7282;font-weight:500'>Rotas Consolid.</div></div>" &
			"<div style='background:#FFFBEB;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:24px;font-weight:800;color:#F5A623'>" & FORMAT(_economia, "0.0") & "h</div>" &
			"<div style='font-size:13px;color:#6A7282;font-weight:500'>Economia Potencial</div></div>" &
			"<div style='background:#F9FAFB;border-radius:10px;padding:14px;text-align:center'>" &
			"<div style='font-size:24px;font-weight:800;color:#441A80'>" & FORMAT(_hOciosas, "#,##0") & "h</div>" &
			"<div style='font-size:13px;color:#6A7282;font-weight:500'>Horas Ociosas</div></div></div></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\01. Cards
		lineageTag: fbd7c60d-26ca-46bb-9c57-269d975fc61f

	/// Score SPR normalizado 0-100 baseado em SPR Real vs Meta
	measure 'Score SPR (0-100)' =
			VAR _val = [SPR Ped Realizado]
			VAR _meta = [Meta Global SPR Ped]
			VAR _raw = DIVIDE(_val, _meta, 0) * 100
			RETURN
			IF(ISBLANK(_val), BLANK(), MIN(INT(_raw), 100))
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 8f4f4518-394d-401c-9704-7d8908f972de

	/// Score Entregas normalizado 0-100 baseado em % Entregas vs Meta
	measure 'Score Entrega (0-100)' =
			VAR _val = [% Entregas Efetivas]
			VAR _meta = [Meta Global % Entregas]
			VAR _raw = DIVIDE(_val, _meta, 0) * 100
			RETURN
			IF(ISBLANK(_val), BLANK(), MIN(INT(_raw), 100))
		isHidden
		displayFolder: 98. Suporte\04. Entrega Operacional
		lineageTag: 112964bc-c703-4c5e-ad41-e777f6d0592f

	/// Score Operacional ponderado: SPR 45% + ORH 30% + Capacidade 25%
	measure 'Score Operacional' =
			VAR _scoreSPR = [Score SPR (0-100)]
			VAR _orh = [Utilizacao Jornada 8h (%)]
			VAR _scoreORH = IF(ISBLANK(_orh), BLANK(), IF(_orh >= 0.8 && _orh <= 1.1, 100, IF(_orh >= 0.6 && _orh <= 1.3, 70, 30)))
			VAR _capStatus = [Status Capacidade]
			VAR _scoreCap = SWITCH(TRUE(), ISBLANK(_capStatus), BLANK(), _capStatus = 3, 100, _capStatus = 2, 90, _capStatus = 1, 60, _capStatus = 4, 30, BLANK())
			RETURN
			IF(
			    ISBLANK(_scoreSPR) || ISBLANK(_scoreCap),
			    BLANK(),
			    ROUND(_scoreSPR * 0.45 + _scoreORH * 0.30 + _scoreCap * 0.25, 0)
			)
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 8ac7640c-03ce-45d6-902d-81f3b4a219b7

	/// KM total planejado (soma da coluna KM em fato_planejado)
	measure 'KM Total Planejado' = SUM(fato_planejado[KM Planejado Plan])
		formatString: #,##0.0
		displayFolder: 05. Plano vs Real\04. Contexto de Execucao
		lineageTag: 4a80b51a-e8e0-4f82-a52c-eefd0085a985

	/// Status numerico SPR: 1=acima meta, 0=atencao (ate -10%), -1=critico. Para formatacao condicional em tabelas.
	measure 'Op Status SPR' = [KPI SPR Ped Status Codigo]
		formatString: 0
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: c8b0bb35-6b6b-4e56-853a-8b605086f7ef

	/// Status numerico Entregas: 1=acima meta, 0=atencao (ate -3pp), -1=critico. Para formatacao condicional.
	measure 'Op Status Entregas' = [KPI Entregas Status Codigo]
		formatString: 0
		isHidden
		displayFolder: 98. Suporte\04. Entrega Operacional
		lineageTag: 7eee1c96-4d50-4083-a9e1-499aefce3f80

	/// Status numerico ORH: 1=dentro faixa ideal (85-115% meta), 0=moderado, -1=fora. Para formatacao condicional.
	measure 'Op Status ORH' = [KPI ORH Status Codigo]
		formatString: 0
		displayFolder: 01. Operacao\02. Alertas e Prioridades
		lineageTag: 3170a67d-ca8a-4596-8205-a0ea87acd5bb

	/// Rank SPR por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank SPR Filial' =
			IF(
			    ISBLANK([SPR Ped Realizado]),
			    BLANK(),
			    RANKX(
			        ALLSELECTED(dim_filial[Filial]),
			        CALCULATE([SPR Ped Realizado]),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: ce39be59-5996-4c8c-a528-9e3119045ceb

	/// Rank Entregas por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank Entregas Filial' =
			IF(
			    ISBLANK([% Entregas Efetivas]),
			    BLANK(),
			    RANKX(
			        ALLSELECTED(dim_filial[Filial]),
			        CALCULATE([% Entregas Efetivas]),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		isHidden
		displayFolder: 98. Suporte\04. Entrega Operacional
		lineageTag: a9ad5ad7-5448-4f06-932c-961b2b05c1db

	/// Rank Score Operacional por filial no contexto atual (1=melhor). RANKX dense.
	measure 'Op Rank Score Filial' =
			IF(
			    ISBLANK([Score Operacional]),
			    BLANK(),
			    RANKX(
			        ALLSELECTED(dim_filial[Filial]),
			        CALCULATE([Score Operacional]),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 1f9e589f-80e2-411b-8509-33964a948d83

	/// Dias distintos com dados (rotas) no periodo filtrado
	measure 'Op Dias com Dados' =
			COUNTROWS(
			    FILTER(
			        VALUES(dim_calendario[Data]),
			        CALCULATE(COUNTROWS(fato_rotas)) > 0
			    )
			)
		formatString: 0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 7dbef49c-4ef2-4218-be53-5d45ad138a03

	/// Media diaria de rotas no periodo filtrado
	measure 'Op Media Diaria Rotas' = DIVIDE([Total Rotas], [Op Dias com Dados], BLANK())
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 2f9f4d15-8d7e-406d-af9f-ca3f83ffe46e

	/// Media diaria de pedidos no periodo filtrado
	measure 'Op Media Diaria Pedidos' = DIVIDE([Total Pedidos], [Op Dias com Dados], BLANK())
		formatString: #,##0.0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: 96bc1c99-4630-4d16-a5ab-58b3ca654779

	/// Participacao % da filial no total de rotas (no contexto selecionado)
	measure 'Op Rotas Filial %' =
			DIVIDE(
			    [Total Rotas],
			    CALCULATE([Total Rotas], ALLSELECTED(dim_filial[Filial])),
			    BLANK()
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: 04c53f35-41fb-4ce7-8c4f-2cfd585c5b41

	/// Participacao % da filial no total de pedidos (no contexto selecionado)
	measure 'Op Pedidos Filial %' =
			DIVIDE(
			    [Total Pedidos],
			    CALCULATE([Total Pedidos], ALLSELECTED(dim_filial[Filial])),
			    BLANK()
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\03. Ranking e Participacao
		lineageTag: b9d32ccf-8cc4-4959-bb5d-d045f3876c2b

	/// Tendencia SPR: 1=subindo vs semana anterior, 0=estavel, -1=caindo
	measure 'Op Tendencia SPR' =
			VAR _atu = [SPR Ped Semana Atual]
			VAR _ant = [SPR Ped Semana Anterior]
			VAR _delta = _atu - _ant
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_atu) || ISBLANK(_ant), BLANK(),
			    _delta > 0.5, 1,
			    _delta < -0.5, -1,
			    0
			)
		formatString: 0
		displayFolder: 01. Operacao\04. Medias e Tendencias
		lineageTag: fd0054fd-8022-404b-b56f-b8127961b4e7

	/// Tendencia Entregas: 1=subindo vs semana anterior, 0=estavel, -1=caindo
	measure 'Op Tendencia Entregas' =
			VAR _atu = CALCULATE([% Entregas Efetivas], dim_calendario[IsSemanaAtual] = TRUE)
			VAR _ant = CALCULATE([% Entregas Efetivas], dim_calendario[IsSemanaAnterior] = TRUE)
			VAR _delta = _atu - _ant
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_atu) || ISBLANK(_ant), BLANK(),
			    _delta > 0.01, 1,
			    _delta < -0.01, -1,
			    0
			)
		formatString: 0
		isHidden
		displayFolder: 98. Suporte\04. Entrega Operacional
		lineageTag: 52ff68bf-12a3-4d6d-846d-84f8f373f17a

	measure 'Ocupacao Pedidos Tipo (%)' =
			VAR _rotas =
			    CALCULATE(
			        COUNTROWS(fato_rotas),
			        KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
			        KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
			    )
			VAR _pedidos =
			    CALCULATE(
			        SUM(fato_rotas[Pedidos da Rota]),
			        KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
			        KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
			    )
			VAR _mediaAtual = DIVIDE(_pedidos, _rotas, BLANK())
			RETURN
			    DIVIDE(_mediaAtual, [Cap P75 Pedidos], 0)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: bb63a443-c266-49c0-bd79-9a5a9a42ccb0

	measure 'Ocupacao Volumes Tipo (%)' =
			VAR _rotas =
			    CALCULATE(
			        COUNTROWS(fato_rotas),
			        KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
			        KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
			    )
			VAR _volumes =
			    CALCULATE(
			        SUM(fato_rotas[Volumes da Rota]),
			        KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
			        KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
			    )
			VAR _mediaAtual = DIVIDE(_volumes, _rotas, BLANK())
			RETURN
			    DIVIDE(_mediaAtual, [Cap P75 Volumes], 0)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 5411c1c5-1627-4fab-bcb9-69195c07b136

	/// Ocupacao media composta (pedidos + volumes) vs capacidade P75
	measure 'Ocupacao Composta (%)' =
			VAR _ped = [Ocupacao Pedidos (%)]
			VAR _vol = [Ocupacao Volumes (%)]
			VAR _qtd = IF(NOT ISBLANK(_ped), 1, 0) + IF(NOT ISBLANK(_vol), 1, 0)
			RETURN
			    IF(
			        _qtd = 0,
			        BLANK(),
			        DIVIDE(COALESCE(_ped, 0) + COALESCE(_vol, 0), _qtd, 0)
			    )
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 85651700-2dea-42f3-a0f9-87b9e632d4fc

	measure 'Rotas Acima Cap Volumes' =
			SUMX(
			    FILTER(
			        VALUES(dim_tipo_veiculo[TipoVeiculo]),
			        NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			    ),
			    VAR _capTipo = CALCULATE([Cap P75 Volumes])
			    RETURN
			        CALCULATE(
			            COUNTROWS(
			                FILTER(
			                    fato_rotas,
			                    NOT ISBLANK(fato_rotas[Volumes da Rota])
			                        && fato_rotas[Volumes da Rota] > _capTipo
			                )
			            )
			        )
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: aee60a54-6191-4b13-bf5d-71189f50ef37

	measure '% Rotas Acima Cap Volumes' =
			DIVIDE(
			    [Rotas Acima Cap Volumes],
			    COUNTROWS(
			        FILTER(
			            fato_rotas,
			            NOT ISBLANK(fato_rotas[Volumes da Rota])
			                && fato_rotas[Volumes da Rota] > 0
			        )
			    ),
			    0
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 0335cc63-c7ef-43ea-bd03-9818ba593277

	measure 'Excesso Medio Pedidos (acima P75)' =
			VAR _cap = [Cap P75 Pedidos]
			RETURN
			    AVERAGEX(
			        FILTER(
			            fato_rotas,
			            NOT ISBLANK(fato_rotas[Pedidos da Rota])
			                && fato_rotas[Pedidos da Rota] > _cap
			        ),
			        fato_rotas[Pedidos da Rota] - _cap
			    )
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 27a405f5-a2dd-4976-926a-c0ede7513649

	measure 'Excesso Medio Volumes (acima P75)' =
			VAR _cap = [Cap P75 Volumes]
			RETURN
			    AVERAGEX(
			        FILTER(
			            fato_rotas,
			            NOT ISBLANK(fato_rotas[Volumes da Rota])
			                && fato_rotas[Volumes da Rota] > _cap
			        ),
			        fato_rotas[Volumes da Rota] - _cap
			    )
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: f7b5aef8-a421-4139-94ce-36b3cf62eb9d

	measure 'Tipo Veiculo Critico Ocupacao' =
			VAR _tab =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            FILTER(
			                VALUES(dim_tipo_veiculo[TipoVeiculo]),
			                NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			            ),
			            "@Occ", [Ocupacao Pedidos Tipo (%)]
			        ),
			        [@Occ], DESC,
			        dim_tipo_veiculo[TipoVeiculo], ASC
			    )
			RETURN
			    MAXX(_tab, dim_tipo_veiculo[TipoVeiculo])
		displayFolder: 04. Frota e Capacidade\03. Mix por Tipo
		lineageTag: 7f4d0ce8-1526-4e49-ac05-8cc8e0658584

	measure 'Ocupacao Pedidos Semana Atual (%)' =
			CALCULATE(
			    [Ocupacao Pedidos (%)],
			    dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 058a184f-5c3e-4ba6-a762-26eda3e806bb

	measure 'Ocupacao Volumes Semana Atual (%)' =
			CALCULATE(
			    [Ocupacao Volumes (%)],
			    dim_calendario[IsSemanaAtual] = TRUE()
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 25f2e6d5-acec-434f-bbe8-c73129dba2b1

	measure 'HTML Tabela Filiais Consolidado Semana' =
			VAR _tab =
			    TOPN(
			        12,
			        ADDCOLUMNS(
			            FILTER(
			                VALUES(dim_filial[Filial]),
			                NOT ISBLANK(dim_filial[Filial])
			                    && CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE()) > 0
			            ),
			            "@Nome", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@Rotas", CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Ent", CALCULATE([% Entregas Efetivas], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@SPR", CALCULATE([SPR Ped Realizado], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@ORH", CALCULATE([Utilizacao Jornada 8h (%)], dim_calendario[IsSemanaAtual] = TRUE())
			        ),
			        [@Rotas], DESC
			    )
			VAR _rows =
			    CONCATENATEX(
			        FILTER(_tab, NOT ISBLANK([@Nome])),
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & [@Nome] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Rotas], "#,##0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Ent], "0.0%") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@SPR], "0.0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@ORH], "0.0%") & "</td></tr>",
			        "",
			        [@Rotas], DESC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='5' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px;margin-bottom:12px}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}</style>"
			RETURN
			    _css &
			    "<div class='card'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 14l3-3 3 2 4-5'/></svg><span>Filiais Consolidadas Semana</span></div>" &
			    "<table><tr><th>FILIAL</th><th class='num'>ROTAS</th><th class='num'>% ENT.</th><th class='num'>SPR</th><th class='num'>ORH</th></tr>" &
			    _rowsFinal &
			    "</table></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\03. Tabelas
		lineageTag: ba15bb0b-e103-49ed-91e6-49190a6ae026

	measure 'HTML Tabela Ocupacao Tipo Veiculo Semana' =
			VAR _tab =
			    TOPN(
			        10,
			        ADDCOLUMNS(
			            FILTER(
			                VALUES(dim_tipo_veiculo[TipoVeiculo]),
			                NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			                    && CALCULATE(COUNTROWS(fato_rotas), dim_calendario[IsSemanaAtual] = TRUE()) > 0
			            ),
			            "@Rotas", CALCULATE(COUNTROWS(fato_rotas), dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Media", CALCULATE([Cap Media Pedidos], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@P75", CALCULATE([Cap P75 Pedidos], dim_calendario[IsSemanaAtual] = TRUE()),
			            "@Occ", CALCULATE([Ocupacao Pedidos Tipo (%)], dim_calendario[IsSemanaAtual] = TRUE())
			        ),
			        [@Occ], DESC
			    )
			VAR _rows =
			    CONCATENATEX(
			        _tab,
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & dim_tipo_veiculo[TipoVeiculo] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Rotas], "#,##0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Media], "0.0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@P75], "0.0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;font-weight:800;color:" & IF([@Occ] > 1, "#E74C3C", IF([@Occ] > 0.90, "#F5A623", "#4CAF50")) & "'>" & FORMAT([@Occ], "0.0%") & "</td></tr>",
			        "",
			        [@Occ], DESC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='5' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px;margin-bottom:12px}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}</style>"
			RETURN
			    _css &
			    "<div class='card'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/></svg><span>Ocupacao por Tipo de Veiculo (Semana)</span></div>" &
			    "<table><tr><th>TIPO VEICULO</th><th class='num'>ROTAS</th><th class='num'>MEDIA PED</th><th class='num'>P75 PED</th><th class='num'>OCUP.</th></tr>" &
			    _rowsFinal &
			    "</table></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\03. Tabelas
		lineageTag: d41563da-af10-440b-9c7a-613cb913a70f

	measure 'HTML Ranking Rotas Criticas Semana' =
			VAR _rotas =
			    FILTER(
			        SUMMARIZE(
			            CALCULATETABLE(
			                fato_rotas,
			                dim_calendario[IsSemanaAtual] = TRUE()
			            ),
			            fato_rotas[Rota],
			            fato_rotas[Filial],
			            "@NomeFilial", CALCULATE(MAX(dim_filial[NomeResumido])),
			            "@Pedidos", SUM(fato_rotas[Pedidos da Rota]),
			            "@Ent", DIVIDE(SUM(fato_rotas[Entregues]), SUM(fato_rotas[Entregues]) + SUM(fato_rotas[Insucessos]), 0),
			            "@Tempo", AVERAGE(fato_rotas[Tempo Realizado (h)]),
			            "@Util", DIVIDE(AVERAGE(fato_rotas[Tempo Realizado (h)]), 8, 0)
			        ),
			        NOT ISBLANK(fato_rotas[Rota])
			            && [@Pedidos] > 0
			    )
			VAR _top =
			    TOPN(
			        10,
			        _rotas,
			        [@Ent], ASC,
			        [@Util], ASC
			    )
			VAR _rows =
			    CONCATENATEX(
			        _top,
			        "<tr><td style='padding:8px 10px;border-bottom:1px solid #F1F3F6;font-size:12px;color:#24324A;font-weight:600'>" & fato_rotas[Rota] & "</td>" &
			        "<td style='padding:8px 10px;font-size:12px;color:#6A7282'>" & [@NomeFilial] & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Pedidos], "#,##0") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;font-weight:700;color:" & IF([@Ent] < 0.90, "#E74C3C", IF([@Ent] < 0.95, "#F5A623", "#4CAF50")) & "'>" & FORMAT([@Ent], "0.0%") & "</td>" &
			        "<td style='padding:8px 10px;text-align:right;font-size:12px;color:#24324A'>" & FORMAT([@Tempo], "0.0") & "h</td></tr>",
			        "",
			        [@Ent], ASC
			    )
			VAR _rowsFinal =
			    IF(
			        LEN(_rows) = 0,
			        "<tr><td colspan='5' style='padding:14px;text-align:center;font-size:12px;color:#6A7282'>Sem dados de rotas na semana atual.</td></tr>",
			        _rows
			    )
			VAR _css =
			    "<style>@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');.card{font-family:'Baloo 2',sans-serif;line-height:1.35;padding:20px 22px;background:#FFF;border:1px solid #E5E7EB;border-radius:14px;box-shadow:0 4px 14px rgba(68,26,128,.10)}.card-title{font-size:14px;font-weight:800;color:#4B2579;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:6px;margin-bottom:12px}table{width:100%;border-collapse:collapse}th{padding:6px 10px;text-align:left;font-size:12px;color:#8B93A4;font-weight:700;border-bottom:2px solid #E5E7EB}th.num{text-align:right}</style>"
			RETURN
			    _css &
			    "<div class='card'><div class='card-title'><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5B2D8C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 16l3-4 3 2 4-6'/></svg><span>Rotas Criticas Semana</span></div>" &
			    "<table><tr><th>ROTA</th><th>FILIAL</th><th class='num'>PEDIDOS</th><th class='num'>% ENT.</th><th class='num'>TEMPO</th></tr>" &
			    _rowsFinal &
			    "</table></div>"
		isHidden
		displayFolder: 90. Legado\01. HTML\02. Rankings
		lineageTag: 1bd5dab6-b0fb-496c-b2f2-b162b7b10a34

	measure 'Total Rotas ORH Base' =
			CALCULATE(
			    COUNTROWS(fato_rotas),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
			    KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 0)
			)
		formatString: #,##0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: c5960b18-2990-401f-b3a1-1674a5e5ac4c

	measure 'Total Rotas ORH Planejado Base' =
			CALCULATE(
			    COUNTROWS(fato_rotas),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
			    KEEPFILTERS(fato_rotas[Tempo Planejado (h)] > 0)
			)
		formatString: #,##0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 0a8cec47-22a6-4352-9d76-4141b2cd75d5

	measure 'Op Rotas Planejadas' =
			CALCULATE(
			    COUNTROWS(fato_planejado),
			    KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
			    KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
