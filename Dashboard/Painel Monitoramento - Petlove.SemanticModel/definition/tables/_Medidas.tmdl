	/// Total de rotas na semana atual. Protegido contra _UltimaData vazia.
	measure 'Rotas Semana Atual' =
			VAR _temDados = NOT ISBLANK(CALCULATE(MAX(fato_rotas[Data Referencia]), ALL(fato_rotas)))
			RETURN
			    IF(_temDados,
			        CALCULATE([Total Rotas], dim_calendario[IsSemanaAtual] = TRUE),
			        BLANK()
			    )
		formatString: #,##0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 80412fed-34ef-4752-b171-d6b78f94133f

	/// Total de rotas na semana anterior completa. Protegido contra _UltimaData vazia.
	measure 'Rotas Semana Anterior' =
