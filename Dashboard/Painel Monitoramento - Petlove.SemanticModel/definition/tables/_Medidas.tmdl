	measure 'KPI ORH Status' =
			VAR _val = [KPI ORH Valor]
			VAR _meta = [KPI ORH Meta]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_val), "sem-dados",
			        _val >= _meta * 0.85 && _val <= _meta * 1.15, "ok",
			        _val < _meta * 0.70 || _val > _meta * 1.30, "critico",
			        "atencao"
			    )
