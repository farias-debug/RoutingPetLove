	/// Capacidade media de peso por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap Media Peso (kg)' =
			AVERAGEX(
			    FILTER(
			        VALUES(dim_tipo_veiculo[TipoVeiculo]),
			        NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			    ),
			    VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapMediaPesoKgRef]))
			    RETURN IF(LEN(TRIM(COALESCE(_ref, ""))) = 0, BLANK(), VALUE(_ref))
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 147837e6-8e89-4191-9574-6ac316ac3ae1

	measure 'Status Capacidade Texto' =
			SWITCH(
			    [Status Capacidade],
			    1, "subocupado",
			    2, "balanceado",
			    3, "saturado",
			    4, "critico",
			    "sem dados"
			)
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 4b1e9ea9-724b-40bd-ab2f-de37824fffbc

	measure 'Status Capacidade Cor' =
			SWITCH(
			    [Status Capacidade],
			    1, "#10B981",
			    2, "#10B981",
			    3, "#F59E0B",
			    4, "#EF4444",
			    "#6A7282"
			)
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 6d84fcfe-746e-4263-bfa3-6c5aeeadd36d

	measure 'Acao Capacidade' =
			SWITCH(
			    [Status Capacidade],
			    1, "Consolidar rotas e reduzir ociosidade do mix",
			    2, "Manter mix atual e monitorar picos por tipo",
			    3, "Redistribuir carga entre tipos e revisar capacidade",
			    4, "Atuar no tipo critico e reduzir sobrecarga imediatamente",
			    "Validar mapeamento de tipo de veiculo"
			)
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: dd50f5c1-badc-4dcf-bab6-77c98bd4a87f

	/// Variacao dia a dia no SPR Vol Realizado (pontos)
	measure 'Var D-1 SPR Volumes' =
			VAR _atual = CALCULATE([SPR Vol Realizado], dim_calendario[IsUltimaData] = TRUE)
			VAR _anterior = CALCULATE([SPR Vol Realizado], dim_calendario[IsAnterior] = TRUE)
			RETURN
			    IF(
			        NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
			        _atual - _anterior,
			        BLANK()
			    )
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 8afb4bc7-20c4-4662-b2b4-d4dcfe945c8a

	/// Variacao semanal no SPR Vol Realizado (%)
	measure 'Var WoW SPR Volumes (%)' =
			VAR _atual = CALCULATE([SPR Vol Realizado], dim_calendario[IsSemanaAtual] = TRUE)
			VAR _anterior = CALCULATE([SPR Vol Realizado], dim_calendario[IsSemanaAnterior] = TRUE)
			RETURN
			    IF(
			        NOT ISBLANK(_atual) && NOT ISBLANK(_anterior) && _anterior <> 0,
			        DIVIDE(_atual - _anterior, _anterior, 0),
			        BLANK()
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: c50c3570-456a-4e09-bc01-fde31c84f691

	/// Variacao dia a dia no desvio SPR Ped vs Plan (pontos)
	measure 'Var D-1 Desvio SPR Ped (pts)' =
			VAR _atual = CALCULATE([Desvio SPR Ped Plan vs Real (pts)], dim_calendario[IsUltimaData] = TRUE)
			VAR _anterior = CALCULATE([Desvio SPR Ped Plan vs Real (pts)], dim_calendario[IsAnterior] = TRUE)
			RETURN
			    IF(
			        NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
			        _atual - _anterior,
			        BLANK()
			    )
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 186aeedf-67cd-4038-b002-ff26d7215080

	/// Variacao semanal no desvio SPR Ped vs Plan (pontos)
	measure 'Var WoW Desvio SPR Ped (pts)' =
			VAR _atual = CALCULATE([Desvio SPR Ped Plan vs Real (pts)], dim_calendario[IsSemanaAtual] = TRUE)
			VAR _anterior = CALCULATE([Desvio SPR Ped Plan vs Real (pts)], dim_calendario[IsSemanaAnterior] = TRUE)
			RETURN
			    IF(
			        NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
			        _atual - _anterior,
