	measure 'Pior Filial SPR Semana' =
			VAR _tab =
			    ADDCOLUMNS(
			        FILTER(VALUES(dim_filial[Filial]), CALCULATE([Total Rotas Unidade]) > 0),
			        "@SPR", CALCULATE([SPR Ped Realizado], dim_calendario[IsSemanaAtual] = TRUE)
			    )
			VAR _min = MINX(_tab, [@SPR])
			RETURN
			    MAXX(FILTER(_tab, [@SPR] = _min), dim_filial[Filial])
		displayFolder: 01. Operacao\03. Ranking e Participacao
