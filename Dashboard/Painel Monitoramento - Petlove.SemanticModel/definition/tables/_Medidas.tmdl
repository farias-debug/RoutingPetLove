	measure 'SVG Card Rotas Planejadas' =
			VAR _valor = FORMAT([Op Rotas Planejadas], "#,##0")
			VAR _ped = FORMAT([Op Pedidos Planejados], "#,##0")
			VAR _vol = FORMAT([Op Volumes Planejados], "#,##0")
			VAR _progresso = [Op Progresso Rotas (%)]
			VAR _ratio = MIN(MAX(_progresso, 0), 1)
			VAR _gap = [Op Rotas Realizadas] - [Op Rotas Planejadas]
			VAR _gapFmt = FORMAT(_gap, "+#,##0;-#,##0;0")
			VAR _status =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_progresso), "BASE",
			        _progresso >= 0.95, "ALINHADO",
			        _progresso >= 0.80, "MONITORAR",
			        "ABAIXO"
			    )
			VAR _cor =
			    SWITCH(
			        _status,
			        "ALINHADO", "#4CAF50",
			        "MONITORAR", "#F5A623",
			        "ABAIXO", "#E74C3C",
			        "#5C6673"
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#F8FDFB' stroke='#DDE9E5'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>ROTAS PLANEJADAS</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>Pedidos " & _ped & " | Volumes " & _vol & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>Gap realizado vs plano " & _gapFmt & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#DDE9E5'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 38a6fd40-61c6-4d45-b587-d9fd10ef9cff
		dataCategory: ImageUrl

	measure 'SVG Card Rotas Realizadas' =
			VAR _valor = FORMAT([Op Rotas Realizadas], "#,##0")
			VAR _ped = FORMAT([Op Pedidos Realizados], "#,##0")
			VAR _vol = FORMAT([Op Volumes Realizados], "#,##0")
			VAR _progresso = [Op Progresso Rotas (%)]
			VAR _ratio = MIN(MAX(_progresso, 0), 1)
			VAR _status =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_progresso), "SEM DADOS",
			        _progresso >= 0.95, "ESTAVEL",
			        _progresso >= 0.80, "MONITORAR",
			        "AGIR"
			    )
			VAR _cor =
			    SWITCH(
			        _status,
			        "ESTAVEL", "#4CAF50",
			        "MONITORAR", "#F5A623",
			        "AGIR", "#E74C3C",
			        "#6A7282"
			    )
			VAR _alerta = COALESCE([Op Alerta Prioritario], "Sem alertas operacionais ativos")
			VAR _alertaCurto = IF(LEN(_alerta) > 38, LEFT(_alerta, 38) & "...", _alerta)
			VAR _alertaSafe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_alertaCurto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#F7FAFD' stroke='#DCE5ED'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>ROTAS REALIZADAS</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>Pedidos " & _ped & " | Volumes " & _vol & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>" & _alertaSafe & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#DCE5ED'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 911333b4-f36e-415c-bf99-eb7b07ad6d37
		dataCategory: ImageUrl

	measure 'SVG Card Total Pedidos' =
			VAR _valor = FORMAT([Total Pedidos], "#,##0")
			VAR _deltaDia = FORMAT([Var D-1 Pedidos], "+#,##0;-#,##0;0")
			VAR _deltaWow = FORMAT([Var WoW Pedidos], "+0.0%;-0.0%;0.0%")
			VAR _prod = FORMAT([Pedidos/h Realizado], "0.0")
			VAR _ratio = MIN(MAX([Op Progresso Pedidos (%)], 0), 1)
