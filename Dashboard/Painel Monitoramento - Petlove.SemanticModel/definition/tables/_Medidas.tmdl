	measure 'SVG Card Score Operacional' =
			VAR _valorNum = [Score Operacional]
			VAR _valor = FORMAT(_valorNum, "0")
			VAR _status =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_valorNum), "SEM DADOS",
			        _valorNum >= 90, "ESTAVEL",
			        _valorNum >= 70, "MONITORAR",
			        "AGIR"
			    )
			VAR _cor =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_valorNum), "#6A7282",
			        _valorNum >= 90, "#4CAF50",
			        _valorNum >= 70, "#F5A623",
			        "#E74C3C"
			    )
			VAR _sub = "SPR " & FORMAT([Score SPR (0-100)], "0") & " | ORH " & FORMAT([KPI ORH Valor], "0.0")
			VAR _acao = COALESCE([Op Alerta Prioritario], "Sem alertas operacionais ativos")
			VAR _acaoCurta = IF(LEN(_acao) > 40, LEFT(_acao, 40) & "...", _acao)
			VAR _acaoSafe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_acaoCurta, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _ratio = MIN(MAX(DIVIDE(_valorNum, 100, 0), 0), 1)
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#F8FAFC' stroke='#DCE5ED'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>SCORE OPERACIONAL</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>" & _sub & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>" & _acaoSafe & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#DCE5ED'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 95a11bf9-978a-48e9-b1a1-c2152bf1565e
		dataCategory: ImageUrl

	measure 'SVG Card Pedidos Hora' =
			VAR _real = [Pedidos/h Realizado]
			VAR _plan = [Pedidos/h Planejado]
			VAR _delta = [Desvio Pedidos/h]
			VAR _status =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_real), "SEM DADOS",
			        _delta >= 0, "DENTRO",
			        DIVIDE(_delta, _plan, 0) >= -0.10, "MONITORAR",
			        "AGIR"
			    )
			VAR _cor =
			    SWITCH(
			        _status,
			        "DENTRO", "#4CAF50",
			        "MONITORAR", "#F5A623",
			        "AGIR", "#E74C3C",
			        "#6A7282"
			    )
			VAR _ratio = MIN(MAX(DIVIDE(_real, _plan, 0), 0), 1)
			VAR _valor = IF(ISBLANK(_real), "--", FORMAT(_real, "0.0"))
			VAR _meta = IF(ISBLANK(_plan), "--", FORMAT(_plan, "0.0"))
			VAR _deltaFmt = IF(ISBLANK(_delta), "--", FORMAT(_delta, "+0.0;-0.0;0.0"))
			VAR _texto =
			    SWITCH(
			        _status,
			        "DENTRO", "Produtividade dentro do plano",
			        "MONITORAR", "Produtividade caiu na janela",
			        "AGIR", "Produtividade abaixo do plano",
			        "Sem dados"
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#F7FBFD' stroke='#D7E4EC'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>PEDIDOS POR HORA</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<rect x='132' y='58' width='88' height='24' rx='12' fill='#FFFFFF' stroke='#D7E4EC'/>"
			        & "<text x='176' y='74' text-anchor='middle' font-family='Segoe UI Semibold' font-size='11' fill='" & _cor & "'>" & _deltaFmt & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>Plano " & _meta & " por hora</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>" & _texto & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#D7E4EC'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 9b6ca51e-1cad-4cef-bb70-b8a6d2b267e6
		dataCategory: ImageUrl

	measure 'SVG Card Eficiencia KM' =
			VAR _valorNum = [Eficiencia KM (%)]
			VAR _status =
			    SWITCH(
			        TRUE(),
			        ISBLANK(_valorNum), "SEM DADOS",
			        _valorNum >= 1, "DENTRO",
			        _valorNum >= 0.95, "MONITORAR",
			        "AGIR"
			    )
			VAR _cor =
			    SWITCH(
			        _status,
			        "DENTRO", "#4CAF50",
			        "MONITORAR", "#F5A623",
			        "AGIR", "#E74C3C",
			        "#6A7282"
			    )
			VAR _ratio = MIN(MAX(_valorNum, 0), 1)
			VAR _valor = IF(ISBLANK(_valorNum), "--", FORMAT(_valorNum, "0.0%"))
			VAR _delta = IF(ISBLANK(_valorNum), "--", FORMAT(_valorNum - 1, "+0.0%;-0.0%;0.0%"))
			VAR _pedKm = FORMAT([Pedidos/KM Realizado], "0.00")
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='136' viewBox='0 0 360 136'>"
			        & "<rect x='1' y='1' width='358' height='134' rx='22' fill='#FCFAF5' stroke='#E7DDD0'/>"
			        & "<circle cx='314' cy='20' r='54' fill='" & _cor & "' opacity='0.08'/>"
			        & "<rect x='18' y='18' width='42' height='8' rx='4' fill='" & _cor & "'/>"
			        & "<text x='18' y='42' font-family='Segoe UI Semibold' font-size='11' fill='#6A7282' letter-spacing='1'>EFICIENCIA KM</text>"
			        & "<rect x='250' y='18' width='90' height='24' rx='12' fill='" & _cor & "' opacity='0.15'/>"
			        & "<text x='295' y='34' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & _cor & "'>" & _status & "</text>"
			        & "<text x='18' y='80' font-family='Segoe UI Semibold' font-size='34' fill='#102536'>" & _valor & "</text>"
			        & "<rect x='132' y='58' width='88' height='24' rx='12' fill='#FFFFFF' stroke='#E7DDD0'/>"
			        & "<text x='176' y='74' text-anchor='middle' font-family='Segoe UI Semibold' font-size='11' fill='" & _cor & "'>" & _delta & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>Meta 100% | Ped/KM " & _pedKm & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>Acima de 100% indica menos KM que o plano</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#E7DDD0'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 7b69fc83-6c75-48f6-a0ff-1c9b96a6a996
		dataCategory: ImageUrl

	measure 'SVG Card Total Rotas' =
			VAR _valor = FORMAT([Total Rotas], "#,##0")
			VAR _deltaDia = FORMAT([Var D-1 Rotas], "+#,##0;-#,##0;0")
			VAR _deltaWow = FORMAT([Var WoW Rotas], "+0.0%;-0.0%;0.0%")
			VAR _progresso = [Op Progresso Rotas (%)]
			VAR _ratio = MIN(MAX(_progresso, 0), 1)
