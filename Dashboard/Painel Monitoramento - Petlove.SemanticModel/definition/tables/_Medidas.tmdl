			        & "<rect x='132' y='58' width='88' height='24' rx='12' fill='#FFFFFF' stroke='#E7DDD0'/>"
			        & "<text x='176' y='74' text-anchor='middle' font-family='Segoe UI Semibold' font-size='11' fill='" & _cor & "'>" & _delta & "</text>"
			        & "<text x='18' y='99' font-family='Segoe UI' font-size='12' fill='#5C6673'>Meta " & _meta & " | WoW " & _wow & "</text>"
			        & "<text x='18' y='117' font-family='Segoe UI' font-size='11' fill='#324152'>" & _textoSafe & "</text>"
			        & "<rect x='18' y='123' width='324' height='8' rx='4' fill='#E6DED0'/>"
			        & "<rect x='18' y='123' width='" & FORMAT(324 * _ratio, "0") & "' height='8' rx='4' fill='" & _cor & "'/>"
