	/// Status semaforo do KPI ORH (horas operacionais por rota) (ok/atencao/critico)
	measure 'KPI ORH Status' = 
			VAR _val = [KPI ORH Valor]
			VAR _meta = [KPI ORH Meta]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_val), "sem-dados",
					_val >= _meta * 0.85 && _val <= _meta * 1.15, "ok",
					_val < _meta * 0.70 || _val > _meta * 1.30, "critico",
					"atencao"
				)
		displayFolder: 03. Jornada e ORH\02. KPI ORH
		lineageTag: 48147f2b-ab19-46c6-8896-d17235a62761

