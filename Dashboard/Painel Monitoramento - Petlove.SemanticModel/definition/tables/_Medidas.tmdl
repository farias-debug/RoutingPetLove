	/// Meta do SPR Ped (global ou filial)
	measure 'KPI SPR Ped Meta' =
			VAR _metaFilial = [Meta SPR Pedidos]
			VAR _metaGlobal = [Meta Global SPR Ped]
			RETURN IF(NOT ISBLANK(_metaFilial), _metaFilial, _metaGlobal)
		formatString: 0.0
