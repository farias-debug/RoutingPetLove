/// Tabela exclusiva para medidas DAX. Nao contem dados.
table _Medidas
	isHidden
	lineageTag: f6ce0521-97ad-48cf-822a-80851d603e8d

	/// Contagem total de rotas realizadas no periodo filtrado
	measure 'Total Rotas' = 
			CALCULATE(
				COUNTROWS(fato_rotas),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 02522c45-940a-4150-a1e8-088617e80755

	/// Soma de entregas realizadas com sucesso
	measure 'Total Entregas' = 
			CALCULATE(
				SUM(fato_rotas[Entregues]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: e77aa64a-21ec-4a82-96bf-ff48dca05e3c

	/// Soma de insucessos de entrega
	measure 'Total Insucessos' = 
			CALCULATE(
				SUM(fato_rotas[Insucessos]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: 1d6317f9-1a5a-4e43-9076-674da6369819

	/// Percentual de entregas efetivadas com sucesso sobre o total de tentativas
	measure '% Entregas Efetivas' = 
			DIVIDE(
				[Total Entregas],
				[Total Entregas] + [Total Insucessos],
				0
			)
		formatString: 0.0%
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: 09d6a596-a224-4d4d-82d5-be1cc3bc4fda

	/// Taxa de insucesso de entregas
	measure '% Insucessos' = 
			DIVIDE(
				[Total Insucessos],
				[Total Entregas] + [Total Insucessos],
				0
			)
		formatString: 0.0%
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: c88bbd28-3af3-4463-87b7-88e0cb4bef39

	/// Quilometragem total percorrida em todas as rotas do periodo
	measure 'Total KM Realizado' = 
			CALCULATE(
				SUM(fato_rotas[KM Realizado]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 4c943fbf-f6ed-4323-8d03-2bdc5947c220

	/// Media de KM por rota
	measure 'Media KM por Rota' = 
			DIVIDE(
				[Total KM Realizado],
				[Total Rotas],
				0
			)
		formatString: 0.0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 3538d927-fb28-4858-b6f1-5fe0a590864f

	/// Contagem total de pedidos transportados no periodo filtrado
	measure 'Total Pedidos' = 
			CALCULATE(
				SUM(fato_rotas[Pedidos da Rota]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 716a9bba-fc37-48dc-afc4-739e6ae001b0

	/// Contagem total de volumes (caixas) transportados no periodo
	measure 'Total Volumes' = 
			CALCULATE(
				SUM(fato_rotas[Volumes da Rota]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 7232fd25-0dac-4a14-a4d6-ef3e82d31c3a

	/// Media simples de pedidos por rota no periodo
	measure 'Media Pedidos por Rota' = 
			DIVIDE(
				[Total Pedidos],
				[Total Rotas],
				0
			)
		formatString: 0.0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 9303a8b6-03bf-447c-b51c-7c626e543399

	/// Quantidade de veiculos distintos que realizaram rotas no periodo
	measure 'Veiculos Ativos' = 
			CALCULATE(
				DISTINCTCOUNT(fato_rotas[Placa]),
				KEEPFILTERS(dim_filial[Tipo] <> "Provet"),
				KEEPFILTERS(NOT ISBLANK(dim_filial[Filial]))
			)
		formatString: #,##0
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 1254da7e-2025-40d5-94b3-0bac0b65d8c7

	/// Percentual de rotas com status finalizado sobre o total de rotas
	measure '% Rotas Concluidas' = 
			DIVIDE(
				COUNTROWS(FILTER(
					fato_rotas,
					fato_rotas[Rota Concluida] = 1
				)),
				[Total Rotas],
				0
			)
		formatString: 0.0%
		displayFolder: 01. Operacao\01. Volume e Execucao
		lineageTag: 9bf2a89c-13e1-48a0-b2cc-eb3ba6486af0

	/// Tempo medio planejado por rota em horas (fonte fato_rotas)
	measure 'Tempo Medio Planejado (h)' = 
			DIVIDE(
				CALCULATE(
					SUM(fato_rotas[Tempo Planejado (h)]),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
					KEEPFILTERS(fato_rotas[Tempo Planejado (h)] > 0)
				),
				[Total Rotas ORH Planejado Base],
				0
			)
		formatString: 0.0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 4e36b7e8-e1d7-43ff-bbd2-12d36a0248d0

	/// Tempo medio de rota realizado em horas
	measure 'Tempo Medio Realizado (h)' = 
			DIVIDE(
				CALCULATE(
					SUM(fato_rotas[Tempo Realizado (h)]),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade"),
					KEEPFILTERS(NOT ISBLANK(dim_filial[Filial])),
					KEEPFILTERS(fato_rotas[Tempo Realizado (h)] > 0)
				),
				[Total Rotas ORH Base],
				0
			)
		formatString: 0.0
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 2bb2412f-bccc-4a41-a07a-c9bbbc789115

	/// Percentual medio de utilizacao da jornada de 8h por rota
	measure 'Utilizacao Jornada 8h (%)' = 
			DIVIDE(
				[Tempo Medio Realizado (h)],
				8,
				0
			)
		formatString: 0.0%
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: 9eebd7db-4836-457e-b8b9-dbde4e1af25e

	/// Percentual de ociosidade na jornada 8h
	measure 'Ociosidade Jornada 8h (%)' = 1 - [Utilizacao Jornada 8h (%)]
		formatString: 0.0%
		displayFolder: 03. Jornada e ORH\01. ORH e Jornada
		lineageTag: c6f5408f-bae4-4609-b1f0-498f0a9ebeb0

	/// Desvio absoluto pedidos (real - planejado)
	measure 'Desvio Absoluto Pedidos' = [Total Pedidos] - SUM(fato_planejado[Pedidos Planejados])
		formatString: +#,##0;-#,##0;0
		displayFolder: 05. Plano vs Real\01. Desvios Absolutos
		lineageTag: bc450fa9-0f88-4621-bf42-01fd06867060

	/// Desvio absoluto volumes (real - planejado)
	measure 'Desvio Absoluto Volumes' = [Total Volumes] - SUM(fato_planejado[Volumes Planejados])
		formatString: +#,##0;-#,##0;0
		displayFolder: 05. Plano vs Real\01. Desvios Absolutos
		lineageTag: 504b28e3-2e72-4dcf-ae90-cb408cc7cf3b

	/// Desvio absoluto peso (real - planejado)
	measure 'Desvio Absoluto Peso' = SUM(fato_rotas[Peso (kg)]) - SUM(fato_planejado[Peso Planejado (kg)])
		formatString: +#,##0;-#,##0;0
		displayFolder: 05. Plano vs Real\01. Desvios Absolutos
		lineageTag: 59ce7b34-36b6-44d2-99bf-d599d5e8b216

	/// Desvio absoluto KM (real - planejado)
	measure 'Desvio Absoluto KM' = [Total KM Realizado] - SUM(fato_planejado[KM Planejado Plan])
		formatString: +#,##0;-#,##0;0
		displayFolder: 05. Plano vs Real\01. Desvios Absolutos
		lineageTag: e0e148dc-2994-4f3f-b453-7160c7008b48

	/// Desvio absoluto tempo (real - planejado)
	measure 'Desvio Absoluto Tempo' = SUM(fato_rotas[Tempo Realizado (h)]) - SUM(fato_planejado[Tempo Planejado Plan (h)])
		formatString: +0.0;-0.0;0.0
		displayFolder: 05. Plano vs Real\01. Desvios Absolutos
		lineageTag: aab88642-38d3-4389-ab34-331ffcedf7e7

	/// Aderencia pedidos: real / planejado
	measure 'Aderencia Pedidos (%)' = 
			DIVIDE(
				[Total Pedidos],
				SUM(fato_planejado[Pedidos Planejados]),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\02. Aderencia Percentual
		lineageTag: b64f50a1-991f-47cc-8d99-8f2f7fcf6568

	/// Aderencia volumes: real / planejado
	measure 'Aderencia Volumes (%)' = 
			DIVIDE(
				[Total Volumes],
				SUM(fato_planejado[Volumes Planejados]),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\02. Aderencia Percentual
		lineageTag: 2b6e1c26-db8a-4cf9-aad1-6f2cf90cf377

	/// Aderencia peso: real / planejado
	measure 'Aderencia Peso (%)' = 
			DIVIDE(
				SUM(fato_rotas[Peso (kg)]),
				SUM(fato_planejado[Peso Planejado (kg)]),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\02. Aderencia Percentual
		lineageTag: 78103210-0772-446f-82dd-bf941ec9a75c

	/// Aderencia KM: real / planejado
	measure 'Aderencia KM (%)' = 
			DIVIDE(
				[Total KM Realizado],
				SUM(fato_planejado[KM Planejado Plan]),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\02. Aderencia Percentual
		lineageTag: 61a74520-5c5c-4c8c-93d0-6589d5f1baba

	/// Aderencia tempo: real / planejado
	measure 'Aderencia Tempo (%)' = 
			DIVIDE(
				SUM(fato_rotas[Tempo Realizado (h)]),
				SUM(fato_planejado[Tempo Planejado Plan (h)]),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\02. Aderencia Percentual
		lineageTag: bb624276-b0df-4238-86f0-87763fcf5a25

	/// Percentual de rotas realizadas que possuem correspondencia no planejamento
	measure 'Cobertura Rotas (%)' = 
			DIVIDE(
				[Total Rotas],
				COUNTROWS(fato_planejado),
				0
			)
		formatString: 0.0%
		displayFolder: 05. Plano vs Real\03. Cobertura e Match
		lineageTag: 420f410f-8f02-472d-a67a-266abebb2476

	/// Pedidos por hora planejado
	measure 'Pedidos/h Planejado' = 
			DIVIDE(
				SUM(fato_planejado[Pedidos Planejados]),
				SUM(fato_planejado[Tempo Planejado Plan (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 2ec624cd-8809-4e3c-96b3-83a269f4f511

	/// Pedidos por hora realizado
	measure 'Pedidos/h Realizado' = 
			DIVIDE(
				[Total Pedidos],
				SUM(fato_rotas[Tempo Realizado (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 3841e387-943f-4ea9-bf4d-416d0382248b

	/// Volumes por hora planejado
	measure 'Volumes/h Planejado' = 
			DIVIDE(
				SUM(fato_planejado[Volumes Planejados]),
				SUM(fato_planejado[Tempo Planejado Plan (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: fcb0c49a-85d1-4b05-968a-593e1aa538c4

	/// Volumes por hora realizado
	measure 'Volumes/h Realizado' = 
			DIVIDE(
				[Total Volumes],
				SUM(fato_rotas[Tempo Realizado (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: bae3ee42-d1a1-44a0-8589-9a658167ccb5

	/// Peso por hora planejado (kg/h)
	measure 'Peso/h Planejado (kg/h)' = 
			DIVIDE(
				SUM(fato_planejado[Peso Planejado (kg)]),
				SUM(fato_planejado[Tempo Planejado Plan (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 63792a1a-e654-4318-87ae-ef73f0291c13

	/// Peso por hora realizado (kg/h)
	measure 'Peso/h Realizado (kg/h)' = 
			DIVIDE(
				SUM(fato_rotas[Peso (kg)]),
				SUM(fato_rotas[Tempo Realizado (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 138e7bea-4ddc-4a3f-a749-c8b390a8b218

	/// Entregas efetivas por hora trabalhada
	measure 'Entregas Efetivas/h' = 
			DIVIDE(
				[Total Entregas],
				SUM(fato_rotas[Tempo Realizado (h)]),
				0
			)
		formatString: 0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 9fac1b3b-85d9-42d8-b9b4-7be1d5b7a72b

	/// Desvio pedidos/h (real - plan)
	measure 'Desvio Pedidos/h' = [Pedidos/h Realizado] - [Pedidos/h Planejado]
		formatString: +0.0;-0.0;0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: e289dc5a-8b9f-4058-af9c-313fea129878

	/// Desvio volumes/h (real - plan)
	measure 'Desvio Volumes/h' = [Volumes/h Realizado] - [Volumes/h Planejado]
		formatString: +0.0;-0.0;0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: 9bd8a674-eafe-453b-a84f-95e7c9481d80

	/// Desvio peso/h (real - plan)
	measure 'Desvio Peso/h' = [Peso/h Realizado (kg/h)] - [Peso/h Planejado (kg/h)]
		formatString: +0.0;-0.0;0.0
		displayFolder: 02. SPR e Performance\02. Produtividade Hora
		lineageTag: c4b65f37-422c-4ead-a79e-8cbacbded930

	/// Pedidos por KM planejado
	measure 'Pedidos/KM Planejado' = 
			DIVIDE(
				SUM(fato_planejado[Pedidos Planejados]),
				SUM(fato_planejado[KM Planejado Plan]),
				0
			)
		formatString: 0.00
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: eb9e21ee-947f-4451-a6b5-afeb79e45752

	/// Pedidos por KM realizado
	measure 'Pedidos/KM Realizado' = 
			DIVIDE(
				[Total Pedidos],
				[Total KM Realizado],
				0
			)
		formatString: 0.00
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: f07375a7-0e73-4a0d-821c-0b58739c427e

	/// Volumes por KM realizado
	measure 'Volumes/KM Realizado' = 
			DIVIDE(
				[Total Volumes],
				[Total KM Realizado],
				0
			)
		formatString: 0.00
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: 1e0c8c24-1054-4c2e-a883-e6b7213d30ea

	/// Peso por KM realizado (kg/km)
	measure 'Peso/KM Realizado (kg/km)' = 
			DIVIDE(
				SUM(fato_rotas[Peso (kg)]),
				[Total KM Realizado],
				0
			)
		formatString: 0.00
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: 1e368766-5e22-400a-aaab-5a19bd5bfef9

	/// Desvio pedidos/KM (real - plan)
	measure 'Desvio Pedidos/KM' = [Pedidos/KM Realizado] - [Pedidos/KM Planejado]
		formatString: +0.00;-0.00;0
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: 2746e1fb-f5e0-484b-a7fb-133274fb7f72

	/// Eficiencia KM: razao plan/real (>100% = rodou menos que planejado)
	measure 'Eficiencia KM (%)' = 
			DIVIDE(
				SUM(fato_planejado[KM Planejado Plan]),
				[Total KM Realizado],
				0
			)
		formatString: 0.0%
		displayFolder: 02. SPR e Performance\03. Eficiencia KM
		lineageTag: c8d475fa-2fd8-4bf6-8d1c-78ef6f623252

	/// Capacidade P75 de pedidos por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap P75 Pedidos' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapP75PedidosRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 67e7c0ac-cbe0-4a16-928d-7c7d3098af00

	/// Capacidade P75 de volumes por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap P75 Volumes' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapP75VolumesRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 0eae9fbc-7e7e-43a9-be6e-75591f0d62a9

	/// Capacidade P75 de peso por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap P75 Peso (kg)' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapP75PesoKgRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 8733fc36-dbf6-41c1-bfd7-c95cbc7324c4

	/// Capacidade P75 de KM por rota (percentil 75 historico)
	measure 'Cap P75 KM' = 
			PERCENTILEX.INC(
				FILTER(
					fato_rotas,
					NOT ISBLANK(fato_rotas[KM Realizado])
					&& fato_rotas[KM Realizado] > 0
				),
				fato_rotas[KM Realizado],
				0.75
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: c926b9a5-f047-47d3-b7a2-ca5a6643d83b

	/// Capacidade P75 de tempo por rota em horas (percentil 75 historico)
	measure 'Cap P75 Tempo (h)' = 
			PERCENTILEX.INC(
				FILTER(
					fato_rotas,
					NOT ISBLANK(fato_rotas[Tempo Realizado (h)])
					&& fato_rotas[Tempo Realizado (h)] > 0
				),
				fato_rotas[Tempo Realizado (h)],
				0.75
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 4d7deeac-f470-42c1-87b5-822efd1d4407

	/// Capacidade media de pedidos por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap Media Pedidos' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapMediaPedidosRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: 836c8de2-7307-4bb2-87c9-e2f7df4a7f56

	/// Capacidade media de volumes por tipo, lida da dimensao dim_tipo_veiculo
	measure 'Cap Media Volumes' = 
			AVERAGEX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _ref = CALCULATE(MAX(dim_tipo_veiculo[CapMediaVolumesRef]))
				RETURN
					IF(
						LEN(TRIM(COALESCE(
							_ref,
							""
						))) = 0,
						BLANK(),
						VALUE(_ref)
					)
			)
		formatString: 0.0
		displayFolder: 04. Frota e Capacidade\01. Referencia de Capacidade
		lineageTag: d04e91f0-ae76-4b9c-8252-185d25ce2b22

	/// Ocupacao de pedidos: media atual do periodo / P75 de referencia por tipo
	measure 'Ocupacao Pedidos (%)' = 
			VAR _tipos =
			FILTER(
				VALUES(dim_tipo_veiculo[TipoVeiculo]),
				NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			)
			VAR _num =
			SUMX(
				_tipos,
				VAR _rotas =
				CALCULATE(
					COUNTROWS(fato_rotas),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
					KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
				)
				VAR _pedidos =
				CALCULATE(
					SUM(fato_rotas[Pedidos da Rota]),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
					KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
				)
				VAR _mediaTipo = DIVIDE(
					_pedidos,
					_rotas,
					BLANK()
				)
				VAR _capTipo = CALCULATE([Cap P75 Pedidos])
				RETURN
					DIVIDE(
						_mediaTipo,
						_capTipo,
						BLANK()
					) * _rotas
			)
			VAR _den =
			SUMX(
				_tipos,
				CALCULATE(
					COUNTROWS(fato_rotas),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Pedidos da Rota])),
					KEEPFILTERS(fato_rotas[Pedidos da Rota] > 0)
				)
			)
			RETURN
				DIVIDE(
					_num,
					_den,
					0
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 05e5255b-13ab-4151-aefb-eb19a17df7ce

	/// Ocupacao de volumes: media atual do periodo / P75 de referencia por tipo
	measure 'Ocupacao Volumes (%)' = 
			VAR _tipos =
			FILTER(
				VALUES(dim_tipo_veiculo[TipoVeiculo]),
				NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
			)
			VAR _num =
			SUMX(
				_tipos,
				VAR _rotas =
				CALCULATE(
					COUNTROWS(fato_rotas),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
					KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
				)
				VAR _volumes =
				CALCULATE(
					SUM(fato_rotas[Volumes da Rota]),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
					KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
				)
				VAR _mediaTipo = DIVIDE(
					_volumes,
					_rotas,
					BLANK()
				)
				VAR _capTipo = CALCULATE([Cap P75 Volumes])
				RETURN
					DIVIDE(
						_mediaTipo,
						_capTipo,
						BLANK()
					) * _rotas
			)
			VAR _den =
			SUMX(
				_tipos,
				CALCULATE(
					COUNTROWS(fato_rotas),
					KEEPFILTERS(NOT ISBLANK(fato_rotas[Volumes da Rota])),
					KEEPFILTERS(fato_rotas[Volumes da Rota] > 0)
				)
			)
			RETURN
				DIVIDE(
					_num,
					_den,
					0
				)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 29c2bf78-72b1-4717-b4fe-c1ad0fb2fe51

	/// Quantidade de rotas com pedidos acima do P75 de capacidade
	measure 'Rotas Acima Cap Pedidos' = 
			SUMX(
				FILTER(
					VALUES(dim_tipo_veiculo[TipoVeiculo]),
					NOT ISBLANK(dim_tipo_veiculo[TipoVeiculo])
				),
				VAR _capTipo = CALCULATE([Cap P75 Pedidos])
				RETURN
					CALCULATE(COUNTROWS(FILTER(
						fato_rotas,
						NOT ISBLANK(fato_rotas[Pedidos da Rota])
						&& fato_rotas[Pedidos da Rota] > _capTipo
					)
					)
					)
			)
		formatString: #,##0
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 5f65ae16-58dd-446c-bf4e-d0ac448e4409

	/// Percentual de rotas acima da capacidade P75
	measure '% Rotas Acima Cap' = 
			DIVIDE(
				[Rotas Acima Cap Pedidos],
				COUNTROWS(FILTER(
					fato_rotas,
					NOT ISBLANK(fato_rotas[Pedidos da Rota])
					&& fato_rotas[Pedidos da Rota] > 0
				)
				),
				0
			)
		formatString: 0.0%
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 93d49867-dad6-4409-ab88-23103e149604

	/// Rotas por veiculo por dia (corrigido para multiplos dias)
	measure 'Rotas por Veiculo Dia' = 
			VAR _dias = DISTINCTCOUNT(fato_rotas[Data Referencia])
			RETURN
				DIVIDE(
					[Total Rotas],
					[Veiculos Ativos] * _dias,
					0
				)
		formatString: 0.00
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: c316b3b7-09c7-46c3-b10a-2a200b567979

	/// Status semaforo de capacidade baseado na ocupacao de pedidos
	measure 'Status Capacidade' = 
			VAR _ocup = [Ocupacao Composta (%)]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_ocup), BLANK(),
					_ocup < 0.75, 1,
					_ocup <= 0.95, 2,
					_ocup <= 1.10, 3,
					4
				)
		formatString: 0
		displayFolder: 04. Frota e Capacidade\02. Ocupacao Geral
		lineageTag: 255030e8-1e15-4528-b938-2833c659fe83

	/// Media movel 7 dias do percentual de insucessos (requer filtro de data)
	measure 'Taxa Insucesso MA7' = 
			AVERAGEX(
				DATESINPERIOD(
					dim_calendario[Data],
					LASTDATE(dim_calendario[Data]),
					-7,
					DAY
				),
				[% Insucessos]
			)
		formatString: 0.0%
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: fb822186-b8f0-4762-98d8-37b39a8e2f65

	/// Media movel 7 dias do percentual de entregas efetivas (requer filtro de data)
	measure 'Taxa Sucesso MA7' = 
			AVERAGEX(
				DATESINPERIOD(
					dim_calendario[Data],
					LASTDATE(dim_calendario[Data]),
					-7,
					DAY
				),
				[% Entregas Efetivas]
			)
		formatString: 0.0%
		displayFolder: 08. Entregas\01. Entrega Base
		lineageTag: 1f70b1e8-2c6e-4b17-bf04-aae5b8012c7c

	/// Variacao dia a dia no total de rotas (absoluto). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 Rotas' = 
			VAR _atual = CALCULATE(
				[Total Rotas],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[Total Rotas],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +#,##0;-#,##0;0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 8e6610d7-ea0a-4cf4-aea3-4554ef8a97e9

	/// Variacao dia a dia no total de pedidos (absoluto). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 Pedidos' = 
			VAR _atual = CALCULATE(
				[Total Pedidos],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[Total Pedidos],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +#,##0;-#,##0;0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 0560730b-7b87-4004-94ac-9c071bbab71b

	/// Variacao dia a dia no % entregas efetivas (pp). Usa flags IsUltimaData/IsAnterior.
	measure 'Var D-1 % Entregas' = 
			VAR _atual = CALCULATE(
				[% Entregas Efetivas],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[% Entregas Efetivas],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 858c5382-9831-4aa2-b4a5-224bb4b3ed01

	/// Variacao semanal no total de rotas (%). Usa flags IsSemanaAtual/Anterior.
	measure 'Var WoW Rotas' = 
			VAR _atual = CALCULATE(
				[Total Rotas],
				dim_calendario[IsSemanaAtual] = TRUE
			)
			VAR _anterior = CALCULATE(
				[Total Rotas],
				dim_calendario[IsSemanaAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior) && _anterior <> 0,
					DIVIDE(
						_atual - _anterior,
						_anterior,
						0
					),
					BLANK()
				)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 3d2fc988-bda0-42e4-943d-7505d0f53b29

