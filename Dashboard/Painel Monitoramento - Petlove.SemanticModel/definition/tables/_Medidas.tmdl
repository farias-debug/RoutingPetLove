	measure 'TblExp Aderencia Pedidos Linha' =
			VAR _tbl =
			    ADDCOLUMNS(
			        VALUES(fato_rotas[IdCarga]),
			        "@Ped", CALCULATE(SUM(fato_rotas[Pedidos da Rota])),
			        "@Cap",
			            CALCULATE(
			                [Cap P75 Pedidos],
			                ALLEXCEPT(fato_rotas, fato_rotas[Filial], fato_rotas[Tipo de Veiculo Padrao])
			            )
			    )
			RETURN
			AVERAGEX(_tbl, DIVIDE([@Ped], [@Cap], BLANK()))
		formatString: 0.00
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 353cb953-9275-4397-8505-f129296775a1

	measure 'TblExp Aderencia Volumes Linha' =
			VAR _tbl =
			    ADDCOLUMNS(
			        VALUES(fato_rotas[IdCarga]),
			        "@Vol", CALCULATE(SUM(fato_rotas[Volumes da Rota])),
			        "@Cap",
			            CALCULATE(
			                [Cap P75 Volumes],
			                ALLEXCEPT(fato_rotas, fato_rotas[Filial], fato_rotas[Tipo de Veiculo Padrao])
			            )
			    )
			RETURN
			AVERAGEX(_tbl, DIVIDE([@Vol], [@Cap], BLANK()))
		formatString: 0.00
		displayFolder: 07. Investigacao\01. Linha Operacional
		lineageTag: 10dadc46-27f9-4078-bfc0-a66ecb953774

	measure 'TblExp Flag Rota Nao Planejada' = IF([TblExp Se Planejado] = "Nao", 1, 0)
		formatString: 0
