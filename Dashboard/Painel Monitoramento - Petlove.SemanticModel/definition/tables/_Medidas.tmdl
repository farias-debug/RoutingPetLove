	/// Variacao dia a dia no SPR Vol Realizado (pontos)
	measure 'Var D-1 SPR Volumes' = 
			VAR _atual = CALCULATE(
				[SPR Vol Realizado],
				dim_calendario[IsUltimaData] = TRUE
			)
			VAR _anterior = CALCULATE(
				[SPR Vol Realizado],
				dim_calendario[IsAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior),
					_atual - _anterior,
					BLANK()
				)
		formatString: +0.0;-0.0;0.0
		displayFolder: 06. Shared\01. Temporal
		lineageTag: 8afb4bc7-20c4-4662-b2b4-d4dcfe945c8a

	/// Variacao semanal no SPR Vol Realizado (%)
	measure 'Var WoW SPR Volumes (%)' = 
			VAR _atual = CALCULATE(
				[SPR Vol Realizado],
				dim_calendario[IsSemanaAtual] = TRUE
			)
			VAR _anterior = CALCULATE(
				[SPR Vol Realizado],
				dim_calendario[IsSemanaAnterior] = TRUE
			)
			RETURN
				IF(
					NOT ISBLANK(_atual) && NOT ISBLANK(_anterior) && _anterior <> 0,
					DIVIDE(
						_atual - _anterior,
						_anterior,
						0
					),
					BLANK()
				)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06. Shared\01. Temporal
		lineageTag: c50c3570-456a-4e09-bc01-fde31c84f691

