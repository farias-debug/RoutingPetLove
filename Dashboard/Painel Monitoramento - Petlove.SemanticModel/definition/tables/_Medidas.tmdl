	measure 'SVG Strip Alerta Operacional' =
			VAR _nivel = UPPER(COALESCE([Alerta Nivel], "ok"))
			VAR _cor = COALESCE([Alerta Cor], "#6A7282")
			VAR _msg = COALESCE([Op Alerta Prioritario], "Operacao estavel")
			VAR _msgCurta = IF(LEN(_msg) > 92, LEFT(_msg, 92) & "...", _msg)
			VAR _msg1 = LEFT(_msgCurta, 46)
			VAR _msg2 = MID(_msgCurta, 47, 46)
			VAR _msg1Safe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_msg1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _msg2Safe = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_msg2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
			VAR _np = FORMAT([Op Rotas Nao Planejadas], "#,##0")
			VAR _st = FORMAT([Op Rotas Sem Tempo], "#,##0")
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='420' height='136' viewBox='0 0 420 136'>"
			        & "<rect x='1' y='1' width='418' height='134' rx='22' fill='#102536' stroke='#102536'/>"
			        & "<rect x='1' y='1' width='128' height='134' rx='22' fill='" & _cor & "' opacity='0.95'/>"
			        & "<text x='24' y='34' font-family='Segoe UI Semibold' font-size='11' fill='#FFF8EE' letter-spacing='1'>ALERTA PRIORITARIO</text>"
			        & "<text x='24' y='74' font-family='Segoe UI Semibold' font-size='26' fill='#FFFFFF'>" & _nivel & "</text>"
			        & "<text x='24' y='96' font-family='Segoe UI' font-size='11' fill='#FFF8EE'>Acao imediata na janela</text>"
			        & "<text x='150' y='42' font-family='Segoe UI Semibold' font-size='12' fill='#F5F1E8'>Torre operacional</text>"
			        & "<text x='150' y='68' font-family='Segoe UI' font-size='14' fill='#FFFFFF'>" & _msg1Safe & "</text>"
			        & "<text x='150' y='88' font-family='Segoe UI' font-size='14' fill='#FFFFFF'>" & _msg2Safe & "</text>"
			        & "<rect x='150' y='102' width='110' height='20' rx='10' fill='#FFFFFF' opacity='0.10'/>"
			        & "<text x='205' y='116' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='#F5F1E8'>Nao planejadas " & _np & "</text>"
			        & "<rect x='272' y='102' width='98' height='20' rx='10' fill='#FFFFFF' opacity='0.10'/>"
			        & "<text x='321' y='116' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='#F5F1E8'>Sem tempo " & _st & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & ENCODEURL(_svg)
		isHidden
		displayFolder: 06. Shared\03. SVG Cards
		lineageTag: 01ccf0f7-0872-4810-bf19-173849d04e9a
		dataCategory: ImageUrl

