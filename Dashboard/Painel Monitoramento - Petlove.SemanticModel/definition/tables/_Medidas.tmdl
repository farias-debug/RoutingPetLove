	/// Peso medio por rota em kg (apenas filiais Unidade)
	measure 'SPR Peso Realizado (kg/rota)' = 
			DIVIDE(
				CALCULATE(
					SUM(fato_rotas[Peso (kg)]),
					KEEPFILTERS(dim_filial[Tipo] = "Unidade")
				),
