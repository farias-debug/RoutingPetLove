	/// Diferenca percentual entre valor e meta do ocupacao composta da frota
	measure 'KPI Capacidade Delta%' = DIVIDE([KPI Capacidade Valor] - [KPI Capacidade Meta], [KPI Capacidade Meta], 0)
		formatString: +0.0%;-0.0%;0.0%
