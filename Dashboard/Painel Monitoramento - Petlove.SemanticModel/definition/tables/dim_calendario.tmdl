	partition dim_calendario = calculated
		mode: import
		source =
				VAR _Hoje        = TODAY()
				VAR _MinDate     = DATE(YEAR(_Hoje), 1, 1)
				VAR _MaxDate     = _Hoje
				VAR _UltimaData  = _Hoje
				VAR _IniSemAt    = _UltimaData - WEEKDAY(_UltimaData, 2) + 1
				VAR _IniMesAt    = DATE(YEAR(_UltimaData), MONTH(_UltimaData), 1)
				RETURN
				ADDCOLUMNS(
				    SELECTCOLUMNS(CALENDAR(_MinDate, _MaxDate), "Data", [Date]),
				    "Ano",            YEAR([Data]),
				    "Trimestre",      QUARTER([Data]),
				    "Semestre",       IF(MONTH([Data]) <= 6, 1, 2),
				    "Mes",            MONTH([Data]),
				    "MesNome",        FORMAT([Data], "MMMM"),
				    "MesAbrev",       FORMAT([Data], "MMM"),
				    "MesAno",         FORMAT([Data], "MMMM YYYY"),
				    "MesLabel",       FORMAT([Data], "MMM/YY"),
				    "Semana",         WEEKNUM([Data], 21),
				    "DiaSemanaNum",   WEEKDAY([Data], 2) - 1,
				    "DiaSemana",      FORMAT([Data], "DDDD"),
				    "DataLabel",      FORMAT([Data], "DD/MM/YYYY"),
				    "DiaLabel",       FORMAT([Data], "DDD, DD/MM"),
				    "DiaDoAno",       INT([Data] - DATE(YEAR([Data]), 1, 1)) + 1,
				    "DiaUtil",        IF(WEEKDAY([Data], 2) <= 5, 1, 0),
				    "FimDeSemana",    IF(WEEKDAY([Data], 2) > 5, 1, 0),
				    "SemanaInicio",   [Data] - WEEKDAY([Data], 2) + 1,
				    "SemanaFim",      [Data] - WEEKDAY([Data], 2) + 7,
				    "SemanaLabel",    "Sem " & FORMAT(WEEKNUM([Data], 21), "00") & " (" & FORMAT([Data] - WEEKDAY([Data], 2) + 1, "DD/MM") & " - " & FORMAT([Data] - WEEKDAY([Data], 2) + 7, "DD/MM") & ")",
				    "SemanaCurtaLabel","S" & FORMAT(WEEKNUM([Data], 21), "00") & " · " & FORMAT([Data] - WEEKDAY([Data], 2) + 1, "DD/MM") & " a " & FORMAT([Data] - WEEKDAY([Data], 2) + 7, "DD/MM"),
				    "SemanaDoMes",    INT((DAY([Data]) - 1) / 7) + 1,
				    "QuinzenaDoMes",  IF(DAY([Data]) <= 15, 1, 2),
				    "AnoSemana",      FORMAT(YEAR([Data]), "0000") & "-S" & FORMAT(WEEKNUM([Data], 21), "00"),
				    "AnoMes",         FORMAT([Data], "YYYY-MM"),
				    "AnoSemanaLabel", FORMAT(YEAR([Data]), "0000") & " - Sem " & FORMAT(WEEKNUM([Data], 21), "00"),
				    "MesDia",         FORMAT([Data], "DD/MM"),
				    "ISOSemana",      WEEKNUM([Data], 21),
				    "ISOAno",
				        VAR _sem = WEEKNUM([Data], 21)
				        VAR _mes = MONTH([Data])
				        RETURN
				            IF(_sem >= 52 && _mes = 1, YEAR([Data]) - 1,
				               IF(_sem = 1 && _mes = 12, YEAR([Data]) + 1, YEAR([Data]))),
				    "ISOAnoSemana",
				        VAR _sem = WEEKNUM([Data], 21)
				        VAR _mes = MONTH([Data])
				        VAR _isoAno =
				            IF(_sem >= 52 && _mes = 1, YEAR([Data]) - 1,
				               IF(_sem = 1 && _mes = 12, YEAR([Data]) + 1, YEAR([Data])))
				        RETURN FORMAT(_isoAno, "0000") & "-W" & FORMAT(_sem, "00"),
				    "ISODiaSemana",   WEEKDAY([Data], 2),
				    "ISOAnoSemanaSort",
				        VAR _sem = WEEKNUM([Data], 21)
				        VAR _mes = MONTH([Data])
				        VAR _isoAno =
				            IF(_sem >= 52 && _mes = 1, YEAR([Data]) - 1,
				               IF(_sem = 1 && _mes = 12, YEAR([Data]) + 1, YEAR([Data])))
				        RETURN _isoAno * 100 + _sem,
				    "MesNomeAbrev3",  UPPER(LEFT(FORMAT([Data], "MMM"), 3)),
				    "IsUltimaData",      [Data] = _UltimaData,
				    "IsAnterior",        [Data] = _UltimaData - 1,
				    "IsAteUltimaData",   [Data] <= _UltimaData,
				    "IsFuturo",          [Data] > _UltimaData,
				    "DiasAteUltimaData", INT(_UltimaData - [Data]),
				    "IsSemanaAtual",     [Data] >= _IniSemAt && [Data] <= _UltimaData,
				    "IsSemanaAnterior",  [Data] >= _IniSemAt - 7 && [Data] < _IniSemAt,
				    "IsMesAtual",        YEAR([Data]) = YEAR(_UltimaData) && MONTH([Data]) = MONTH(_UltimaData),
				    "IsMesAnterior",     YEAR([Data]) = YEAR(EDATE(_UltimaData, -1)) && MONTH([Data]) = MONTH(EDATE(_UltimaData, -1)),
				    "IsTrimestreAtual",  YEAR([Data]) = YEAR(_UltimaData) && QUARTER([Data]) = QUARTER(_UltimaData),
				    "IsUltimos7Dias",    [Data] >= _UltimaData - 6  && [Data] <= _UltimaData,
				    "IsUltimos14Dias",   [Data] >= _UltimaData - 13 && [Data] <= _UltimaData,
				    "IsUltimos30Dias",   [Data] >= _UltimaData - 29 && [Data] <= _UltimaData,
				    "IsUltimos90Dias",   [Data] >= _UltimaData - 89 && [Data] <= _UltimaData,
				    "PeriodoLabel",      SWITCH(TRUE(), [Data] = _UltimaData, "Ultimo Dia", [Data] = _UltimaData - 1, "D-1", [Data] >= _UltimaData - 6 && [Data] < _UltimaData, "Ult 7d", [Data] >= _UltimaData - 29 && [Data] < _UltimaData - 6, "Ult 30d", [Data] < _UltimaData - 29, "Historico", "Futuro"),
				    "TrimestreLabel",    "T" & FORMAT(QUARTER([Data]), "0") & " " & FORMAT(YEAR([Data]), "0000"),
				    "SemestreLabel",     IF(MONTH([Data]) <= 6, "1o Sem", "2o Sem") & " " & FORMAT(YEAR([Data]), "0000")
				)

