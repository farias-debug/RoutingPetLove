	partition dim_filial = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\lucas.batista\Documents\Projetos\Dashboard\data\tab_auxiliar\dim_filial.xlsx"), null, true),
				    FilialSheet = Source{[Item="dim_filial", Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(FilialSheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CD Origem", type text}, {"Tabela", type any}, {"Filial", type text}, {"Codigo", Int64.Type}, {"Nome Filial", type text}, {"Tipo", type text}, {"MetaSPR", Int64.Type}, {"Regiao", type text}, {"Capacidade Volume Dia", Int64.Type}}),
				    Renamed = Table.RenameColumns(Typed, {{"Nome Filial", "NomeResumido"}}),
				    FactSource = Csv.Document(File.Contents("C:\Users\lucas.batista\Documents\Projetos\Dashboard\output\powerbi\fato_rotas.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    FactPromoted = Table.PromoteHeaders(FactSource, [PromoteAllScalars=true]),
				    FactSelected = Table.SelectColumns(FactPromoted, {"Filial", "Data Referencia", "Rota", "Pedidos da Rota", "Volumes da Rota", "Peso (kg)"}),
				    FactDates = Table.TransformColumns(FactSelected, {{"Data Referencia", each if _ = null or _ = "" then null else Date.FromText(_, [Format="yyyy-MM-dd", Culture="en-US"]), type date}}),
				    FactTyped = Table.TransformColumnTypes(FactDates, {{"Filial", type text}, {"Rota", type text}, {"Pedidos da Rota", Int64.Type}, {"Volumes da Rota", Int64.Type}, {"Peso (kg)", type number}}, "pt-BR"),
				    MaxDate = try List.Max(List.RemoveNulls(Table.Column(FactTyped, "Data Referencia"))) otherwise null,
				    WindowStart = if MaxDate = null then null else Date.AddDays(MaxDate, -55),
				    FactWindow = if WindowStart = null then Table.SelectRows(FactTyped, each false) else Table.SelectRows(FactTyped, each [Data Referencia] <> null and [Data Referencia] >= WindowStart and [Volumes da Rota] <> null and [Volumes da Rota] > 0),
				    ByFilial = Table.Group(FactWindow, {"Filial"}, {{"RotasPeriodo", each Table.RowCount(_), Int64.Type}, {"PedidosTotal", each List.Sum(List.RemoveNulls(Table.Column(_, "Pedidos da Rota"))), type number}, {"VolumesTotal", each List.Sum(List.RemoveNulls(Table.Column(_, "Volumes da Rota"))), type number}, {"PesoTotal", each List.Sum(List.RemoveNulls(Table.Column(_, "Peso (kg)"))), type number}}),
				    GlobalRotas = Table.RowCount(FactWindow),
				    GlobalVolumes = List.Sum(List.RemoveNulls(Table.Column(FactWindow, "Volumes da Rota"))),
				    GlobalPedidos = List.Sum(List.RemoveNulls(Table.Column(FactWindow, "Pedidos da Rota"))),
				    GlobalPeso = List.Sum(List.RemoveNulls(Table.Column(FactWindow, "Peso (kg)"))),
				    GlobalVolumePorRota = if GlobalRotas = 0 or GlobalVolumes = null then null else GlobalVolumes / GlobalRotas,
				    GlobalPedidosPorVolume = if GlobalVolumes = null or GlobalVolumes = 0 then null else GlobalPedidos / GlobalVolumes,
				    GlobalPesoPorVolume = if GlobalVolumes = null or GlobalVolumes = 0 then null else GlobalPeso / GlobalVolumes,
				    WithVolumeRef = Table.AddColumn(ByFilial, "VolumePorRotaRef", each if [RotasPeriodo] = null or [RotasPeriodo] = 0 or [VolumesTotal] = null then GlobalVolumePorRota else [VolumesTotal] / [RotasPeriodo], type number),
				    WithPedidosRef = Table.AddColumn(WithVolumeRef, "PedidosPorVolumeRef", each if [VolumesTotal] = null or [VolumesTotal] = 0 or [PedidosTotal] = null then GlobalPedidosPorVolume else [PedidosTotal] / [VolumesTotal], type number),
				    WithPesoRef = Table.AddColumn(WithPedidosRef, "PesoPorVolumeRefKg", each if [VolumesTotal] = null or [VolumesTotal] = 0 or [PesoTotal] = null then GlobalPesoPorVolume else [PesoTotal] / [VolumesTotal], type number),
				    Merged = Table.NestedJoin(Renamed, {"Filial"}, WithPesoRef, {"Filial"}, "CapacidadeOperacional", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Merged, "CapacidadeOperacional", {"VolumePorRotaRef", "PedidosPorVolumeRef", "PesoPorVolumeRefKg"}, {"VolumePorRotaRef", "PedidosPorVolumeRef", "PesoPorVolumeRefKg"}),
				    WithCapacidadeVeiculos = Table.AddColumn(Expanded, "Capacidade Veiculos Dia", each let _cap = [Capacidade Volume Dia], _ref = [VolumePorRotaRef] in if _cap = null or _ref = null or _ref = 0 then null else Number.Round(_cap / _ref, 1), type number),
				    WithCapacidadePedidos = Table.AddColumn(WithCapacidadeVeiculos, "Capacidade Pedidos Dia", each let _cap = [Capacidade Volume Dia], _ref = [PedidosPorVolumeRef] in if _cap = null or _ref = null then null else Int64.From(Number.Round(_cap * _ref, 0)), Int64.Type),
				    WithCapacidadePeso = Table.AddColumn(WithCapacidadePedidos, "Capacidade Peso Dia (kg)", each let _cap = [Capacidade Volume Dia], _ref = [PesoPorVolumeRefKg] in if _cap = null or _ref = null then null else Number.Round(_cap * _ref, 1), type number),
				    Final = Table.RemoveColumns(WithCapacidadePeso, {"VolumePorRotaRef", "PedidosPorVolumeRef", "PesoPorVolumeRefKg"})
				in
				    Final

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegacao

